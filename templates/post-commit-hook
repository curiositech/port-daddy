#!/usr/bin/env zsh
# =============================================================================
# Port Daddy Post-Commit Hook
# =============================================================================
# Copy to .git/hooks/post-commit and chmod +x
# Publishes commit info to Port Daddy's git:committed channel.
# Fleet agents trigger automatically.
# =============================================================================

PD_URL="${PD_URL:-http://localhost:9876}"

SHA=$(git rev-parse --short HEAD 2>/dev/null)
MSG=$(git log -1 --pretty=%s 2>/dev/null)
AUTHOR=$(git log -1 --pretty=%an 2>/dev/null)
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
FILES=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | head -20 | tr '\n' ', ')

curl -s -X POST "${PD_URL}/msg/git:committed" \
  -H 'Content-Type: application/json' \
  -d "{\"payload\": {\"sha\": \"${SHA}\", \"message\": \"${MSG}\", \"author\": \"${AUTHOR}\", \"branch\": \"${BRANCH}\", \"files\": \"${FILES}\"}}" \
  --connect-timeout 2 --max-time 3 \
  >/dev/null 2>&1 &

exit 0
