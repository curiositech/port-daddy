# Port Daddy — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# These are used by fleet agents to call AI backends.
# The daemon itself does not need API keys.

# Required for fleet agents using Claude backend
ANTHROPIC_API_KEY=sk-ant-...

# Optional: allow the daemon's semantic resolver to download its embedding
# model (Xenova/all-MiniLM-L6-v2) from huggingface.co when it is not cached
# locally. Default is OFF: no opt-in means no network fetch — the resolver
# serves lexical/BM25 results labeled degraded until the model is prefetched
# (scripts/prefetch-embedding-model.ts) or this is set. TRANSFORMERS_OFFLINE=1
# always wins over this opt-in.
# PORT_DADDY_ALLOW_MODEL_DOWNLOAD=1

# Optional: for fleet agents using other backends
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=AIza...
# OLLAMA_HOST=http://localhost:11434
