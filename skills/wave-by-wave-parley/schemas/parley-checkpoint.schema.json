{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["graphRevision", "justFinished", "nodes", "outcomes", "risks", "nextWave", "approval", "assignment"],
  "properties": {
    "graphRevision": {"type": "integer", "minimum": 1},
    "justFinished": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true, "required": ["id", "dependsOn"], "properties": {"id": {"type": "string", "minLength": 1, "pattern": "\\S"}, "dependsOn": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}}}},
    "outcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": true, "required": ["nodeId", "revision", "status", "evidenceHash"], "properties": {"nodeId": {"type": "string", "minLength": 1, "pattern": "\\S"}, "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["success", "partial", "failed", "missing", "untrusted"]}, "evidenceHash": {"type": "string", "minLength": 1, "pattern": "\\S"}}}},
    "risks": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["id", "revision", "severity", "affectedNodes", "evidenceHash"], "properties": {"id": {"type": "string", "minLength": 1, "pattern": "\\S"}, "revision": {"type": "integer", "minimum": 1}, "severity": {"enum": ["low", "medium", "high", "unknown"]}, "affectedNodes": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "evidenceHash": {"type": "string", "minLength": 1, "pattern": "\\S"}}}},
    "nextWave": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
    "approval": {"type": "object", "additionalProperties": true, "required": ["required", "present"], "properties": {"required": {"type": "boolean"}, "present": {"type": "boolean"}}},
    "assignment": {"type": "object", "additionalProperties": true, "required": ["authority", "resources"], "properties": {"authority": {"type": "boolean"}, "resources": {"type": "boolean"}}}
  }
}
