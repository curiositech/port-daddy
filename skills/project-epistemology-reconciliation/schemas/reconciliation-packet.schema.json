{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Single-scope reconciliation declaration packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "method", "scope", "decision", "cost", "evidence", "findings", "dissent", "preview"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "claimsIndependent", "sealedBeforeSharing", "sameFrozenInput"],
      "properties": {
        "mode": { "enum": ["solo", "independent"] },
        "claimsIndependent": { "type": "boolean" },
        "sealedBeforeSharing": { "type": "boolean" },
        "sameFrozenInput": { "type": "boolean" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceHead", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "steward", "owner", "proposalDigest", "requestedExecution", "halted", "authorityVerified"],
      "properties": {
        "status": { "enum": ["draft", "ready"] },
        "steward": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "proposalDigest": { "type": "string", "minLength": 1 },
        "requestedExecution": { "type": "boolean" },
        "halted": { "type": "boolean" },
        "authorityVerified": { "type": "boolean" }
      }
    },
    "cost": {
      "type": "object", "additionalProperties": false,
      "required": ["paidWorkRequested", "telemetryKnown", "aggregateReserved", "capUsd"],
      "properties": {
        "paidWorkRequested": { "type": "boolean" },
        "telemetryKnown": { "type": "boolean" },
        "aggregateReserved": { "type": "boolean" },
        "capUsd": { "type": "number", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "scopeId", "authorized", "warrant"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scopeId": { "type": "string", "minLength": 1 },
          "authorized": { "type": "boolean" },
          "warrant": { "enum": ["source", "observation", "inference", "missing"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "warrant", "status", "evidenceIds", "disposition", "blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "warrant": { "enum": ["hypothesis", "verified_observation", "policy_norm", "value_preference", "blocking_gate"] },
          "status": { "enum": ["allegation", "verified"] },
          "evidenceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "disposition": { "enum": ["open", "accept", "reject", "defer", "escalate"] },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "dissent": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["findingId", "rationale", "reopenWhen"],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "reopenWhen": { "type": "string", "minLength": 1 }
        }
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "proposalDigest", "sourceHead", "stateRevision", "affectedOutcomes"],
      "properties": {
        "available": { "type": "boolean" },
        "proposalDigest": { "type": "string", "minLength": 1 },
        "sourceHead": { "type": "string", "minLength": 1 },
        "stateRevision": { "type": "integer", "minimum": 0 },
        "affectedOutcomes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
