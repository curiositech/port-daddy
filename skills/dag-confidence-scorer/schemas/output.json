{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "nonBlank": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "noEvaluation": {
      "type": "object",
      "properties": {
        "evaluation": {}
      },
      "not": {
        "properties": {
          "evaluation": {}
        },
        "required": [
          "evaluation"
        ]
      }
    },
    "noKnownEvidence": {
      "type": "object",
      "properties": {
        "fitEvidence": {},
        "calibrationMap": {},
        "evaluation": {}
      },
      "not": {
        "anyOf": [
          {
            "properties": {
              "fitEvidence": {}
            },
            "required": [
              "fitEvidence"
            ]
          },
          {
            "properties": {
              "calibrationMap": {}
            },
            "required": [
              "calibrationMap"
            ]
          },
          {
            "properties": {
              "evaluation": {}
            },
            "required": [
              "evaluation"
            ]
          }
        ]
      }
    },
    "noCalibrationArtifacts": {
      "type": "object",
      "properties": {
        "fitEvidence": {},
        "calibrationMap": {}
      },
      "not": {
        "anyOf": [
          {
            "properties": {
              "fitEvidence": {}
            },
            "required": [
              "fitEvidence"
            ]
          },
          {
            "properties": {
              "calibrationMap": {}
            },
            "required": [
              "calibrationMap"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "forecast",
    "status"
  ],
  "properties": {
    "forecast": {
      "$ref": "input.json"
    },
    "status": {
      "enum": [
        "uncalibrated",
        "calibration-fitted",
        "evaluated",
        "declined"
      ]
    },
    "fitEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "modelId",
        "cohortId",
        "forecastIds"
      ],
      "properties": {
        "modelId": {
          "$ref": "#/$defs/nonBlank"
        },
        "cohortId": {
          "$ref": "#/$defs/nonBlank"
        },
        "forecastIds": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "calibrationMap": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "version",
        "fitCohortId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlank"
        },
        "version": {
          "$ref": "#/$defs/nonBlank"
        },
        "fitCohortId": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "cohortId",
        "samples",
        "denominator",
        "meanBrier"
      ],
      "properties": {
        "mode": {
          "enum": [
            "raw",
            "calibrated"
          ]
        },
        "cohortId": {
          "$ref": "#/$defs/nonBlank"
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "forecastId",
              "eventId",
              "probability",
              "outcome",
              "resolvedAt",
              "resolutionSource"
            ],
            "properties": {
              "forecastId": {
                "$ref": "#/$defs/nonBlank"
              },
              "eventId": {
                "$ref": "#/$defs/nonBlank"
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "outcome": {
                "enum": [
                  0,
                  1
                ]
              },
              "resolvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "resolutionSource": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "meanBrier": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "calibration-fitted"
          }
        }
      },
      "then": {
        "properties": {
          "fitEvidence": {},
          "calibrationMap": {}
        },
        "required": [
          "fitEvidence",
          "calibrationMap"
        ],
        "allOf": [
          {
            "$ref": "#/$defs/noEvaluation"
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "evaluated"
          }
        }
      },
      "then": {
        "properties": {
          "evaluation": {}
        },
        "required": [
          "evaluation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "evaluated"
          },
          "evaluation": {
            "properties": {
              "mode": {
                "const": "calibrated"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "evaluation"
        ]
      },
      "then": {
        "properties": {
          "fitEvidence": {},
          "calibrationMap": {}
        },
        "required": [
          "fitEvidence",
          "calibrationMap"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "evaluated"
          },
          "evaluation": {
            "properties": {
              "mode": {
                "const": "raw"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "evaluation"
        ]
      },
      "then": {
        "$ref": "#/$defs/noCalibrationArtifacts"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "uncalibrated"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/noKnownEvidence"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "declined"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/noKnownEvidence"
      }
    }
  ]
}
