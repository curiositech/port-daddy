{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "objective",
    "graphRevision",
    "status",
    "semanticChecks",
    "boundaries"
  ],
  "properties": {
    "objective": {
      "enum": [
        "reachability-chain-partition",
        "direct-edge-vertex-disjoint-path-cover",
        "weighted-schedule"
      ]
    },
    "graphRevision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "verified",
        "failed",
        "incomplete",
        "unsupported"
      ]
    },
    "chains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "matchingSize": {
      "type": "integer",
      "minimum": 0
    },
    "antichainWitness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "semanticChecks": {
      "type": "object",
      "required": [
        "uniqueNodeIds",
        "edgeEndpointsExist",
        "acyclic"
      ],
      "properties": {
        "uniqueNodeIds": {
          "type": "boolean"
        },
        "edgeEndpointsExist": {
          "type": "boolean"
        },
        "acyclic": {
          "type": "boolean"
        },
        "coverageExactlyOnce": {
          "type": "boolean"
        },
        "adjacentPairsValid": {
          "type": "boolean"
        },
        "antichainIncomparable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "objective": {
            "const": "reachability-chain-partition"
          },
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "objective",
          "status"
        ]
      },
      "then": {
        "required": [
          "chains",
          "matchingSize",
          "antichainWitness"
        ],
        "properties": {
          "semanticChecks": {
            "required": [
              "coverageExactlyOnce",
              "adjacentPairsValid",
              "antichainIncomparable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "objective": {
            "const": "direct-edge-vertex-disjoint-path-cover"
          },
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "objective",
          "status"
        ]
      },
      "then": {
        "required": [
          "paths",
          "matchingSize"
        ],
        "properties": {
          "semanticChecks": {
            "required": [
              "coverageExactlyOnce",
              "adjacentPairsValid"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "objective": {
            "const": "weighted-schedule"
          }
        },
        "required": [
          "objective"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "unsupported"
          },
          "route": {
            "const": "dag-task-scheduler"
          }
        },
        "required": [
          "route"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "semanticChecks": {
            "properties": {
              "uniqueNodeIds": {
                "const": true
              },
              "edgeEndpointsExist": {
                "const": true
              },
              "acyclic": {
                "const": true
              },
              "coverageExactlyOnce": {
                "const": true
              },
              "adjacentPairsValid": {
                "const": true
              },
              "antichainIncomparable": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
