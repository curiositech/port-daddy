{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/reputation-plan.schema.json",
  "title": "Declared identity, continuity, and reputation plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "designVersion",
    "identity",
    "continuity",
    "outcome",
    "estimator",
    "newcomerPolicy",
    "judge",
    "sanctions",
    "representsUncertainty"
  ],
  "properties": {
    "designVersion": {
      "const": "2026-09-24"
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "issuerNamespace",
        "actorId",
        "credentialId",
        "sessionId",
        "authentication",
        "recovery",
        "revocation"
      ],
      "properties": {
        "issuerNamespace": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "credentialId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authentication": {
          "enum": [
            "key-control-declared",
            "account-control-declared",
            "not-established"
          ]
        },
        "recovery": {
          "enum": [
            "issuer-authorized",
            "new-or-unattributed",
            "not-established"
          ]
        },
        "revocation": {
          "enum": [
            "checked-before-session-use",
            "not-checked",
            "not-established"
          ]
        }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "memory",
        "checkpoint",
        "outcomeLedger",
        "successorRule"
      ],
      "properties": {
        "memory": {
          "enum": [
            "declared-persistent",
            "note-only",
            "absent",
            "not-established"
          ]
        },
        "checkpoint": {
          "enum": [
            "declared-restorable",
            "note-only",
            "absent",
            "not-established"
          ]
        },
        "outcomeLedger": {
          "enum": [
            "declared-attributed-record",
            "absent",
            "not-established"
          ]
        },
        "successorRule": {
          "enum": [
            "issuer-rebind-required",
            "new-or-unattributed",
            "not-established"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "oracleRef",
        "evaluatorRef",
        "receiptRef",
        "observationStatus"
      ],
      "properties": {
        "oracleRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evaluatorRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "receiptRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observationStatus": {
          "enum": [
            "declared-not-observed",
            "observed-with-receipt"
          ]
        }
      }
    },
    "estimator": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "inputTopology",
        "uncertaintyStatus",
        "calibrationStatus"
      ],
      "properties": {
        "kind": {
          "enum": [
            "elo",
            "trueskill",
            "bandit",
            "none"
          ]
        },
        "inputTopology": {
          "enum": [
            "pairwise",
            "team-or-draw",
            "context-action-reward",
            "none"
          ]
        },
        "uncertaintyStatus": {
          "enum": [
            "separate-exploration-policy",
            "model-posterior",
            "not-established",
            "not-applicable"
          ]
        },
        "calibrationStatus": {
          "enum": [
            "not-estimated",
            "held-out-evaluated",
            "not-applicable"
          ]
        }
      }
    },
    "newcomerPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "objective",
        "resetRisk",
        "exclusionRisk"
      ],
      "properties": {
        "kind": {
          "enum": [
            "probation",
            "limited-exposure",
            "entry-fee",
            "dues",
            "unreplaceable-pseudonym",
            "none"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resetRisk": {
          "enum": [
            "analyzed",
            "not-established"
          ]
        },
        "exclusionRisk": {
          "enum": [
            "analyzed",
            "not-established"
          ]
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "present",
        "protocol",
        "calibrationStatus"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "protocol": {
          "enum": [
            "not-applicable",
            "pairwise-order-swap",
            "other-declared"
          ]
        },
        "calibrationStatus": {
          "enum": [
            "not-estimated",
            "human-labeled-evaluated",
            "not-applicable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "present"
            ],
            "properties": {
              "present": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "pairwise-order-swap"
              },
              "calibrationStatus": {
                "enum": [
                  "not-estimated",
                  "human-labeled-evaluated"
                ]
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "present"
            ],
            "properties": {
              "present": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "not-applicable"
              },
              "calibrationStatus": {
                "const": "not-applicable"
              }
            }
          }
        }
      ]
    },
    "sanctions": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "authority",
        "appeal",
        "incentiveStatus"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "appeal": {
          "enum": [
            "declared",
            "absent",
            "not-established"
          ]
        },
        "incentiveStatus": {
          "enum": [
            "not-estimated",
            "setting-specific-analysis"
          ]
        }
      }
    },
    "representsUncertainty": {
      "type": "boolean",
      "description": "True only for an active estimator with its detailed model-posterior or separate-exploration-policy state; false only for kind none."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "estimator": {
            "properties": {
              "kind": {
                "const": "elo"
              }
            },
            "type": "object",
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "representsUncertainty": {
            "const": true
          },
          "estimator": {
            "properties": {
              "inputTopology": {
                "const": "pairwise"
              },
              "uncertaintyStatus": {
                "const": "separate-exploration-policy"
              },
              "calibrationStatus": {
                "enum": [
                  "not-estimated",
                  "held-out-evaluated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estimator": {
            "properties": {
              "kind": {
                "const": "trueskill"
              }
            },
            "type": "object",
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "representsUncertainty": {
            "const": true
          },
          "estimator": {
            "properties": {
              "inputTopology": {
                "const": "team-or-draw"
              },
              "uncertaintyStatus": {
                "const": "model-posterior"
              },
              "calibrationStatus": {
                "enum": [
                  "not-estimated",
                  "held-out-evaluated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estimator": {
            "properties": {
              "kind": {
                "const": "bandit"
              }
            },
            "type": "object",
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "representsUncertainty": {
            "const": true
          },
          "estimator": {
            "properties": {
              "inputTopology": {
                "const": "context-action-reward"
              },
              "uncertaintyStatus": {
                "const": "separate-exploration-policy"
              },
              "calibrationStatus": {
                "enum": [
                  "not-estimated",
                  "held-out-evaluated"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "estimator": {
            "properties": {
              "kind": {
                "const": "none"
              }
            },
            "type": "object",
            "required": [
              "kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "representsUncertainty": {
            "const": false
          },
          "estimator": {
            "properties": {
              "inputTopology": {
                "const": "none"
              },
              "uncertaintyStatus": {
                "const": "not-applicable"
              },
              "calibrationStatus": {
                "const": "not-applicable"
              }
            }
          }
        }
      }
    }
  ]
}
