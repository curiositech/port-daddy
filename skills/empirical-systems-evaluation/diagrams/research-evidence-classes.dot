digraph Evidence {
  graph [rankdir=LR, bgcolor="#ffffff", pad="0.22", nodesep="0.20", ranksep="0.26", splines=ortho, outputorder=edgesfirst, fontname="Arial", fontsize=16, labelloc=t, label="Evidence classes answer different questions", labeljust=l];
  node [shape=plain, fontname="Arial", fontsize=14];
  edge [style=invis];
  T [label=< <TABLE BORDER="1" COLOR="#315c7d" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" BGCOLOR="#edf5fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Theorem / proof</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Supports: property follows<BR/>under stated assumptions.</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3740">Does not alone establish:</FONT><BR/>assumptions hold in a build<BR/>or deployment.</TD></TR></TABLE> >];
  F [label=< <TABLE BORDER="1" COLOR="#536f91" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" BGCOLOR="#f0f3f9"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Finite model check</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Supports: no counterexample<BR/>within the encoded bounds.</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3740">Does not alone establish:</FONT><BR/>unmodeled states or runtime<BR/>behavior.</TD></TR></TABLE> >];
  S [label=< <TABLE BORDER="1" COLOR="#557267" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" BGCOLOR="#eef6f2"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Scripted replay</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Supports: instrument behavior<BR/>on specified workloads.</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3740">Does not alone establish:</FONT><BR/>human or LLM-agent behavior,<BR/>or production enforcement.</TD></TR></TABLE> >];
  L [label=< <TABLE BORDER="1" COLOR="#8c7544" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" BGCOLOR="#fbf6e9"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>LLM evaluation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Supports: observed agent results<BR/>on sampled tasks and budgets.</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3740">Does not alone establish:</FONT><BR/>other versions, workloads,<BR/>or deployment guarantees.</TD></TR></TABLE> >];
  D [label=< <TABLE BORDER="1" COLOR="#765f79" CELLBORDER="0" CELLSPACING="0" CELLPADDING="13" BGCOLOR="#f5eff6"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="17"><B>Deployed observation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">Supports: this configuration's<BR/>behavior under observed conditions.</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#7c3740">Does not alone establish:</FONT><BR/>unobserved conditions or<BR/>universal assurance.</TD></TR></TABLE> >];
  T -> F -> S -> L -> D;
}
