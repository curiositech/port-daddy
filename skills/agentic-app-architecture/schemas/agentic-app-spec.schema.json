{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://port-daddy.dev/schemas/agentic-app-spec.schema.json",
  "title":"Agentic App Architecture Declaration",
  "description":"A design-time declaration. Validity checks supplied fields; it does not prove deployment, enforcement, provider behavior, or account state.",
  "type":"object",
  "additionalProperties":true,
  "required":["appName","transparency","stateModel","contextStrategy","capabilities","execution"],
  "properties":{
    "appName":{"type":"string","pattern":"\\S"},
    "transparency":{"type":"object","required":["actionDisclosure","evidenceDisclosure","uncertaintyDisclosure","privateReasoningPolicy","interruptMode","rationale"],"properties":{"actionDisclosure":{"enum":["not-applicable","summary","detailed"]},"evidenceDisclosure":{"enum":["not-applicable","summary","detailed"]},"uncertaintyDisclosure":{"enum":["not-applicable","summary","detailed"]},"privateReasoningPolicy":{"enum":["not-requested","redacted-summary-only"]},"interruptMode":{"enum":["not-applicable","before-dispatch","between-steps","mid-run"]},"rationale":{"type":"string","pattern":"\\S"}}},
    "stateModel":{"type":"object","required":["conversationTranscript","durableTaskState","userMemory","provenanceEvidence","retention","restoreForkPolicy","rationale"],"properties":{"conversationTranscript":{"enum":["used","not-applicable"]},"durableTaskState":{"enum":["used","not-applicable"]},"userMemory":{"enum":["used","not-applicable"]},"provenanceEvidence":{"enum":["used","not-applicable"]},"retention":{"type":"string","pattern":"\\S"},"restoreForkPolicy":{"type":"string","pattern":"\\S"},"rationale":{"type":"string","pattern":"\\S"}}},
    "contextStrategy":{"type":"object","required":["strategies","rationale"],"properties":{"strategies":{"type":"array","minItems":1,"items":{"enum":["bounded-input","provider-cache","eviction-or-summary","memory-promotion"]},"uniqueItems":true},"providerCache":{"type":"object","required":["provider","modelOrFamily","documentationUrl","checkedOn"],"properties":{"provider":{"type":"string","pattern":"\\S"},"modelOrFamily":{"type":"string","pattern":"\\S"},"documentationUrl":{"type":"string","pattern":"^https://[^/]+"},"checkedOn":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}},"rationale":{"type":"string","pattern":"\\S"}}},
    "capabilities":{"type":"object","required":["tools","skills","mcp","secretCustody","rationale"],"properties":{"tools":{"enum":["used","not-applicable"]},"skills":{"enum":["used","not-applicable"]},"mcp":{"type":"object","required":["status","rationale"],"properties":{"status":{"enum":["used","not-applicable"]},"coreSize":{"type":"integer","minimum":0},"perProjectSpecialists":{"type":"boolean"},"rationale":{"type":"string","pattern":"\\S"}}},"secretCustody":{"type":"object","required":["required","mode","scope","rationale"],"properties":{"required":{"type":"boolean"},"mode":{"enum":["not-applicable","secret-store-reference","scoped-environment","stdin","argv","inline"]},"scope":{"type":"string","pattern":"\\S"},"rationale":{"type":"string","pattern":"\\S"}}},"rationale":{"type":"string","pattern":"\\S"}}},
    "execution":{"type":"object","required":["agentType","effectClass","isolation","control","authority","receiptPolicy","rationale"],"properties":{"agentType":{"enum":["coding","non-coding"]},"effectClass":{"enum":["none","reversible-local","external-or-irreversible"]},"isolation":{"enum":["not-applicable","declared"]},"control":{"type":"object","required":["kind","rationale"],"properties":{"kind":{"enum":["not-applicable","automated-policy","human-approval"]},"rationale":{"type":"string","pattern":"\\S"}}},"authority":{"type":"string","pattern":"\\S"},"receiptPolicy":{"type":"string","pattern":"\\S"},"rationale":{"type":"string","pattern":"\\S"}}}
  }
}
