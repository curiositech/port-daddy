{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SQLite Durable Agent State DB Plan",
  "type": "object",
  "required": ["candidatePaths", "journalMode"],
  "properties": {
    "dbName": {
      "type": "string",
      "description": "Logical name of the database (e.g. 'port-daddy-registry')."
    },
    "envPin": {
      "type": "object",
      "description": "The single env var every reader/writer must resolve the DB path from.",
      "properties": {
        "varName": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "e.g. PORT_DADDY_DB"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": ["varName"],
      "additionalProperties": false
    },
    "candidatePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path or path template (may include the env var)."
          },
          "canonical": {
            "type": "boolean",
            "default": false,
            "description": "True if this is the single authoritative path. Exactly one entry should be canonical."
          },
          "kind": {
            "type": "string",
            "enum": ["envPinned", "appdata", "home", "repo", "cellar", "cache", "tmp", "worktree", "other"],
            "description": "Self-declared classification. The audit script also checks the raw path string independently -- this field is not trusted alone."
          },
          "owner": {
            "type": "string",
            "description": "Process or component that would resolve this path (e.g. 'legacy CLI default', 'daemon default')."
          }
        },
        "additionalProperties": true
      }
    },
    "journalMode": {
      "type": "string",
      "enum": ["wal", "delete", "truncate", "persist", "memory", "off"]
    },
    "busyTimeoutMs": {
      "type": "integer",
      "minimum": 0
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "sql": { "type": "string" },
          "postVerify": {
            "type": "object",
            "properties": {
              "table": { "type": "string" },
              "column": { "type": "string" },
              "probeSql": {
                "type": "string",
                "description": "A real SELECT/PRAGMA run against the live DB after applying, e.g. \"SELECT count(*) FROM pragma_table_info('items') WHERE name='status'\"."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "writerTopology": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["single-writer", "queue", "serialized", "none"],
          "default": "none"
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "mode": {
                "type": "string",
                "enum": ["exclusive", "serialized", "concurrent"],
                "default": "concurrent"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
