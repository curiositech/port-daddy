{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "isValid",
    "status",
    "checks"
  ],
  "properties": {
    "isValid": {
      "type": "boolean",
      "description": "True only when all required checks establish acceptance under the named policy. False includes rejection or unresolved evidence; status distinguishes them."
    },
    "checks": {
      "type": "object",
      "required": [
        "schemaCompliance",
        "contentQuality",
        "completeness",
        "provenanceFreshness",
        "authority",
        "acceptance"
      ],
      "properties": {
        "schemaCompliance": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "contentQuality": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "completeness": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "provenanceFreshness": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "acceptance": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "not_evaluated",
                "not_applicable"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "type": "string"
            },
            "validatorVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "description": "List of validation failures",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "indeterminate"
      ]
    },
    "policy": {
      "type": "string",
      "description": "Stable identity/version of the acceptance policy, not an authorization grant."
    },
    "artifactDigest": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "isValid": {
            "const": true
          },
          "checks": {
            "properties": {
              "schemaCompliance": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              },
              "contentQuality": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              },
              "completeness": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              },
              "provenanceFreshness": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              },
              "authority": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              },
              "acceptance": {
                "properties": {
                  "status": {
                    "enum": [
                      "passed",
                      "not_applicable"
                    ]
                  }
                }
              }
            }
          }
        },
        "required": [
          "policy"
        ]
      },
      "else": {
        "properties": {
          "isValid": {
            "const": false
          }
        }
      }
    }
  ]
}
