{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["workIntent", "selectedArchetypes", "runnerUp", "canonicalTarget", "approval", "assignment", "legacyRoutes"],
  "properties": {
    "workIntent": {"type": "object", "additionalProperties": true, "required": ["id", "signals", "signalReasons"], "properties": {"id": {"type": "string", "minLength": 1, "pattern": "\\S"}, "signals": {"type": "object", "additionalProperties": true, "required": ["coupling", "contextPressure", "skillBoundary", "reviewIndependence", "budget", "operatorBurden"], "properties": {"coupling": {"enum": ["low", "medium", "high"]}, "contextPressure": {"enum": ["low", "medium", "high"]}, "skillBoundary": {"enum": ["single", "few", "many"]}, "reviewIndependence": {"enum": ["shared", "independent"]}, "budget": {"enum": ["small", "medium", "large"]}, "operatorBurden": {"enum": ["low", "medium", "high"]}}}, "signalReasons": {"type": "object", "additionalProperties": true, "required": ["coupling", "contextPressure", "skillBoundary", "reviewIndependence", "budget", "operatorBurden"], "properties": {"coupling": {"type": "string", "minLength": 1, "pattern": "\\S"}, "contextPressure": {"type": "string", "minLength": 1, "pattern": "\\S"}, "skillBoundary": {"type": "string", "minLength": 1, "pattern": "\\S"}, "reviewIndependence": {"type": "string", "minLength": 1, "pattern": "\\S"}, "budget": {"type": "string", "minLength": 1, "pattern": "\\S"}, "operatorBurden": {"type": "string", "minLength": 1, "pattern": "\\S"}}}}},
    "selectedArchetypes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["node", "scout", "chain", "dag-workgroup", "tournament", "ambient-watcher", "human-gate"]}},
    "runnerUp": {"type": "object", "additionalProperties": true, "required": ["archetype", "reasonLost"], "properties": {"archetype": {"enum": ["node", "scout", "chain", "dag-workgroup", "tournament", "ambient-watcher", "human-gate"]}, "reasonLost": {"type": "string", "minLength": 1, "pattern": "\\S"}}},
    "canonicalTarget": {"type": "object", "additionalProperties": true, "required": ["callTraceRef", "persistedStateRef"], "properties": {"callTraceRef": {"type": "string", "pattern": "^trace:\\S.*"}, "persistedStateRef": {"type": "string", "pattern": "^readback:\\S.*"}}},
    "approval": {"type": "object", "additionalProperties": true, "required": ["required", "present", "blockedAction"], "properties": {"required": {"type": "boolean"}, "present": {"type": "boolean"}, "blockedAction": {"type": "string"}}},
    "assignment": {"type": "object", "additionalProperties": true, "required": ["authority", "resources"], "properties": {"authority": {"type": "boolean"}, "resources": {"type": "boolean"}}},
    "legacyRoutes": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["verb", "callTraceRef", "persistedStateRef", "writesIndependentState"], "properties": {"verb": {"enum": ["spawn", "dispatch", "sortie", "conjure", "nightshift"]}, "callTraceRef": {"type": "string", "pattern": "^trace:\\S.*"}, "persistedStateRef": {"type": "string", "pattern": "^readback:\\S.*"}, "writesIndependentState": {"type": "boolean"}}}},
    "noReachableLegacyRoutesEvidence": {"type": "string", "pattern": "^trace:\\S.*"}
  },
  "allOf": [{"if": {"properties": {"selectedArchetypes": {"type": "array", "contains": {"const": "human-gate"}}}, "required": ["selectedArchetypes"]}, "then": {"properties": {"approval": {"type": "object", "properties": {"required": {"const": true}, "blockedAction": {"type": "string", "minLength": 1, "pattern": "\\S"}}}}}}, {"if": {"properties": {"legacyRoutes": {"type": "array", "maxItems": 0}}, "required": ["legacyRoutes"]}, "then": {"required": ["noReachableLegacyRoutesEvidence"], "properties": {"noReachableLegacyRoutesEvidence": {"type": "string"}}}}]
}
