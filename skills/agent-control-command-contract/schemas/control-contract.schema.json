{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Control Command Declaration",
  "description": "Static declaration input. Schema validity does not establish runtime behavior, current authority, effect observation, or a safe clickable UI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "verbs",
    "backends",
    "authorization",
    "matrix"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/control-contract.schema.json"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "basis",
        "requiredVerbs",
        "requiredLifecycleStates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "description": "Why this profile's required verb set applies. A profile is an explicit local product choice.",
          "pattern": "\\S"
        },
        "requiredVerbs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "requiredLifecycleStates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "requested",
              "policy-denied",
              "queued",
              "delivered",
              "acknowledged",
              "effect-observed",
              "failed",
              "expired-before-delivery",
              "outcome-unknown"
            ]
          }
        }
      }
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "intent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "supportedVerbs"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "supportedVerbs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "checkedAtAdmission",
        "bindings",
        "checks"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "lease-store",
            "event-store",
            "policy-service",
            "cached-projection",
            "ui-state"
          ]
        },
        "checkedAtAdmission": {
          "type": "boolean"
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal",
            "target",
            "scope",
            "policyRevision",
            "expiresAt",
            "fencingEpoch"
          ],
          "properties": {
            "principal": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "target": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "scope": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "policyRevision": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expiresAt": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "fencingEpoch": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "principal",
            "target",
            "scope",
            "currentPolicy",
            "notExpired",
            "fencingEpoch"
          ],
          "properties": {
            "principal": {
              "type": "boolean"
            },
            "target": {
              "type": "boolean"
            },
            "scope": {
              "type": "boolean"
            },
            "currentPolicy": {
              "type": "boolean"
            },
            "notExpired": {
              "type": "boolean"
            },
            "fencingEpoch": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verb",
          "backend",
          "support",
          "lifecycleStates"
        ],
        "properties": {
          "verb": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "backend": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "support": {
            "type": "string",
            "enum": [
              "supported",
              "unsupported"
            ]
          },
          "lifecycleStates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "requested",
                "policy-denied",
                "queued",
                "delivered",
                "acknowledged",
                "effect-observed",
                "failed",
                "expired-before-delivery",
                "outcome-unknown",
                "unsupported"
              ]
            }
          }
        }
      }
    }
  }
}
