{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskDescription": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "authorityScope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "corpusScope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "catalogSnapshot": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "selectionPolicyRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "semanticRequired": {
      "type": "boolean"
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "HYBRID",
            "LEXICAL_DEGRADED"
          ]
        },
        "corpusPolicyRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "corpusPolicyPermitsLexicalDegraded": {
          "type": "boolean"
        },
        "lexicalProfileRef": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "denseQuery": {
          "type": "object",
          "properties": {
            "profileRef": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "spaceId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "profileRef",
            "spaceId"
          ],
          "additionalProperties": false
        },
        "denseCorpus": {
          "type": "object",
          "properties": {
            "profileRef": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "spaceId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "profileRef",
            "spaceId"
          ],
          "additionalProperties": false
        },
        "degradedReason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "mode",
        "corpusPolicyRef",
        "corpusPolicyPermitsLexicalDegraded",
        "lexicalProfileRef"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "HYBRID"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "denseQuery",
              "denseCorpus"
            ],
            "not": {
              "required": [
                "degradedReason"
              ]
            }
          },
          "else": {
            "required": [
              "degradedReason"
            ],
            "properties": {
              "corpusPolicyPermitsLexicalDegraded": {
                "const": true
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "denseQuery"
                  ]
                }
              },
              {
                "not": {
                  "required": [
                    "denseCorpus"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "required": [
    "taskDescription",
    "authorityScope",
    "corpusScope",
    "catalogSnapshot",
    "selectionPolicyRef",
    "semanticRequired",
    "retrieval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "semanticRequired": {
            "const": true
          }
        },
        "required": [
          "semanticRequired"
        ]
      },
      "then": {
        "properties": {
          "retrieval": {
            "properties": {
              "mode": {
                "const": "HYBRID"
              }
            }
          }
        }
      }
    }
  ]
}
