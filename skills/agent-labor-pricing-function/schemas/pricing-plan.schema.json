{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://port-daddy.dev/schemas/agent-labor-pricing-function/pricing-plan.schema.json",
  "title": "Agent Labor Pricing Plan Draft",
  "description": "Structural input shape. The companion checker returns a policy status for well-formed drafts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "valueMetric", "unitCosts", "pricePoints", "guardrails", "personas"],
  "properties": {
    "model": {"type": "string", "enum": ["per-seat", "metered", "credits", "hybrid", "outcome"]},
    "valueMetric": {"type": "object", "additionalProperties": false, "required": ["name", "unit", "buyerCanPredict"], "properties": {"name": {"type": "string", "pattern": "\\S"}, "unit": {"type": "string", "pattern": "\\S"}, "buyerCanPredict": {"type": "boolean"}, "description": {"type": "string", "pattern": "\\S"}}},
    "unitCosts": {"type": "object", "additionalProperties": false, "required": ["modelTokenCost", "toolCompute", "overhead"], "properties": {"modelTokenCost": {"type": "number", "minimum": 0}, "toolCompute": {"type": "number", "minimum": 0}, "overhead": {"type": "number", "minimum": 0}}},
    "targetMarginPct": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.3},
    "pricePoints": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["tier", "basePrice", "includedUnits"], "properties": {"tier": {"type": "string", "pattern": "\\S"}, "basePrice": {"type": "number", "minimum": 0}, "includedUnits": {"type": "number", "minimum": 0}, "overageRatePerUnit": {"type": "number", "minimum": 0}}}},
    "guardrails": {"type": "object", "additionalProperties": false, "required": ["spendCap", "budgetPreview", "perTaskEstimate", "transparentMetering"], "properties": {"spendCap": {"type": "boolean"}, "budgetPreview": {"type": "boolean"}, "perTaskEstimate": {"type": "boolean"}, "transparentMetering": {"type": "boolean"}}},
    "personas": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "tier", "monthlyUnits"], "properties": {"name": {"type": "string", "pattern": "\\S"}, "tier": {"type": "string", "pattern": "\\S"}, "monthlyUnits": {"type": "number", "minimum": 0}}}},
    "outcomeSettlement": {"type": "object", "additionalProperties": false, "required": ["verifier", "unknownResult"], "properties": {"verifier": {"type": "string", "pattern": "\\S"}, "unknownResult": {"type": "string", "pattern": "\\S"}}}
  }
}
