{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mechanism-security-assessment-v2.schema.json",
  "title": "Mechanism security assessment v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "protocolSnapshotDigest", "repositoryAnchor", "truthState", "scope", "authorities", "assets", "assumptions", "scenarios", "defenses", "settlement", "unresolved", "runtimeAuthority", "settlementAuthority", "legalConclusion", "truthEffect"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "assessmentId": {"type": "string", "minLength": 1},
    "protocolSnapshotDigest": {"type": "string", "minLength": 1},
    "repositoryAnchor": {"type": "string", "minLength": 1},
    "truthState": {"enum": ["SOURCE_PRESENT", "PROPOSED", "UNKNOWN", "BLOCKED_BY_HALT"]},
    "scope": {"type": "string", "minLength": 1},
    "authorities": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["role", "principal", "controlDomain"], "properties": {"role": {"type": "string", "minLength": 1}, "principal": {"type": "string", "minLength": 1}, "controlDomain": {"type": "string", "minLength": 1}}}},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["assetId", "kind", "custodian", "lossBearer", "reachableLoss"], "properties": {"assetId": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "custodian": {"type": "string", "minLength": 1}, "lossBearer": {"type": "string", "minLength": 1}, "reachableLoss": {"$ref": "#/$defs/quantity"}}}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["assumptionId", "statement", "status", "falsifier"], "properties": {"assumptionId": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "status": {"enum": ["EVIDENCED", "POLICY_SELECTED", "UNKNOWN"]}, "falsifier": {"type": "string", "minLength": 1}}}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scenarioId", "family", "coalition", "target", "preconditions", "sequence", "informationAdvantage", "gain", "attackerCost", "victimLoss", "externality", "evidenceRefs", "controlDomains", "defenseIds", "residualSeverity", "falsifier", "reevaluationTrigger", "acceptedRisk"], "properties": {"scenarioId": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "coalition": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "target": {"type": "string", "minLength": 1}, "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}}, "sequence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "informationAdvantage": {"type": "string", "minLength": 1}, "gain": {"$ref": "#/$defs/quantity"}, "attackerCost": {"$ref": "#/$defs/quantity"}, "victimLoss": {"$ref": "#/$defs/quantity"}, "externality": {"$ref": "#/$defs/quantity"}, "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "controlDomains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "defenseIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "residualSeverity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"]}, "falsifier": {"type": "string", "minLength": 1}, "reevaluationTrigger": {"type": "string", "minLength": 1}, "acceptedRisk": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["owner", "trigger", "reviewDate"], "properties": {"owner": {"type": "string", "minLength": 1}, "trigger": {"type": "string", "minLength": 1}, "reviewDate": {"type": "string", "minLength": 1}}}]}}}},
    "defenses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["defenseId", "classes", "statement", "assumptions", "evidenceRefs", "falsifier"], "properties": {"defenseId": {"type": "string", "minLength": 1}, "classes": {"type": "array", "minItems": 1, "items": {"enum": ["STRUCTURAL", "CRYPTOGRAPHIC", "ECONOMIC", "PROCEDURAL", "SOCIAL"]}}, "statement": {"type": "string", "minLength": 1}, "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidenceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "falsifier": {"type": "string", "minLength": 1}}}},
    "settlement": {"type": "object", "additionalProperties": false, "required": ["profile", "effectAuthority", "settlementAuthority", "evidenceClasses", "conflictTerminal", "compensationRequiresNewEffect"], "properties": {"profile": {"enum": ["NO_SETTLEMENT", "BOUNDED_SETTLEMENT"]}, "effectAuthority": {"type": "string", "minLength": 1}, "settlementAuthority": {"type": "string", "minLength": 1}, "evidenceClasses": {"type": "array", "items": {"type": "string", "minLength": 1}}, "conflictTerminal": {"const": "UNSETTLED"}, "compensationRequiresNewEffect": {"const": true}}},
    "unresolved": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "runtimeAuthority": {"const": "NONE"},
    "settlementAuthority": {"const": "NONE"},
    "legalConclusion": {"const": "NONE"},
    "truthEffect": {"const": "NONE"}
  },
  "$defs": {
    "quantity": {"type": "object", "additionalProperties": false, "required": ["state", "low", "high", "unit", "sourceRefs"], "properties": {"state": {"enum": ["KNOWN", "BOUNDED", "UNKNOWN"]}, "low": {"type": ["number", "null"]}, "high": {"type": ["number", "null"]}, "unit": {"type": "string", "minLength": 1}, "sourceRefs": {"type": "array", "items": {"type": "string", "minLength": 1}}}}
  }
}
