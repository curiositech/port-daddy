    "inputEnvelopeSchema": "https://portdaddy.dev/schemas/hypertree-node-input.v1.json",
    "outputEnvelopeSchema": "https://portdaddy.dev/schemas/hypertree-node-output.v1.json",
    "projectionSchema": "https://portdaddy.dev/schemas/hypertree-execution-projection.v1.json",
    "projectionUpdateSchema": "https://portdaddy.dev/schemas/hypertree-execution-projection-update.v1.json",
    "reducerVersion": "drydock-hypertree-reducer.v1",
    "nodeContracts": [
      {
        "id": "dd-070-contract-v1",
        "nodeId": "DD-070",
        "input": {
          "schema": "https://portdaddy.dev/schemas/hypertree-node-input.v1.json",
          "requiredArtifactKinds": [
            "lifecycle states",
            "capacity states",
            "capability states",
            "operator-control contract"
          ],
          "undeclaredInputs": "deny"
        },
        "output": {
          "schema": "https://portdaddy.dev/schemas/hypertree-node-output.v1.json",
          "requiredArtifactKinds": [
            "authority split",
            "state reel",
            "two-action evidence paths",
            "responsive rules"
          ],
          "undeclaredOutputs": "quarantine"
        },
        "riskClasses": [
          "authority"
        ],
        "requiredReviewerClasses": [
          "low-cost-independent",
          "specialist"
        ],
        "reviewPolicyId": "drydock-bounded-review-v1"
      }
    ]
  },
  "reviewPolicy": {
    "id": "drydock-bounded-review-v1",
    "floor": {
      "kind": "deterministic",
      "requiredBeforeReview": true,
      "requiredChecks": [
        "control-projection-separation",
        "fixture-label-visible",
        "stale-unknown-honesty",
        "reduced-motion-contract"
      ]
    },
    "independentReview": {
      "required": true,
      "routing": "lowest-capable-reviewed-tier",
      "reviewerMustDifferFromProducer": true,
      "reservationUnit": "provider-native-units",
      "maxUnitsPerReview": 20
    },
    "specialistReview": {
      "trigger": "failureProbability*downstreamWaste>reviewCost",
      "mandatoryRiskClasses": [
        "identity",
        "authority",
        "money",
        "security",
        "lifecycle",
        "release",
        "destructive-effect"
      ],
      "uncertainMeans": "escalate",
      "reservationUnit": "provider-native-units",
      "maxUnitsPerReview": 30
    },
    "managerGate": {
      "mode": "risk-triggered-and-terminal",
      "managerMustDifferFromProducerAndReviewer": true,
      "mayWaiveChecks": false,
      "maySelfApprove": false,
      "requiredEvidence": [
        "schema-valid-output",
        "all-deterministic-checks-pass",
        "all-required-reviews-approve",
        "no-unresolved-blocking-findings"
      ],
      "reservationUnit": "provider-native-units",
      "maxUnitsPerDecision": 20
    },
    "rework": {
      "verdicts": [
        "APPROVE",
        "REWORK",
        "ESCALATE"
      ],
      "targetMustBeNamed": true,
      "findingIdsRequired": true,
      "sameFindingRepeatLimit": 1
    }
  },
  "limits": {
    "maxScopeNodes": 100,
    "maxEvents": 500,
    "maxNodeStartsTotal": 20,
    "maxCapacityReservationsTotal": 40,
    "maxArtifactsPerOutput": 16,
    "maxOutputBytesPerAttempt": 1048576,
    "maxNodeAttempts": 3,
    "maxReworkRounds": 2,
    "maxManagerRounds": 3,
    "maxTopologyMutations": 3,
    "maxWallClockSeconds": 600,
    "maxRecursiveBirths": 0,
    "retryOwner": "external-controller",
    "retryLayers": 1
  },
