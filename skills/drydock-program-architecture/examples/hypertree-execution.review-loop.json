    }
  },
  "scope": {
    "nodeIds": [
      "DD-070"
    ],
    "dependencies": [
      {
        "nodeId": "DD-070",
        "dependsOnNodeIds": []
      }
    ],
    "fixturePurpose": "Prove that a deficient candidate cannot pass review, receives one named bounded rework edge, and is projected identically to HTML, Swift, and Rust clients."
  },
  "authorityModel": {
    "eventAdmission": "controller-only",
    "projectionReducer": "controller-typescript",
    "clientAuthority": "projection-only"
  },
