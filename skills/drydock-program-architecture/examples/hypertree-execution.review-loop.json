  "reviewPolicy": {
    "id": "drydock-bounded-review-v1",
    "floor": {
      "kind": "deterministic",
      "requiredBeforeReview": true,
      "requiredChecks": [
        "control-projection-separation",
        "fixture-label-visible",
        "stale-unknown-honesty",
        "reduced-motion-contract"
      ]
    },
    "independentReview": {
      "required": true,
      "routing": "lowest-capable-reviewed-tier",
      "reviewerMustDifferFromProducer": true,
      "reservationUnit": "provider-native-units",
      "maxUnitsPerReview": 20
    },
    "specialistReview": {
      "trigger": "failureProbability*downstreamWaste>reviewCost",
      "mandatoryRiskClasses": [
        "identity",
        "authority",
        "money",
        "security",
        "lifecycle",
        "release",
        "destructive-effect"
      ],
      "uncertainMeans": "escalate",
      "reservationUnit": "provider-native-units",
      "maxUnitsPerReview": 30
    },
    "managerGate": {
      "mode": "risk-triggered-and-terminal",
      "managerMustDifferFromProducerAndReviewer": true,
      "mayWaiveChecks": false,
      "maySelfApprove": false,
      "requiredEvidence": [
        "schema-valid output",
        "all deterministic checks PASS",
        "independent review APPROVE",
        "no unresolved blocking finding"
      ]
    },
    "rework": {
      "verdicts": ["APPROVE", "REWORK", "ESCALATE"],
      "targetMustBeNamed": true,
      "findingIdsRequired": true,
      "sameFindingRepeatLimit": 1
    }
  },
  "limits": {
    "maxNodeAttempts": 3,
    "maxReworkRounds": 2,
    "maxManagerRounds": 3,
    "maxTopologyMutations": 3,
    "maxWallClockSeconds": 600,
