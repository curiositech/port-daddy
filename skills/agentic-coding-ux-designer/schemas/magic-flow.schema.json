{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic Coding Magic Flow",
  "type": "object",
  "required": ["flowName", "steps"],
  "properties": {
    "flowName": { "type": "string" },
    "passScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "friction": { "type": "number", "minimum": 0, "maximum": 5 },
          "context": { "type": ["boolean", "string"] },
          "visibleProgress": { "type": ["boolean", "string"] },
          "rollback": { "type": ["boolean", "string"] },
          "humanGate": { "type": ["boolean", "string"] },
          "receipt": { "type": ["boolean", "string"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
