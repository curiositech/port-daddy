{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://port-daddy.dev/schemas/pd-relay-zero-trust/merkle-chain-head.json",
  "title": "Signed Chain Head",
  "description": "A periodic, signed checkpoint of a per-publisher event chain. Heads are published to the relay AND optionally anchored externally (DNS TXT, signed git commit, transparency log).",
  "type": "object",
  "required": ["v", "sender", "tip_seq", "tip_hash", "issued_at", "alg", "sig", "kid"],
  "properties": {
    "v": {"const": 1},
    "sender": {"type": "string"},
    "channel": {"type": ["string", "null"], "description": "Optional channel scope; null/absent = whole-publisher chain across all channels"},
    "tip_seq": {"type": "integer", "minimum": 0},
    "tip_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "integer"},
    "anchors": {
      "type": "array",
      "description": "Optional external anchors of this head",
      "items": {
        "type": "object",
        "required": ["kind", "ref"],
        "properties": {
          "kind": {"type": "string", "enum": ["dns-txt", "git-commit", "transparency-log", "blockchain", "tweet", "rfc8785-jws"]},
          "ref": {"type": "string"},
          "anchored_at": {"type": "integer"}
        },
        "additionalProperties": false
      }
    },
    "alg": {"const": "EdDSA"},
    "sig": {"type": "string"},
    "kid": {"type": "string"}
  },
  "additionalProperties": false
}
