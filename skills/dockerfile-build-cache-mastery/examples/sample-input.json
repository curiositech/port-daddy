  "buildkitEnabled": true,
  "copyOrder": "manifest-first",
  "runtimeLanguage": "node",
  "cacheMountForPackageManager": true,
  "multiStage": true,
  "finalImageSizeMB": 220,
  "dockerignorePresent": true,
