# Port Daddy Fleet Executor — Cloudflare Worker (TEMPLATE)
#
# Copy this file to `wrangler.toml` and replace every REPLACE_WITH_YOUR_* token
# with the ids/values you get from the provisioning commands below. The real
# `wrangler.toml` is gitignored (it carries the account-scoped KV id and the
# GitHub App id); only this template is committed.
#
# Provisioning (run once, then paste the ids returned):
#
#   1. Create the installation-token KV namespace — copy id into [[kv_namespaces]]:
#        wrangler kv namespace create FLEET_TOKENS
#
#   2. Create the queue + DLQ (consumer binding below):
#        wrangler queues create fleet-runs
#        wrangler queues create fleet-runs-dlq
#
#   3. Set the GitHub App id (var) and private key (secret):
#        # Put your numeric App id into [vars].GITHUB_APP_ID below, OR set as a secret:
#        echo "<app-id>" | wrangler secret put GITHUB_APP_ID
#        cat app-key.pem  | wrangler secret put GITHUB_APP_PRIVATE_KEY
#
#   4. Deploy:
#        wrangler deploy
#
# CI auto-deploy: pushes to `main` under apps/fleet-executor/** are deployed by
# .github/workflows/deploy-fleet-executor.yml. Because this real wrangler.toml is
# gitignored, that workflow reconstructs it from the FLEET_EXECUTOR_WRANGLER_TOML
# repo secret. After editing your local wrangler.toml, refresh the secret:
#        gh secret set FLEET_EXECUTOR_WRANGLER_TOML --repo curiositech/port-daddy --app actions < apps/fleet-executor/wrangler.toml

name = "fleet-executor"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

# Required for operator-grade delivery forensics. Console diagnostics include
# bounded GitHub response status/request-id/rate-limit evidence; request
# headers, request bodies, and the GitHub token are never recorded.
[observability]
enabled = true

# ---------------------------------------------------------------------------
# CPU budget per invocation.
#
# WHY THIS EXISTS: without a [limits] block a Worker gets the 30-second default
# CPU budget, and a fleet run does not fit in it. Exceeding it is not a JS
# exception — the runtime TERMINATES the invocation, so index.ts's try/catch
# never runs, the message is never acked, and the platform redelivers it. With
# max_retries = 3 that is four full runs of the same PR (four sets of ship
# comments, four times the model spend) ending in a dead-letter whose only
# artifact is "was lost (job exhausted retries / dead-lettered)" — a red gate
# with no cause attached, because no code in this Worker ever got to see one.
#
# Observed 2026-08-19 on PRs #7278, #7339, #7344 and #7377: every attempt ran
# the ideation ships to completion (each rewrote its own edit-in-place comment,
# four distinct versions per PR) and then vanished mid-run, ~75s of wall clock
# apiece — far inside the 15-minute wall-clock budget for a queue consumer, and
# consistent with hitting the CPU ceiling instead.
#
# 300_000 ms (5 minutes) is the platform maximum. It is a CEILING, not a
# reservation: a run that finishes in two seconds of CPU is billed for two
# seconds. The queue consumer above is already serialized (max_concurrency = 1),
# so raising this cannot widen concurrent spend.
[limits]
cpu_ms = 300000

# ---------------------------------------------------------------------------
# Workers AI — runs the analytical ships (code-reviewer, qa, red-team, …).
[ai]
binding = "AI"

# Relay's named, RPC-only ADR-0092 grant issuer. Deploy that named entrypoint
# before deploying this caller binding. Fleet never stores a static macaroon.
[[services]]
binding = "COORDINATION_GRANTS"
service = "port-daddy-relay"
entrypoint = "CoordinationGrantService"

# ---------------------------------------------------------------------------
# KV — installation-token cache. Keyed by `github_inst_<installationId>`,
# value `{ token, expiresAt }`, TTL set to (expiresAt - 60s). Avoids re-minting
# a GitHub App installation token for every ship in the same fleet run.
[[kv_namespaces]]
binding = "FLEET_TOKENS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# CONTROL-PLANE KV: must be the SAME id the relay binds as "KV" (apps/relay
# wrangler.toml). Carries the `fleet:paused` kill switch the relay toggles.
[[kv_namespaces]]
binding = "CONTROL_KV"
id = "REPLACE_WITH_YOUR_RELAY_KV_NAMESPACE_ID"

# ---------------------------------------------------------------------------
# D1 — shared relay database. The executor writes the fleet_runs audit header
# (one row per GitHub delivery) and the append-only fleet_run_steps transcript.
# Use the SAME database the relay reads from (/v1/fleet/activity|runs|health).
# All executor writes are best-effort: a transcript-write failure never fails
# the run or changes the merge gate. Provision once and paste the id:
#   wrangler d1 create port-daddy-relay   # (or reuse the relay's existing id)
[[d1_databases]]
binding = "DB"
database_name = "port-daddy-relay"
database_id = "REPLACE_WITH_YOUR_RELAY_D1_DATABASE_ID"

# ---------------------------------------------------------------------------
# OPTIONAL — Cloudflare Sandboxes (Containers beta) for the purser ship.
# NOT ENABLED: this block is documentation, not a live binding. When the
# SANDBOX binding exists, the purser (src/purser.ts) executes its authored
# adversarial tests against the PR head inside an isolated container and
# reports REAL pass/fail. When absent (this default), src/sandbox-runner.ts
# returns executed:false and the purser NEVER fabricates test results —
# its verdict then follows the ship's blockWithoutSandbox flag (default:
# advisory; never block on tests that were never run).
#
# To enable (requires the Containers beta on your account):
#   1. npm i @cloudflare/sandbox   (and a Dockerfile per its README)
#   2. export the Sandbox class from src/index.ts:
#        export { Sandbox } from '@cloudflare/sandbox';
#   3. Uncomment and adjust:
#
# [[containers]]
# class_name = "Sandbox"
# image = "./Dockerfile"
# instance_type = "basic"
#
# [[durable_objects.bindings]]
# name = "SANDBOX"
# class_name = "Sandbox"
#
# [[migrations]]
# tag = "v1-purser-sandbox"
# new_sqlite_classes = ["Sandbox"]

# ---------------------------------------------------------------------------
# Queue producer + consumer — one message per GitHub delivery, enqueued by
# relay. Successful one-ship slices enqueue an explicit continuation before
# acknowledging their current delivery; Cloudflare retries are reserved for
# actual failures.
# A blocking ship that never completes must never leave a green/pending gate,
# so after `max_retries` exhausted the message lands in the DLQ where a
# follow-up handler completes the check run as 'failure' (fail-closed).
[[queues.producers]]
binding = "FLEET_CONTINUATIONS"
queue = "fleet-runs"

[[queues.consumers]]
queue = "fleet-runs"
# Isolate long reviews by batch and invocation. A one-message batch alone still
# permits many concurrent Worker invocations, multiplying each run's model
# fan-out and allowing obsolete/current heads to review simultaneously.
max_batch_size = 1
max_concurrency = 1
max_batch_timeout = 30
# Each successful invocation runs at most one new provider-heavy ship, records
# a delivery-continuation step, enqueues the next checkpointed slice, and
# acknowledges the current message. Retries are therefore true failure
# attempts, bounded independently of roster size.
max_retries = 3
dead_letter_queue = "fleet-runs-dlq"

# Required merge-group checks are deterministic and make no AI calls. Keep them
# on an independent FIFO so substantive reviews cannot starve the GitHub merge
# queue while preserving max_concurrency=1 for each workload.
[[queues.consumers]]
queue = "fleet-gates"
max_batch_size = 1
max_concurrency = 1
max_batch_timeout = 5
max_retries = 3
dead_letter_queue = "fleet-runs-dlq"

# DLQ consumer — the same Worker handles it (index.ts routes on batch.queue).
# A dead-lettered job's 'Port Daddy Fleet' check is completed as 'failure' so a
# lost blocking job never leaves a stuck in_progress gate. No further DLQ (a
# message here already exhausted retries); low retries since the handler acks.
[[queues.consumers]]
queue = "fleet-runs-dlq"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 1

# ---------------------------------------------------------------------------
# Plaintext vars. GITHUB_APP_PRIVATE_KEY is a *secret*, set out-of-band:
#   echo "123456" | wrangler secret put GITHUB_APP_ID        # (or var, below)
#   cat app-key.pem | wrangler secret put GITHUB_APP_PRIVATE_KEY
# DEFAULT_BRANCH is the TRUSTED ref every config/contract file is read from.
# It is NEVER pull_request.head — that is the zero-trust invariant.
[vars]
GITHUB_APP_ID = "REPLACE_WITH_YOUR_GITHUB_APP_ID"
DEFAULT_BRANCH = "main"
# AI_GATEWAY_ID (OPTIONAL, ADR-0116/0117): a Cloudflare AI Gateway id. When set,
# every ship's env.AI.run(...) is routed through this gateway so token/cost/latency
# is logged and cacheable in the AI Gateway dashboard. UNSET / empty ⇒ calls hit
# Workers AI directly (exactly today's behavior). Create one with:
#   wrangler ai-gateway create fleet-executor   # then paste its id below
# AI_GATEWAY_ID = "fleet-executor"
# Cloud telemetry sink — the daemon (or its public tunnel) that ingests per-ship
# cost + failure events at POST /telemetry/cloud-app. This is what relights
# FleetBar's cost panel and surfaces cloud ship failures. OPTIONAL and DISABLED
# by default: an empty string ⇒ emitCloudTelemetry no-ops (no fetch per ship), so
# copying this template verbatim never points ships at a bogus host. Fill it in
# ONLY once you have a real sink URL, e.g. "https://your-tunnel/telemetry/cloud-app".
PORT_DADDY_TELEMETRY_URL = ""

# ADR-0092 cloud coordination peer transport. The verified repository and
# durable Fleet run become the grant's project/actor scope at runtime. Relay
# remains a peer, never authority: local daemon writes survive its absence.
PORT_DADDY_COORDINATION_URL = "https://relay.portdaddy.dev"

# Cloud squid — fleet coordination events (src/squid-events.ts). When
# RELAY_PUBLISH_URL (var) AND the FLEET_EXECUTOR_ED25519_PRIVATE_KEY_HEX +
# FLEET_EXECUTOR_HARBOR_CARD secrets are all set, the executor fire-and-forgets
# run-started / ship-verdict / pr-stacked / run-concluded events onto the
# per-run channel `<relayFp>:fleet-cloud:<runId>` as SIGNED zero-trust
# publishes to the relay's POST /v1/publish:
#   POST <RELAY_PUBLISH_URL>  { card, event: { v, sender, channel, seq,
#                               prev_hash, this_hash, iat, ciphertext, sig } }
# There is NO bearer token and NO Authorization header — the relay verifies
# the executor's operator-provisioned identity, its harbor card, and the
# per-run hash chain. OPTIONAL and DISABLED by default: leave empty ⇒ zero
# fetches, feature silently off. Events are best-effort — they can never
# block or change a run, a verdict, or the merge gate.
#
# FLEET_DEPLOYMENT (var, optional): names this deployment inside the squid/1
# body's sender (`fleet-executor@<deployment>`). Default 'default'.
#
# TENANCY CONSENT: env wiring alone is NOT enough. Events carry the tenant
# repo's name, PR numbers, verdicts, and stacked-PR urls onto a shared
# channel, so the executor additionally requires the TENANT repo to opt in
# with a top-level `squidEvents: true` under `fleet:` in its pd-fleet.yml
# (read from the trusted default branch; default false — see
# parseFleetSquidEvents in src/fleet.ts). Repos that haven't opted in emit
# nothing, even with both RELAY_PUBLISH_* values set.
RELAY_PUBLISH_URL = ""

# Human-facing run page (ADR-0101 Phase 0). When BOTH this and the
# RUN_PAGE_SECRET secret are set, every 'Port Daddy Fleet' check run carries a
# details_url pointing at the relay's HTML deliberation page for that run:
#   <RUN_DETAILS_BASE_URL>/fleet/runs/<runId>?t=<hmac>
# OPTIONAL and DISABLED by default: empty ⇒ no details_url (prior behavior).
RUN_DETAILS_BASE_URL = ""

# ---------------------------------------------------------------------------
# Secrets (documented; set via `wrangler secret put`, never committed):
#   GITHUB_APP_PRIVATE_KEY     PEM-encoded GitHub App private key
#   GITHUB_APP_ID              (may be a secret instead of a var if preferred)
#   PORT_DADDY_TELEMETRY_TOKEN Bearer token for POST /telemetry/cloud-app
#                              (matches the daemon's PD_CLOUD_APP_TELEMETRY_TOKEN)
#   RUN_PAGE_SECRET            HMAC secret (>=32 chars) for run-page capability
#                              tokens; MUST equal the relay's RUN_PAGE_SECRET
#                              (openssl rand -hex 32, then wrangler secret put
#                              RUN_PAGE_SECRET in BOTH workers)
#   FLEET_EXECUTOR_ED25519_PRIVATE_KEY_HEX
#                              The executor's Ed25519 seed (64 hex chars) for
#                              signed cloud-squid publishes. Generate with
#                              `openssl rand -hex 32`, register its PUBLIC key
#                              via the relay's operator-gated
#                              POST /v1/fleet/executor-identity, then
#                              `wrangler secret put` the seed here. Optional:
#                              unset ⇒ squid events are silently disabled.
#   FLEET_EXECUTOR_HARBOR_CARD The hv:2 harbor card returned by the same
#                              provisioning call (relay-signed EdDSA JWT with
#                              cap pub on <relayFp>:fleet-cloud:*). Rotate by
#                              POST /v1/revoke-by-issuer (issuer
#                              `operator:fleet-executor@<deployment>`) and
#                              re-provisioning with a fresh keypair. Optional:
#                              unset ⇒ squid events are silently disabled.
