# Port Daddy Fleet Executor — Cloudflare Worker (TEMPLATE)
#
# Copy this file to `wrangler.toml` and replace every REPLACE_WITH_YOUR_* token
# with the ids/values you get from the provisioning commands below. The real
# `wrangler.toml` is gitignored (it carries the account-scoped KV id and the
# GitHub App id); only this template is committed.
#
# Provisioning (run once, then paste the ids returned):
#
#   1. Create the installation-token KV namespace — copy id into [[kv_namespaces]]:
#        wrangler kv namespace create FLEET_TOKENS
#
#   2. Create the queue + DLQ (consumer binding below):
#        wrangler queues create fleet-runs
#        wrangler queues create fleet-runs-dlq
#
#   3. Set the GitHub App id (var) and private key (secret):
#        # Put your numeric App id into [vars].GITHUB_APP_ID below, OR set as a secret:
#        echo "<app-id>" | wrangler secret put GITHUB_APP_ID
#        cat app-key.pem  | wrangler secret put GITHUB_APP_PRIVATE_KEY
#
#   4. Deploy:
#        wrangler deploy
#
# CI auto-deploy: pushes to `main` under apps/fleet-executor/** are deployed by
# .github/workflows/deploy-fleet-executor.yml. Because this real wrangler.toml is
# gitignored, that workflow reconstructs it from the FLEET_EXECUTOR_WRANGLER_TOML
# repo secret. After editing your local wrangler.toml, refresh the secret:
#        gh secret set FLEET_EXECUTOR_WRANGLER_TOML --repo curiositech/port-daddy --app actions < apps/fleet-executor/wrangler.toml

name = "fleet-executor"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

# ---------------------------------------------------------------------------
# Workers AI — runs the analytical ships (code-reviewer, qa, red-team, …).
[ai]
binding = "AI"

# ---------------------------------------------------------------------------
# KV — installation-token cache. Keyed by `github_inst_<installationId>`,
# value `{ token, expiresAt }`, TTL set to (expiresAt - 60s). Avoids re-minting
# a GitHub App installation token for every ship in the same fleet run.
[[kv_namespaces]]
binding = "FLEET_TOKENS"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# CONTROL-PLANE KV: must be the SAME id the relay binds as "KV" (apps/relay
# wrangler.toml). Carries the `fleet:paused` kill switch the relay toggles.
[[kv_namespaces]]
binding = "CONTROL_KV"
id = "REPLACE_WITH_YOUR_RELAY_KV_NAMESPACE_ID"

# ---------------------------------------------------------------------------
# D1 — shared relay database. The executor writes the fleet_runs audit header
# (one row per GitHub delivery) and the append-only fleet_run_steps transcript.
# Use the SAME database the relay reads from (/v1/fleet/activity|runs|health).
# All executor writes are best-effort: a transcript-write failure never fails
# the run or changes the merge gate. Provision once and paste the id:
#   wrangler d1 create port-daddy-relay   # (or reuse the relay's existing id)
[[d1_databases]]
binding = "DB"
database_name = "port-daddy-relay"
database_id = "REPLACE_WITH_YOUR_RELAY_D1_DATABASE_ID"

# ---------------------------------------------------------------------------
# Queue consumer — one message per GitHub delivery, enqueued by relay.
# A blocking ship that never completes must never leave a green/pending gate,
# so after `max_retries` exhausted the message lands in the DLQ where a
# follow-up handler completes the check run as 'failure' (fail-closed).
[[queues.consumers]]
queue = "fleet-runs"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 3
dead_letter_queue = "fleet-runs-dlq"

# DLQ consumer — the same Worker handles it (index.ts routes on batch.queue).
# A dead-lettered job's 'Port Daddy Fleet' check is completed as 'failure' so a
# lost blocking job never leaves a stuck in_progress gate. No further DLQ (a
# message here already exhausted retries); low retries since the handler acks.
[[queues.consumers]]
queue = "fleet-runs-dlq"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 1

# ---------------------------------------------------------------------------
# Plaintext vars. GITHUB_APP_PRIVATE_KEY is a *secret*, set out-of-band:
#   echo "123456" | wrangler secret put GITHUB_APP_ID        # (or var, below)
#   cat app-key.pem | wrangler secret put GITHUB_APP_PRIVATE_KEY
# DEFAULT_BRANCH is the TRUSTED ref every config/contract file is read from.
# It is NEVER pull_request.head — that is the zero-trust invariant.
[vars]
GITHUB_APP_ID = "REPLACE_WITH_YOUR_GITHUB_APP_ID"
DEFAULT_BRANCH = "main"
# AI_GATEWAY_ID (OPTIONAL, ADR-0116/0117): a Cloudflare AI Gateway id. When set,
# every ship's env.AI.run(...) is routed through this gateway so token/cost/latency
# is logged and cacheable in the AI Gateway dashboard. UNSET / empty ⇒ calls hit
# Workers AI directly (exactly today's behavior). Create one with:
#   wrangler ai-gateway create fleet-executor   # then paste its id below
# AI_GATEWAY_ID = "fleet-executor"
# Cloud telemetry sink — the daemon (or its public tunnel) that ingests per-ship
# cost + failure events at POST /telemetry/cloud-app. This is what relights
# FleetBar's cost panel and surfaces cloud ship failures. OPTIONAL and DISABLED
# by default: an empty string ⇒ emitCloudTelemetry no-ops (no fetch per ship), so
# copying this template verbatim never points ships at a bogus host. Fill it in
# ONLY once you have a real sink URL, e.g. "https://your-tunnel/telemetry/cloud-app".
PORT_DADDY_TELEMETRY_URL = ""

# Human-facing run page (ADR-0101 Phase 0). When BOTH this and the
# RUN_PAGE_SECRET secret are set, every 'Port Daddy Fleet' check run carries a
# details_url pointing at the relay's HTML deliberation page for that run:
#   <RUN_DETAILS_BASE_URL>/fleet/runs/<runId>?t=<hmac>
# OPTIONAL and DISABLED by default: empty ⇒ no details_url (prior behavior).
RUN_DETAILS_BASE_URL = ""

# ---------------------------------------------------------------------------
# Secrets (documented; set via `wrangler secret put`, never committed):
#   GITHUB_APP_PRIVATE_KEY     PEM-encoded GitHub App private key
#   GITHUB_APP_ID              (may be a secret instead of a var if preferred)
#   PORT_DADDY_TELEMETRY_TOKEN Bearer token for POST /telemetry/cloud-app
#                              (matches the daemon's PD_CLOUD_APP_TELEMETRY_TOKEN)
#   RUN_PAGE_SECRET            HMAC secret (>=32 chars) for run-page capability
#                              tokens; MUST equal the relay's RUN_PAGE_SECRET
#                              (openssl rand -hex 32, then wrangler secret put
#                              RUN_PAGE_SECRET in BOTH workers)
