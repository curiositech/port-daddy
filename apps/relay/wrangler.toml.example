# Port Daddy Relay — Cloudflare Worker (TEMPLATE)
#
# Copy this file to `wrangler.toml` and replace every REPLACE_WITH_YOUR_* token
# with the ids you get back from the provisioning commands below. The real
# `wrangler.toml` is gitignored (it carries account-scoped resource ids); only
# this template is committed.
#
# Provisioning (run once, then paste the ids returned):
#
#   1. Create the D1 database — copy the printed database_id into [[d1_databases]]:
#        wrangler d1 create port-daddy-relay
#
#   2. Apply the schema:
#        wrangler d1 execute port-daddy-relay --file=./schema.sql
#
#   3. Create the KV namespace — copy the printed id into [[kv_namespaces]]:
#        wrangler kv namespace create KV
#
#   4. Create the fleet-runs queue (producer binding below):
#        wrangler queues create fleet-runs
#
#   5. Set secrets (never committed):
#        echo "<value>" | wrangler secret put RELAY_OPERATOR_TOKEN
#        echo "<value>" | wrangler secret put RELAY_ED25519_PRIVATE_KEY_HEX
#        echo "<value>" | wrangler secret put GITHUB_WEBHOOK_SECRET
#
#   6. Deploy:
#        wrangler deploy
#
# Local dev:
#   wrangler dev --local   (uses local D1 sqlite, local DO)

name = "port-daddy-relay"
main = "src/index.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

[vars]
RELAY_VERSION = "0.1.0"
EVENT_RETENTION_DAYS = "7"
SESSION_TTL_SECONDS = "3600"
JWKS_CACHE_TTL_SECONDS = "600"
JWKS_FAIL_SOFT_SECONDS = "3600"
REVOCATION_BROADCAST_TIMEOUT_MS = "5000"
RATE_LIMIT_WINDOW_MS = "60000"
# X8 quotas (src/harbor-quota.ts): per-harbor daily budgets + the enforcement
# switch. SHADOW BY DEFAULT — only the exact string "enforce" makes budget
# exhaustion refuse (429 + Retry-After + credit-ledger pointer).
QUOTA_ENFORCE = "shadow"
HARBOR_DAILY_EVENT_BUDGET = "100000"
HARBOR_DAILY_BYTE_BUDGET = "268435456"
# Fleet control-plane: GitHub App + trusted ref for the config-read and save (PR)
# endpoints. GITHUB_APP_PRIVATE_KEY is a *secret* (never committed):
#   cat app-key.pem | wrangler secret put GITHUB_APP_PRIVATE_KEY
GITHUB_APP_ID = "REPLACE_WITH_YOUR_GITHUB_APP_ID"
GITHUB_OWNER = "REPLACE_WITH_YOUR_GITHUB_OWNER"
GITHUB_REPO = "REPLACE_WITH_YOUR_GITHUB_REPO"
DEFAULT_BRANCH = "main"

# ---------------------------------------------------------------------------
# Workers AI — fleet control-plane smoke-test + optimize-prompt endpoints.
# No id needed; `wrangler` provisions the binding on deploy.
[ai]
binding = "AI"

[[d1_databases]]
binding = "DB"
database_name = "port-daddy-relay"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[durable_objects]
bindings = [
  { name = "HARBOR_CHANNEL", class_name = "HarborChannel" },
  { name = "HARBOR_QUOTA", class_name = "HarborQuota" },
]

[[migrations]]
tag = "v0001"
new_classes = ["HarborChannel"]

# X8 quotas: one aggregating quota DO per harbor (src/harbor-quota.ts).
[[migrations]]
tag = "v0002"
new_classes = ["HarborQuota"]

[[kv_namespaces]]
# JWKS cache and pinned relay key cache
binding = "KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# Fleet-executor handoff: relay enqueues one FleetRunJob per GitHub delivery.
# Operator must `wrangler queues create fleet-runs` before this deploy succeeds.
[[queues.producers]]
binding = "FLEET_RUNS"
queue = "fleet-runs"

[observability]
enabled = true

# ---------------------------------------------------------------------------
# Cron Triggers — one scheduled() handler dispatches on event.cron:
#   "0 */6 * * *"  — retention + session-reap + erasure sweep (ADR-0101).
#   "*/5 * * * *"  — MERCY v1 hospital-ship health sweep (src/mercy.ts).
#
# MERCY paging — optional. On a subsystem's first red sweep, MERCY opens a
# dedupe row in mercy_incidents and POSTs ONE JSON page to this webhook URL
# (never a second page while the incident stays unresolved):
#
#   echo "<url>" | wrangler secret put MERCY_PAGE_WEBHOOK
#
# Treat the URL as a SECRET: PagerDuty/Grafana OnCall ingest URLs embed
# routing keys. Recommended targets (Cloudflare has NO native on-call
# rotation — be honest with yourself about this):
#   * PagerDuty Events API v2:  https://events.pagerduty.com/… via a small
#     bridge, or a PagerDuty "Custom Event Transformer" endpoint.
#   * Grafana OnCall inbound webhook (free tier includes rotations).
#   * Cloudflare Notification webhook destinations only fan out CF-originated
#     alerts (Health Checks, Workers alerts) — they do not receive MERCY's
#     POSTs. Pair them WITH this webhook, not instead of it.
# Full operator runbook (dashboard clicks for Health Checks + Notification
# policies, and what CF cannot do): docs/mercy-oncall.md
