{
  "name": "@port-daddy/github-app-receiver",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that verifies GitHub App webhook signatures and forwards normalized envelopes to the Port Daddy daemon.",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
