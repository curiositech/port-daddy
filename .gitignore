# Local scratch/probe scripts and generated artifact lists.
# Ignore nested .scratch/ trees, but keep the repository-root .scratch/ in git
# because it holds operator research notes ("save research markdowns always").
# Both negations are needed: !/.scratch/ re-opens the root directory, and
# !/.scratch/** re-opens new files below it after **/.scratch/ matched them.
**/.scratch/
!/.scratch/
!/.scratch/**

# ... but not the sandbox DIRECTORIES tests create inside it. Many suites
# mkdtemp under .scratch/ (coordination-guard, halt-watch, history-reader and
# others), and every run leaves a tree behind that shows up as untracked noise
# and invites somebody to commit test litter. The nine files this directory
# really carries are research notes written directly in it, so the rule is
# shape rather than a list of prefixes: files at the top level stay tracked,
# any subdirectory is ignored. A prefix list would have to be edited every time
# a suite adds a fixture, which is the kind of rule that rots quietly.
/.scratch/*/

# Xcode/SwiftPM user-specific and generated workspace files
xcuserdata/
*.xcuserstate
**/.swiftpm/xcode/package.xcworkspace/

# Ephemeral runtime lock files
.claude/scheduled_tasks.lock

# Per-runtime skill symlink fan-out (generated by scripts/sync-skills.ts).
# The canonical, version-controlled catalog is skills/ (no leading dot).
# These dirs are machine-local absolute symlinks — regenerate, never commit.
.agents/skills/
.agy/skills/
.codex/skills/
.claude/skills/
.gemini/skills/
.gemini/extensions/port-daddy/skills/
.cursor/skills/
.continue/skills/
.windsurf/skills/
.roo/skills/
.opencode/skills/
.trae/skills/
.qoder/skills/
.codebuddy/skills/
.agent/skills/
.kiro/steering/

# Privacy-scan remediation: machine-local config, build trees, and Xcode
# per-user state must never be committed. Provisioning ids/secrets live in
# wrangler.toml — use the checked-in *.example templates instead.
apps/*/wrangler.toml
# (apps/*/wrangler.deploy.toml IS committed: id-only CI deploy configs, no secrets.)
# miniflare/wrangler local state (local D1 sqlite, DO storage, dev caches).
**/.wrangler/
**/.swiftpm/xcode/package.xcworkspace/xcuserdata/
**/*.xcuserstate

# Generated from com.portdaddy.fleetbar.plist.template by apps/FleetBar/install.sh
apps/FleetBar/com.portdaddy.fleetbar.plist

# harbor-results scripts savefig() to bare filenames, so running one from the
# repo root drops a stray PNG here. The canonical copies are committed under
# docs/harbor-research/figures/ — these root-level ones are re-renders and are
# never the artifact of record.
/a7_figure.png
/b2_figure.png
/b8_figure.png
