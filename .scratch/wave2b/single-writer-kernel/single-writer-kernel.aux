\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Claim granularity is richer than ``claims''}{12}{subsection.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}The claim lifecycle as a finite-state machine}{12}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The claim/lock lifecycle as a finite-state machine, exhibiting the four properties on which the coordination layer builds typed ownership. \emph  {Acquire} is a single atomic insert against a uniqueness constraint (I2: a concurrent acquirer loses cleanly to a constraint violation and is handed the current holder). \emph  {Re-claim} and \emph  {release} are idempotent (I3): safe to retry, safe to double. Expiry is \emph  {lazy-swept} on the next read (I4) --- expired rows are deleted when encountered, not on a timer. The conspicuous missing state is \textsc  {queued}: there is no wait-list and no fairness primitive, so a fast agent churning a hot resource can starve a slow one indefinitely --- open problem OP-1, which asks whether bounded-wait can be added without dragging a scheduler down into the kernel.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:swk-claim-lifecycle}{{5}{12}{The claim/lock lifecycle as a finite-state machine, exhibiting the four properties on which the coordination layer builds typed ownership. \emph {Acquire} is a single atomic insert against a uniqueness constraint (I2: a concurrent acquirer loses cleanly to a constraint violation and is handed the current holder). \emph {Re-claim} and \emph {release} are idempotent (I3): safe to retry, safe to double. Expiry is \emph {lazy-swept} on the next read (I4) --- expired rows are deleted when encountered, not on a timer. The conspicuous missing state is \textsc {queued}: there is no wait-list and no fairness primitive, so a fast agent churning a hot resource can starve a slow one indefinitely --- open problem OP-1, which asks whether bounded-wait can be added without dragging a scheduler down into the kernel}{figure.caption.9}{}}
\newlabel{alg:acquire}{{1}{13}{Claim acquisition. The whole acquire is a single insert against a uniqueness constraint; the loser is handed the current holder, not an error to retry blindly}{lstlisting.1}{}}
\@writefile{lol}{\contentsline {lstlisting}{\numberline {1}{\ignorespaces Claim acquisition. The whole acquire is a single insert against a uniqueness constraint; the loser is handed the current holder, not an error to retry blindly.}}{13}{lstlisting.1}\protected@file@percent }
\newlabel{thm:exclusion}{{6.1}{13}{Atomic mutual exclusion}{theorem.6.1}{}}
