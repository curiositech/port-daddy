\@writefile{toc}{\contentsline {section}{\numberline {5}Durability, split by fault class}{10}{section.5}\protected@file@percent }
\newlabel{sec:durability}{{5}{10}{Durability, split by fault class}{section.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Durability by fault class --- the single most important correction to the kernel's foundational promise, and exactly Gray \& Reuter's atomicity-versus-durability distinction (the ``D'' in ACID is a separate promise). The unqualified claim ``a write that returned success survives a crash'' is true for a \emph  {process} crash (I1a: the OS page cache persists past the dying daemon) but \emph  {not guaranteed} for an OS crash or power loss (I1b), because under normal synchronization the WAL is synced only at checkpoints --- the seductive belief that ``normal sync is safe in WAL mode'' conflates crash-\emph  {consistency} (true) with power-loss \emph  {durability} (false). The remedy for I1b is full synchronization or a checkpoint on the commit path; the kernel does not pay that cost by default, and the prose must not imply it does. We split the invariant accordingly: I1a is \textsf  {implemented}; I1b is \textsf  {not guaranteed} under the default WAL configuration.}}{10}{figure.caption.7}\protected@file@percent }
\newlabel{fig:swk-durability-faultclass}{{4}{10}{Durability by fault class --- the single most important correction to the kernel's foundational promise, and exactly Gray \& Reuter's atomicity-versus-durability distinction (the ``D'' in ACID is a separate promise). The unqualified claim ``a write that returned success survives a crash'' is true for a \emph {process} crash (I1a: the OS page cache persists past the dying daemon) but \emph {not guaranteed} for an OS crash or power loss (I1b), because under normal synchronization the WAL is synced only at checkpoints --- the seductive belief that ``normal sync is safe in WAL mode'' conflates crash-\emph {consistency} (true) with power-loss \emph {durability} (false). The remedy for I1b is full synchronization or a checkpoint on the commit path; the kernel does not pay that cost by default, and the prose must not imply it does. We split the invariant accordingly: I1a is \textsf {implemented}; I1b is \textsf {not guaranteed} under the default WAL configuration}{figure.caption.7}{}}
