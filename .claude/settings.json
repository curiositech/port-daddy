{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git config --get:*)",
      "Bash(git check-ignore:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(pd:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "mcp__github__pull_request_read",
      "mcp__github__actions_list"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pd attention --json 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/erichowens/.port-daddy/hooks/sessionstart-pilot.mjs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx scripts/sync-skills.ts --scope user --quiet >/dev/null 2>&1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "PD_HOOK_PROVIDER=claude PD_HOOK_DEADLINE_MS=1000 '/Users/erichowens/.port-daddy/bin/pd-hook-prompt' --interactive-context-pressure",
            "timeout": 1
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "PD_HOOK_PROVIDER=claude PD_HOOK_DEADLINE_MS=1000 '/Users/erichowens/.port-daddy/bin/pd-hook-pre-tool'",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PD_HOOK_PROVIDER=claude PD_HOOK_DEADLINE_MS=1000 '/Users/erichowens/.port-daddy/bin/pd-hook-stop'",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PD_HOOK_PROVIDER=claude PD_HOOK_DEADLINE_MS=1000 '/Users/erichowens/.port-daddy/bin/pd-hook-precompact'",
            "timeout": 1
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/erichowens/.port-daddy/bin/pd-statusline",
    "padding": 0
  }
}
