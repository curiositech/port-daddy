(*
 * Port Daddy: Escrow Secrecy Model (v4)
 *
 * Proves that session notes encrypted with envelope encryption
 * remain confidential even when the attacker observes the database.
 *
 * Threat: Dolev-Yao adversary who can read the SQLite database file
 * (wrapped session keys + encrypted note ciphertext) but does NOT
 * hold the daemon's master key.
 *
 * Properties verified:
 *   1. Note content secrecy (attacker cannot learn plaintext)
 *   2. Session key secrecy (attacker cannot derive session key)
 *   3. Authentication: notes read back match notes written
 *)

type id.
type skey.       (* Ed25519 signing key *)
type pkey.       (* Ed25519 public key *)
type symkey.     (* AES-256-GCM symmetric key *)

free c: channel.                     (* Public channel — database at rest *)
free daemon_channel: channel [private].  (* Daemon-internal — trusted *)

(*** Symmetric Encryption (AES-256-GCM) ***)
fun senc(bitstring, symkey): bitstring.
reduc forall m: bitstring, k: symkey; sdec(senc(m, k), k) = m.

(*** Key Wrapping (master key encrypts session key) ***)
fun wrap(symkey, symkey): bitstring.
reduc forall sk: symkey, mk: symkey; unwrap(wrap(sk, mk), mk) = sk.

(*** Digital Signatures (for Harbor Cards) ***)
fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(m, pk(k), sign(m, k)) = true.

(*** Encoding ***)
fun session_record(id, bitstring): bitstring [data].

(*** Events ***)
event NoteWritten(id, id, bitstring).
event NoteRead(id, id, bitstring).

(*** Secrets — the attacker must NOT learn these ***)
free master_key: symkey [private].
free note_content: bitstring [private].

(*** Queries ***)

(* Q1: Attacker cannot learn the note content *)
query attacker(note_content).

(* Q2: Authentication — if a note is read, it was written *)
query agent: id, session: id, content: bitstring;
  event(NoteRead(agent, session, content)) ==>
  event(NoteWritten(agent, session, content)).

(*** Processes ***)

(* The Daemon: creates session, encrypts notes, serves reads *)
let DaemonWrite(agent_id: id, session_id: id) =
  (* Step 1: Generate session key *)
  new session_key: symkey;

  (* Step 2: Wrap session key with master key *)
  let wrapped_key = wrap(session_key, master_key) in

  (* Step 3: Store wrapped key in database (attacker can see) *)
  out(c, session_record(session_id, wrapped_key));

  (* Step 4: Encrypt note content with session key *)
  let encrypted_note = senc(note_content, session_key) in
  event NoteWritten(agent_id, session_id, note_content);

  (* Step 5: Store encrypted note in database (attacker can see) *)
  out(c, encrypted_note).

(* Authorized read: daemon decrypts for an agent with valid Harbor Card *)
let DaemonRead(agent_id: id, session_id: id, harbor_sk: skey) =
  (* Agent presents Harbor Card (signed by daemon) *)
  in(c, (card_msg: bitstring, card_sig: bitstring));

  (* Verify the Harbor Card signature *)
  if checksign(card_msg, pk(harbor_sk), card_sig) = true then
    (* Daemon retrieves wrapped key from database *)
    in(c, record: bitstring);
    let session_record(=session_id, wrapped_key: bitstring) = record in

    (* Daemon unwraps session key using master key *)
    let session_key = unwrap(wrapped_key, master_key) in

    (* Daemon retrieves encrypted note from database *)
    in(c, encrypted_note: bitstring);

    (* Daemon decrypts note *)
    let plaintext = sdec(encrypted_note, session_key) in
    event NoteRead(agent_id, session_id, plaintext);

    (* Return plaintext to agent on private channel *)
    out(daemon_channel, plaintext).

(*** Main Process ***)
process
  new harbor_sk: skey;
  new agent_a: id;
  new session_1: id;
  (
    (* Daemon writes encrypted notes *)
    (!DaemonWrite(agent_a, session_1)) |

    (* Authorized agent reads through daemon *)
    (!DaemonRead(agent_a, session_1, harbor_sk)) |

    (* Attacker observes everything on the public channel *)
    (* (This is implicit in ProVerif — the attacker controls c) *)

    (* Harbor Card issuance: daemon signs a card for agent_a *)
    let card_msg = (agent_a, session_1) in
    let card_sig = sign(card_msg, harbor_sk) in
    out(c, (card_msg, card_sig))
  )
