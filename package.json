{
  "name": "port-daddy",
  "version": "3.8.1",
  "description": "Authoritative port management and service orchestration for multi-agent development — port-daddy up/down, atomic assignment, pub/sub messaging, distributed locks, agent registry, and project:stack:context semantic identities",
  "main": "./dist/server.js",
  "type": "module",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/lib/client.d.ts",
      "default": "./dist/lib/client.js"
    }
  },
  "bin": {
    "port-daddy": "./bin/port-daddy-cli.js",
    "pd": "./bin/port-daddy-cli.js"
  },
  "scripts": {
    "start": "tsx server.ts",
    "daemon:start": "tsx server.ts",
    "daemon:watch": "tsx bin/watchdog.ts",
    "dev": "tsx bin/port-daddy-cli.ts dev",
    "install-daemon": "tsx install-daemon.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "test:ci": "npm test",
    "typecheck": "tsc --noEmit",
    "parity": "tsx scripts/check-parity.ts",
    "preversion": "npm run parity && npm test -- --no-coverage",
    "postversion": "tsx scripts/sync-version.ts && git add .claude-plugin/plugin.json mcp-server.json mcp/server.ts && git commit --amend --no-edit",
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curiositech/port-daddy.git"
  },
  "author": "Curiositech LLC <hello@curiositech.ai> (https://curiositech.ai)",
  "license": "FSL-1.1-MIT",
  "bugs": {
    "url": "https://github.com/curiositech/port-daddy/issues"
  },
  "homepage": "https://github.com/curiositech/port-daddy#readme",
  "keywords": [
    "port",
    "port-management",
    "port-finder",
    "port-conflict",
    "devtools",
    "development",
    "dev-server",
    "multi-agent",
    "pubsub",
    "distributed-locks",
    "agent-coordination",
    "service-orchestration",
    "monorepo",
    "framework-detection",
    "daemon",
    "ai-development",
    "claude"
  ],
  "files": [
    "dist/",
    "server.ts",
    "install-daemon.ts",
    "bin/",
    "lib/",
    "routes/",
    "shared/",
    "public/",
    "mcp/",
    "config.json",
    "completions/",
    "skills/",
    ".claude-plugin/",
    "LICENSE",
    "README.md",
    "tsconfig.json"
  ],
  "dependencies": {
    "@clack/core": "^1.1.0",
    "@clack/prompts": "^1.1.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@types/commander": "^2.12.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "fastify": "^5.8.4",
    "ink": "^6.8.0",
    "jose": "^5.10.0",
    "koffi": "^2.15.2",
    "msgpackr": "^1.11.9",
    "react": "^19.2.4",
    "tsx": "^4.21.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.11",
    "@swc/jest": "^0.2.39",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "jest": "^30.2.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  }
}
