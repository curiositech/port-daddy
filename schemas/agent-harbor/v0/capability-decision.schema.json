{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portdaddy.dev/schemas/agent-harbor/v0/capability-decision.schema.json",
  "title": "CapabilityDecision",
  "description": "A daemon- or policy-witnessed capability gate result for a surface action. This records whether a command/query/event is allowed, denied, degraded, unsupported, or requires approval; it is evidence for surfaces, not a launch path.",
  "type": "object",
  "properties": {
    "schema": { "const": "pd.agent-harbor.capability-decision.v0" },
    "decisionId": { "type": "string", "minLength": 1 },
    "agentNodeId": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "bodyId": { "type": ["string", "null"] },
    "surface": { "enum": ["pd-console", "fleetbar", "scout", "cli", "mcp", "daemon", "operator"] },
    "operation": { "type": "string", "minLength": 1 },
    "capability": { "enum": ["work-intent", "work-plan", "agent-node", "agent-run", "body", "control-command", "transcript-event", "capability-decision", "work-receipt", "berth-target", "surface-gateway"] },
    "decision": { "enum": ["allow", "deny", "degrade", "unsupported", "requires-approval"] },
    "authority": {
      "type": "object",
      "description": "The authority domain that made the decision. Presentation surfaces must not claim to be the domain authority.",
      "properties": {
        "domain": { "enum": ["daemon-registry", "operator-selection", "policy", "lease", "read-only-import"] },
        "decidedBy": { "type": "string", "minLength": 1 },
        "leaseId": { "type": ["string", "null"] }
      },
      "required": ["domain", "decidedBy"]
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "properties": {
        "probeId": { "type": ["string", "null"] },
        "controlCommandId": { "type": ["string", "null"] },
        "berthTargetId": { "type": ["string", "null"] },
        "transcriptEventId": { "type": ["string", "null"] }
      }
    },
    "issuedAt": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": ["string", "null"] }
  },
  "required": ["schema", "decisionId", "surface", "operation", "capability", "decision", "authority", "reason", "issuedAt"],
  "additionalProperties": true
}
