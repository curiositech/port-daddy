{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portdaddy.dev/schemas/agent-harbor/v0/porthole-perspective.schema.json",
  "title": "PortholePerspective",
  "description": "The immutable opening manifest for one first-person evidence stream. Actor identity is separate from the observed surface: either a person (including the operator) or an AgentNode-backed agent may own the perspective. The manifest commits to the capture schedule before capture begins, seals raw target descriptors, and makes the perspective/channel pair one atomic retention unit. It never claims hidden chain-of-thought.",
  "type": "object",
  "properties": {
    "schema": { "const": "pd.porthole.perspective.v1" },
    "perspectiveId": { "type": "string", "minLength": 1 },
    "stageId": { "type": "string", "minLength": 1 },
    "streamId": { "type": "string", "minLength": 1 },
    "harborId": { "type": "string", "minLength": 1 },
    "participantId": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["person", "agent"] },
        "role": { "enum": ["operator", "collaborator", "observer"] },
        "personId": { "type": ["string", "null"], "minLength": 1 }
      },
      "required": ["kind", "role", "personId"],
      "additionalProperties": false
    },
    "agentNodeId": { "type": ["string", "null"], "minLength": 1 },
    "bodyId": {
      "type": "string",
      "minLength": 1,
      "description": "Concrete runtime embodiment producing or witnessing this stream. A person viewing through pd-console still has a viewer Body; embodied perspectives never use a null bodyId."
    },
    "sessionId": { "type": "string", "minLength": 1 },
    "runId": { "type": ["string", "null"], "minLength": 1 },
    "surface": {
      "type": "object",
      "description": "Only opaque routing identity and a sealed descriptor commitment are public. Window titles, application names, URLs, document names, and other raw target descriptors belong inside the encrypted stream.",
      "properties": {
        "surfaceId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["terminal", "browser", "native-app", "cooperative-editor", "mobile", "cloud-workspace", "custom"]
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "state": { "const": "sealed" },
            "envelopeRef": { "type": "string", "minLength": 1 },
            "commitment": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "description": "Hash of the randomized authenticated ciphertext envelope, never of the low-entropy raw descriptor."
            }
          },
          "required": ["state", "envelopeRef", "commitment"],
          "additionalProperties": false
        }
      },
      "required": ["surfaceId", "kind", "descriptor"],
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "adapterVersion": { "type": ["string", "null"], "minLength": 1 },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["visual", "terminal", "dom", "accessibility", "editor-ops", "input", "audio", "control"] }
        },
        "sourceClock": { "enum": ["monotonic", "wall", "provider", "mixed"] },
        "visibleIndicator": { "const": true, "description": "A recorded body must show an operator-visible recording indicator." }
      },
      "required": ["adapter", "adapterVersion", "modalities", "sourceClock", "visibleIndicator"],
      "additionalProperties": false
    },
    "captureSchedule": {
      "type": "object",
      "description": "A schedule commitment created no later than startedAt. Fixed-interval schedules commit to an interval; event-driven schedules commit to the named event boundary. A consumer must also verify the commitment hash and timestamp ordering.",
      "properties": {
        "scheduleId": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["fixed-interval", "event-driven"] },
        "samplingIntervalMs": { "type": ["number", "null"], "minimum": 1 },
        "boundary": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["fixed-duration", "event-delimited", "operator-stop"] },
            "durationMs": { "type": ["number", "null"], "minimum": 1 },
            "terminalEventKind": { "type": ["string", "null"], "minLength": 1 }
          },
          "required": ["kind", "durationMs", "terminalEventKind"],
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "fixed-duration" } }, "required": ["kind"] },
              "then": {
                "properties": {
                  "durationMs": { "type": "number", "minimum": 1 },
                  "terminalEventKind": { "const": null }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "event-delimited" } }, "required": ["kind"] },
              "then": {
                "properties": {
                  "durationMs": { "const": null },
                  "terminalEventKind": { "type": "string", "minLength": 1 }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "operator-stop" } }, "required": ["kind"] },
              "then": {
                "properties": {
                  "durationMs": { "const": null },
                  "terminalEventKind": { "const": null }
                }
              }
            }
          ]
        },
        "committedAt": { "type": "string", "format": "date-time" },
        "commitmentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "required": ["scheduleId", "mode", "samplingIntervalMs", "boundary", "committedAt", "commitmentHash"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed-interval" } }, "required": ["mode"] },
          "then": { "properties": { "samplingIntervalMs": { "type": "number", "minimum": 1 } } }
        },
        {
          "if": { "properties": { "mode": { "const": "event-driven" } }, "required": ["mode"] },
          "then": { "properties": { "samplingIntervalMs": { "const": null } } }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "properties": {
        "scope": { "const": "device-only" },
        "redaction": { "enum": ["adapter", "daemon", "quarantined"] },
        "semanticPayload": { "enum": ["encrypted", "scrubbed", "omitted"] },
        "hiddenReasoningCaptured": { "const": false }
      },
      "required": ["scope", "redaction", "semanticPayload", "hiddenReasoningCaptured"],
      "additionalProperties": false
    },
    "encryption": {
      "type": "object",
      "properties": {
        "suite": { "const": "pd-vault-xchacha20-poly1305-v1" },
        "channelId": { "type": "string", "minLength": 1 },
        "epoch": { "type": "number", "minimum": 0 },
        "keyCustody": { "enum": ["os-keychain", "in-memory-test"] }
      },
      "required": ["suite", "channelId", "epoch", "keyCustody"],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "description": "The unitId must equal perspectiveId and channelId must equal encryption.channelId. Consumers delete or hold the pair as one unit; segments cannot silently receive independent retention policy.",
      "properties": {
        "unitType": { "const": "perspective-channel" },
        "unitId": { "type": "string", "minLength": 1 },
        "channelId": { "type": "string", "minLength": 1 },
        "policyId": { "type": "string", "minLength": 1 },
        "deleteAsUnit": { "const": true }
      },
      "required": ["unitType", "unitId", "channelId", "policyId", "deleteAsUnit"],
      "additionalProperties": false
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "parentPerspectiveId": { "type": ["string", "null"], "minLength": 1 }
  },
  "required": [
    "schema", "perspectiveId", "stageId", "streamId", "harborId", "participantId",
    "actor", "agentNodeId", "bodyId", "sessionId", "runId", "surface", "capture",
    "captureSchedule", "privacy", "encryption", "retention", "startedAt", "parentPerspectiveId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "actor": { "properties": { "kind": { "const": "agent" } }, "required": ["kind"] } },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "agentNodeId": { "type": "string", "minLength": 1 },
          "actor": { "properties": { "personId": { "const": null } } }
        }
      }
    },
    {
      "if": {
        "properties": { "actor": { "properties": { "kind": { "const": "person" } }, "required": ["kind"] } },
        "required": ["actor"]
      },
      "then": {
        "properties": {
          "agentNodeId": { "const": null },
          "actor": { "properties": { "personId": { "type": "string", "minLength": 1 } } }
        }
      }
    }
  ]
}
