{
  "$schema": "./schema/semantic.schema.json",
  "$description": "Tier 2 — semantic. Intent layer. References primitives by id. Per-theme mapping lives in themes/{dark,light}.json — this file declares only the semantic IDs that themes must satisfy.",

  "$contract": [
    "Every semantic id here MUST be defined in BOTH themes/dark.json AND themes/light.json.",
    "Build script fails if a theme is missing any required id.",
    "If a value is truly theme-invariant (ICS flag colors, brand canary), name it here and both themes will reference the same primitive."
  ],

  "ids": {
    "bg-page":              "page background, the canvas",
    "bg-surface":           "raised surface, card/panel background",
    "bg-elevated":          "double-raised surface, popovers/modals",
    "bg-inverse":           "opposite-of-page (terminal interior in light mode = ebony; in dark mode = paper if a 'docs panel' is needed)",
    "bg-brand":             "canary brand bg — same primitive both themes",
    "bg-brand-soft":        "softer canary",
    "bg-danger":            "danger/alert surface (cinnabar)",
    "bg-success":           "kelp surface",
    "bg-warning":           "amber surface",

    "text-heading":         "headings, max contrast against page",
    "text-body":            "default body prose, ≥13.6:1 against page",
    "text-body-subtle":     "muted body, ≥9.8:1 against page",
    "text-on-brand":        "text rendered on bg-brand (canary). MUST be the high-contrast pair (ebony in light, ebony in dark — canary is theme-stable).",
    "text-on-danger":       "text on cinnabar",
    "text-on-inverse":      "text on bg-inverse (paper on ebony, ebony on paper)",
    "text-inverse-subtle":  "muted text on bg-inverse",
    "text-link":            "link color — usually text-heading + underline",

    "border-default":       "hard-line border, max contrast (ebony in light, paper in dark)",
    "border-muted":         "softer border",
    "border-emphasis":      "thicker accent border, brand color",

    "shadow-color":         "color of the offset shadow — ebony in light mode, ebony-deep in dark mode",

    "state-claim-active-bg":     "active claim bg",
    "state-claim-active-fg":     "active claim fg",
    "state-claim-active-border": "active claim border",
    "state-awaiting-human-bg":     "HITL block bg (must be hard to ignore)",
    "state-awaiting-human-fg":     "HITL block fg",
    "state-awaiting-human-border": "HITL block border",
    "state-burning-cash-bg":     "cost-cap proximity bg",
    "state-burning-cash-fg":     "cost-cap proximity fg",
    "state-burning-cash-border": "cost-cap proximity border",
    "state-conflict-bg":         "two-actors-want-same-surface bg",
    "state-conflict-fg":         "conflict fg",
    "state-conflict-border":     "conflict border",
    "state-blocked-bg":          "creds-missing bg",
    "state-blocked-fg":          "blocked fg",
    "state-blocked-border":      "blocked border",
    "state-claim-stale-bg":      "stale-heartbeat bg",
    "state-claim-stale-fg":      "stale fg",
    "state-claim-stale-border":  "stale border",
    "state-idle-bg":             "idle actor bg",
    "state-idle-fg":             "idle fg",
    "state-idle-border":         "idle border",

    "severity-securite-bg":  "low-urgency advisory band bg (warm tan)",
    "severity-securite-fg":  "advisory band fg",
    "severity-pan-pan-bg":   "urgent band bg (cinnabar)",
    "severity-pan-pan-fg":   "urgent band fg (white)",
    "severity-mayday-bg":    "distress band bg (deep crimson)",
    "severity-mayday-fg":    "distress band fg (white)",

    "perf-request-bg":         "REQUEST FIPA tag bg",
    "perf-inform-bg":          "INFORM tag bg",
    "perf-agree-bg":           "AGREE tag bg",
    "perf-refuse-bg":          "REFUSE tag bg",
    "perf-failure-bg":         "FAILURE tag bg",
    "perf-cfp-bg":             "CFP tag bg (brand)",
    "perf-propose-bg":         "PROPOSE tag bg",
    "perf-accept-proposal-bg": "ACCEPT-PROPOSAL tag bg",
    "perf-subscribe-bg":       "SUBSCRIBE tag bg",
    "perf-query-ref-bg":       "QUERY-REF tag bg",

    "term-prompt":           "terminal prompt prefix (⚓)",
    "term-cmd":              "terminal command text",
    "term-ok":               "success line",
    "term-warn":             "warn line",
    "term-err":              "error line",
    "term-dim":              "dim/secondary line",
    "term-info":             "info line",
    "term-bg":               "terminal interior bg",
    "term-fg":               "terminal default fg",

    "ics-flag-red":          "ICS flag red — theme-invariant",
    "ics-flag-blue":         "ICS flag blue — theme-invariant",
    "ics-flag-yellow":       "ICS flag yellow — theme-invariant",
    "ics-flag-white":        "ICS flag white — theme-invariant",
    "ics-flag-black":        "ICS flag black — theme-invariant"
  },

  "components": {
    "$description": "Tier 3 — component tokens reference semantic tokens. Each component owns the surface contract for its widget.",
    "chat-bubble-user-bg":     "perf-request-bg variant or bg-danger",
    "chat-bubble-user-fg":     "text-on-danger",
    "chat-bubble-agent-bg":    "bg-inverse",
    "chat-bubble-agent-fg":    "text-on-inverse",
    "chat-bubble-agent-border":"border-emphasis",
    "distress-band-fg":        "text-on-danger",
    "fleet-bar-bg":            "bg-inverse",
    "fleet-bar-fg":            "text-on-inverse",
    "state-card-border-width": "5px (component-specific override)",
    "hero-scoreboard-bg":      "bg-inverse",
    "hero-scoreboard-fg":      "bg-brand",
    "hero-scoreboard-shadow":  "fg-warning-deep"
  }
}
