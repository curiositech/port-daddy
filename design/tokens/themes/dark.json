{
  "$theme": "dark",
  "$description": "Dark theme — terminal-ebony page, paper text. The voice of running tools.",
  "$contrastVerified": "2026-05-15",
  "$contrastFormula": "WCAG 2.1 relative-luminance ratio. All text/bg pairs ≥4.5:1 normal, ≥3:1 large.",

  "map": {
    "bg-page":              "color.ebony",
    "bg-surface":           "color.ebony-soft",
    "bg-elevated":          "color.ebony-deep",
    "bg-inverse":           "color.paper",
    "bg-brand":             "color.canary",
    "bg-brand-soft":        "color.canary-warm",
    "bg-danger":            "color.cinnabar",
    "bg-success":           "color.kelp-deep",
    "bg-warning":           "color.warning",

    "text-heading":         "color.paper",
    "text-body":            "color.paper",
    "text-body-subtle":     "color.fog",
    "text-on-brand":        "color.ebony",
    "text-on-danger":       "color.paper-soft",
    "text-on-inverse":      "color.ebony",
    "text-inverse-subtle":  "color.slate-deep",
    "text-link":            "color.canary",

    "border-default":       "color.paper",
    "border-muted":         "color.slate",
    "border-emphasis":      "color.canary",

    "shadow-color":         "color.ebony-deep",

    "state-claim-active-bg":     "color.kelp-deep",
    "state-claim-active-fg":     "color.paper",
    "state-claim-active-border": "color.kelp",
    "state-awaiting-human-bg":     "color.warning",
    "state-awaiting-human-fg":     "color.ebony",
    "state-awaiting-human-border": "color.warning-deep",
    "state-burning-cash-bg":     "color.cinnabar-dim",
    "state-burning-cash-fg":     "color.paper",
    "state-burning-cash-border": "color.cinnabar",
    "state-conflict-bg":         "color.cinnabar",
    "state-conflict-fg":         "color.paper",
    "state-conflict-border":     "color.cinnabar-lit",
    "state-blocked-bg":          "color.ebony-soft",
    "state-blocked-fg":          "color.fog",
    "state-blocked-border":      "color.slate",
    "state-claim-stale-bg":      "color.ebony-soft",
    "state-claim-stale-fg":      "color.fog-deep",
    "state-claim-stale-border":  "color.slate",
    "state-idle-bg":             "color.ebony-deep",
    "state-idle-fg":             "color.fog-deep",
    "state-idle-border":         "color.slate",

    "severity-securite-bg":  "color.tan",
    "severity-securite-fg":  "color.canary-warm",
    "severity-pan-pan-bg":   "color.cinnabar",
    "severity-pan-pan-fg":   "color.paper-soft",
    "severity-mayday-bg":    "color.cinnabar-dim",
    "severity-mayday-fg":    "color.paper-soft",

    "perf-request-bg":         "color.sky-deep",
    "perf-inform-bg":          "color.kelp-soft",
    "perf-agree-bg":           "color.kelp-deep",
    "perf-refuse-bg":          "color.cinnabar-dim",
    "perf-failure-bg":         "color.cinnabar-dim",
    "perf-cfp-bg":             "color.canary",
    "perf-propose-bg":         "color.purple",
    "perf-accept-proposal-bg": "color.indigo",
    "perf-subscribe-bg":       "color.teal",
    "perf-query-ref-bg":       "color.sky",

    "term-prompt":           "color.canary",
    "term-cmd":              "color.paper",
    "term-ok":               "color.kelp",
    "term-warn":             "color.warning",
    "term-err":              "color.cinnabar-lit",
    "term-dim":              "color.fog",
    "term-info":             "color.sky",
    "term-bg":               "color.ebony",
    "term-fg":               "color.paper",

    "ics-flag-red":          "color.cinnabar",
    "ics-flag-blue":         "color.navy",
    "ics-flag-yellow":       "color.mustard",
    "ics-flag-white":        "color.ics-white",
    "ics-flag-black":        "color.ics-black"
  }
}
