        "treatment": "Separate conditional payoff comparison from migration safeguard evidence.",
        "claimCorrections": [
          "Attestation does not itself enforce price pass-through.",
          "The supplied universal lemons spiral is not established.",
          "Zero bounded-model violations is not general software correctness."
        ]
      },
      {
        "id": "rule-closure-and-complexity",
        "figureLabels": [
          "fig:he-conflict-witness",
          "fig:he-deontic-frontier"
        ],
        "treatment": "Show the exact inferred conflict before a qualified feasibility frontier.",
        "claimCorrections": [
          "Use fixture intervals and the manuscript indexed bound.",
          "NP-completeness concerns growing families of clause obligations, not one binary choice.",
          "Finding a satisfying assignment and verifying one are different tasks."
        ]
      },
      {
        "id": "custody-and-recovery",
        "figureLabels": [
          "fig:he-two-bucket-settlement",
          "fig:bonded-session-lifecycle"
