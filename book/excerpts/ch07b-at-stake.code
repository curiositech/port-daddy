/// The guard on a change: the bond behind the grant is held.
/// Chapter 1's fence lets a holder that has released go on
/// writing until someone else claims, because that write can
/// hurt no claim. On a harbor that asks a bond it would be work
/// with nothing behind it.
pub fn at_stake(
    grant: &Grant,
    stake: Option<&Stake>,
    price: u64,
) -> Result<(), Reason> {
    if cfg!(feature = "mutant-write-unstaked") {
        return Ok(()); // MUTANT: guard removed.
    }
    let token = grant.token;
    match own(stake, token).filter(held) {
        None if price > 0 => {
            Err(Reason::NothingAtStake { token })
        }
        _ => Ok(()),
    }
}
