/// Put a bond behind a grant that claims.rs has just given. A
/// renewal keeps its token, and so keeps its bond. Any other
/// grant is new, and posts a bond of its own.
pub fn back(
    grant: Grant,
    behind: Option<&Stake>,
    bonds: &Bonds,
    price: u64,
) -> Result<Staked, Reason> {
    let kept = own(behind, grant.token).filter(held);
    let moved = match kept {
        Some(stake) => Moved {
            funds: bonds.funds,
            bond: Some(stake.bond),
        },
        None => bonds::post(bonds, price)?,
    };
    Ok(Staked { grant, moved })
}

/// The guard: the stake shown is the one behind this grant.
fn own(stake: Option<&Stake>, token: u64) -> Option<&Stake> {
    if cfg!(feature = "mutant-borrowed-stake") {
        return stake; // MUTANT: guard removed.
    }
    stake.filter(|stake| stake.token == token)
}
