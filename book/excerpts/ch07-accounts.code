/** Put one move to the core, and keep what it answers. */
#move(asked: FundsProposal, id = 0): Outcome {
  // The bond the move names, if there is one with that id.
  const bond = this.#bonds[id - 1];
  const nextId = this.#bonds.length + 1;
  const bonds = { funds: this.#funds, bond, nextId };
  const answer = this.#core.decide(asked, { bonds }, POLICY, 0);
  if (answer.verdict === 'refuse') {
    return refused(answer.reason);
  }
  const { funds, bond: changed } = answer.moved;
  this.#funds = funds;
  if (changed !== null) this.#bonds[changed.id - 1] = changed;
  return { ok: true, bond: changed };
}

post(amount: number): Outcome {
  return this.#move({ op: 'post', amount });
}

slash(id: number, forfeit: number): Outcome {
  return this.#move({ op: 'slash', id, forfeit }, id);
}
