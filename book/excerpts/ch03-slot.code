/// One slot of a work order: what is released, and when.
#[derive(Clone, Copy, Debug, Default, Deserialize)]
pub struct Slot {
    /// How many of the record's low bits are released. One bit
    /// is the record's parity.
    pub bits: u8,
    /// The time they are released.
    pub deadline: u64,
}

/// What the core is shown of a sealed room.
#[derive(Clone, Debug, Default, Deserialize)]
#[serde(default)]
pub struct Room {
    pub slot: Slot,
    /// The record, once its owner has committed it.
    pub committed: Option<u64>,
    /// The value the worker last submitted.
    pub candidate: Option<u64>,
    /// Whether the slot has been used.
    pub used: bool,
}
