/** The worker's words, and a claim for each thing it attached.
 * A link that leads to nothing stored is refused. */
line(): Shown | Reply {
  const { agent, job, said, links, store } = this.at;
  const stored = links.every((link) => link in store);
  if (links.length === 0 || !stored) {
    return no('no-link', 'nothing is attached');
  }
  const claims = links.map((sha) => ({ says: PASSED, sha }));
  const see = links.map((sha) => `see ${short(sha)}`).join(' | ');
  return { text: `${agent} | ${job} | ${said} | ${see}`, claims };
}

/** Landing waits until each claim's number has been opened. */
land(): Reply {
  const line = this.line();
  if ('ok' in line) return line;
  const { links, ticked } = this.at;
  const seen = links.every((_, claim) => ticked.includes(claim));
  if (!seen) return no('not-opened', 'a claim is unopened');
  this.at = { ...this.at, landed: this.at.revision };
  return { ok: true };
}
