/// Open a plan: debit the bounty from the requester and the
/// bond from the provider, both or neither.
pub fn reserve(
    plans: &Plans,
    bounty: u64,
    bond: u64,
) -> Result<PlansUpdate, Reason> {
    has_bond(bond)?;
    let (requester, provider) = if same_wallet(plans) {
        // One wallet must cover the sum of the two amounts.
        let asked = bounty.saturating_add(bond);
        let left = covered(plans.requester, asked)?;
        (left, left)
    } else {
        (
            covered(plans.requester, bounty)?,
            covered(plans.provider, bond)?,
        )
    };
    let (id, stage) = (plans.next_id, Stage::Open);
    let plan = Plan {
        id,
        bounty,
        bond,
        stage,
    };
    Ok(PlansUpdate {
        requester,
        provider,
        commons: plans.commons,
        plan: Some(plan),
    })
}

/// The guard: one wallet that pays both sides is checked once.
fn same_wallet(plans: &Plans) -> bool {
    if cfg!(feature = "mutant-reserve-separately") {
        return false; // MUTANT: guard removed.
    }
    plans.shared
}
