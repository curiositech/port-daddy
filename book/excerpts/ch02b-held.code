/// Check that whoever showed an admitted chain holds the key its
/// last card names.
pub fn held(
    pass: Pass,
    ask: Option<&Right>,
    proof: Option<&Proof>,
    gate: &Gate,
    policy: &Policy,
    now: u64,
) -> Result<Pass, Reason> {
    if policy.holders == Holders::Bearer {
        return Ok(pass);
    }
    let Some(proof) = proof else {
        return unproved(pass);
    };
    // The challenge must be one this gate handed out and has not
    // had back, and its time must not have passed.
    let open = open(gate, &proof.nonce)
        .ok_or(Reason::UnknownChallenge)?;
    if stale(now, open.until) {
        let until = open.until;
        return Err(Reason::StaleChallenge { until });
    }
    // The gate works out what the proof must be a signature
    // over. It takes nobody's word for the ask or the card.
    let card = pass.cards.last().map_or("", String::as_str);
    let text = text(&open.nonce, ask, card);
    if !signed(&pass.key, &text, &proof.tag) {
        return Err(Reason::NotProved);
    }
    // Admitting the chain uses the challenge up.
    let answered = Some(open.nonce);
    Ok(Pass { answered, ..pass })
}
