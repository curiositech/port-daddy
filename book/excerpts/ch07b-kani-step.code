/// The property. A grant that has not been released has its own
/// stake, and the stake's bond is held.
fn bonded(path: &Path) -> bool {
    let Some(grant) = path.latest.as_ref() else {
        return true;
    };
    let held = |stake: &Stake| {
        stake.token == grant.token
            && stake.bond.status == Status::Held
    };
    grant.released || path.stake.as_ref().is_some_and(held)
}

/// The step of the induction. From a path whose claim has its
/// bond, any admitted operation leaves a path whose claim has
/// its bond, and the same total of units.
#[kani::proof]
fn every_operation_keeps_a_claim_bonded() {
    let (before, bonds) = (any_path(), any_bonds());
    let price: u64 = kani::any();
    kani::assume(bonded(&before) && price > 0);
    match kani::any::<u8>() % 3 {
        0 => a_claim(&before, &bonds, price),
        1 => a_release(&before, &bonds),
        _ => a_direct_refund(&before),
    }
}
