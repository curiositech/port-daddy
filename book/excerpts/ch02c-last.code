/** Refuse a chain whose last card was revoked. */
admit(
  chain: readonly string[],
  requested: Right | undefined,
  now: number,
  proof?: Proof,
): Verdict {
  const last = chain.at(-1) ?? '';
  if (this.#revoked.has(idIfCard(last))) {
    const detail = `card ${chain.length} was revoked`;
    return refused('revoked', detail);
  }
  return this.#inner.admit(chain, requested, now, proof);
}

/** Revoke the last card of a chain. */
revoke(chain: readonly string[]): RevokeResult {
  const last = chain.at(-1) ?? '';
  this.#revoked.add(idIfCard(last));
  return { ok: true, until: read(last).exp };
}
