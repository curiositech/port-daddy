#[kani::proof]
#[kani::stub(share, any_share)]
fn a_settlement_pays_out_what_was_reserved() {
    let before = any_plans();
    let (id, done, of) = (kani::any(), kani::any(), kani::any());
    let Ok(paid) = settle(&before, id, done, of) else {
        return; // No such plan, or an invalid count.
    };
    let plan = before.plan.unwrap();
    assert!(plan.stage == Stage::Open);
    let forfeit = paid.commons - before.commons;
    let back = paid.requester - before.requester;
    let returned = plan.bond - forfeit;
    kani::cover!(forfeit > 0 && returned > 0);
    kani::cover!(before.shared);
    if before.shared {
        // One wallet gets the bounty and the bond returned.
        assert!(paid.provider == paid.requester);
        assert!(back == plan.bounty + returned);
    } else {
        let gain = paid.provider - before.provider;
        assert!(gain == (plan.bounty - back) + returned);
    }
    assert!(paid.plan.unwrap().stage == Stage::Settled);
}

/// The stub for `share`: any number no greater than the
/// amount, when the count is valid.
fn any_share(amount: u64, count: u64, of: u64) -> u64 {
    let part: u64 = kani::any();
    kani::assume(count > of || part <= amount);
    part
}
