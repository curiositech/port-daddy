/** Check one showing in two steps: look its challenge up, then
 * check the proof and strike the challenge out. */
*admitting(shown: Showing, now: number): Checking {
  if (!shown.proof) return refused('no-proof', NO_PROOF);
  const { nonce } = shown.proof;
  if (!this.#open.has(nonce)) {
    return refused('unknown-challenge', NOT_OPEN);
  }
  yield; // a signature is slow to check: other requests run now
  const verdict = signedAsk(shown, this.#cards, now, nonce);
  if (verdict.ok) this.#open.delete(nonce);
  return verdict;
}
