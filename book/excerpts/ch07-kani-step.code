/// The step of the induction. From funds with a valid total,
/// an admitted operation leaves the same total plus the units
/// it created. The pool never decreases.
#[kani::proof]
fn every_operation_conserves_units() {
    let before = any_bonds();
    let (operation, created) = any_operation();
    let Some(after) = apply(operation, &before) else {
        return; // A refusal changes nothing.
    };
    kani::cover!(created > 0);
    kani::cover!(after.funds.pool > before.funds.pool);
    let had = supply(&before.funds).unwrap();
    assert!(supply(&after.funds) == Some(had + created));
    assert!(after.funds.pool >= before.funds.pool);
    // A bond returned as held has its units in escrow.
    if let Some(bond) = after.bond {
        let held = bond.status == Status::Held;
        assert!(!held || bond.amount <= after.funds.escrow);
    }
}
