/// Work lands only if it is verified and every claim of its
/// line is among the hashes that were opened.
#[kani::proof]
#[kani::unwind(4)]
fn work_lands_only_verified_and_read() {
    let work = any_work();
    let Ok(read) = land(&work) else { return };
    kani::cover!(read.landed);
    assert!(read.landed && read.line.verified);
    for claim in &read.line.claims {
        assert!(work.opened.contains(&claim.sha));
    }
}
