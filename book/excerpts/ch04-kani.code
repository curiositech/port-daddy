/// Work lands only if it is verified and every claim on its
/// line is among the hashes that were opened.
#[kani::proof]
#[kani::unwind(4)]
fn work_lands_only_if_verified_and_opened() {
    let work = any_work();
    let Ok(review) = land(&work) else { return };
    kani::cover!(review.landed);
    assert!(review.landed && review.line.verified);
    for claim in &review.line.claims {
        assert!(work.opened.contains(&claim.sha));
    }
}
