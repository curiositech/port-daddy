/**
 * Ask to write `value`. `read`, if given, is the version it was
 * computed from. Returns whether the write was applied.
 */
put(me: string, value: number, read?: number): boolean {
  const asked = { op: 'put', agent: me, value, read } as const;
  const state = { cell: this.#cell };
  const answer = this.#core.decide(asked, state, this.#policy, 0);
  if (answer.verdict === 'admit') this.#cell = answer.cell;
  this.#heard?.(me, told(asked, answer));
  return answer.verdict === 'admit';
}
