/// Split an amount in the proportion `done` to `of`. The first
/// part is rounded down. The second is the remainder, so the
/// two add up to the amount.
fn split(
    amount: u64,
    done: u64,
    of: u64,
) -> Result<(u64, u64), Reason> {
    valid_count(done, of)?;
    let part = share(amount, done, of);
    if cfg!(feature = "mutant-split-separately") {
        // MUTANT: the second part is rounded separately.
        return Ok((part, share(amount, of - done, of)));
    }
    Ok((part, amount - part))
}

/// The proportion `count` to `of` of an amount, rounded down.
fn share(amount: u64, count: u64, of: u64) -> u64 {
    amount * count / of
}
