/// Guard: every claim on the line must have been opened.
/// Returns the first claim that has not been.
fn first_unopened(review: &Review) -> Option<usize> {
    if cfg!(feature = "mutant-land-unopened") {
        return None; // MUTANT: guard removed.
    }
    let mut claims = review.line.claims.iter().enumerate();
    claims.position(|(n, claim)| !opened(review, n, &claim.sha))
}

/// Guard: a claim counts as opened only by its own hash.
fn opened(review: &Review, number: usize, sha: &Sha) -> bool {
    if cfg!(feature = "mutant-count-opened") {
        // MUTANT: count how many were opened, not which.
        return review.opened.len() > number;
    }
    review.opened.contains(sha)
}
