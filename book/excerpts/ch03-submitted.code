/** Release the declared bits of the value the worker submits. */
submit(candidate: number): Reply {
  if (this.used) return no('used', 'the slot has been used');
  this.candidate = candidate;
  this.used = true;
  const value = low(this.slot.bits, candidate);
  this.seen.push({ at: this.now, value });
  return { ok: true };
}
