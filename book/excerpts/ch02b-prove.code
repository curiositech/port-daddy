/** The text a proof is a signature over. */
export function proofText(
  nonce: string,
  requested: Right | undefined,
  card: string,
): string {
  const right = requested ? rightText(requested) : '';
  return JSON.stringify(['proof', nonce, right, card]);
}

/** Answer a gate's challenge: sign it, with the requested right
 * and the id of the last card. */
export function prove(
  keys: Keys,
  chain: readonly string[],
  requested: Right | undefined,
  nonce: string,
): Proof {
  const last = chain.at(-1);
  const card = last ? idOf(last) : '';
  const text = proofText(nonce, requested, card);
  const tag = sign(null, Buffer.from(text), keys.secret);
  return { nonce, tag: tag.toString('base64url') };
}
