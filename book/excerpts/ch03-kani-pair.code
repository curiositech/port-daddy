/// Two rooms the recipient cannot distinguish so far. They
/// have the same slot, used in both or in neither, and records
/// with the same declared bits. Each worker's candidate is any.
fn two_rooms() -> (Room, Room) {
    let slot = any_slot();
    let (a, b) = (any_room(slot), any_room(slot));
    kani::assume(a.used == b.used);
    let same =
        part(&slot, a.committed) == part(&slot, b.committed);
    kani::assume(same);
    (a, b)
}

/// One step. A tick releases the same value from both rooms
/// at the same time, and leaves both slots in the same state.
#[kani::proof]
fn two_rooms_with_the_same_declared_bits_release_the_same() {
    let (a, b) = two_rooms();
    let now: u64 = kani::any();
    let (after_a, after_b) = (tick(&a, now), tick(&b, now));
    kani::cover!(
        after_a.out.is_some() && a.committed != b.committed
    );
    kani::cover!(a.candidate != b.candidate);
    assert!(after_a.out == after_b.out);
    assert!(after_a.used == after_b.used);
}
