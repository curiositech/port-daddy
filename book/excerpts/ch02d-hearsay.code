/** The news: the record, entry by entry. */
news(): readonly Entry[] {
  return [...this.#entries.values()];
}

/** Hear another gate's news, and write it down. */
hear(news: unknown, now: number): number {
  let fresh = 0;
  for (const entry of entriesIn(news)) {
    if (this.#entries.has(entry.id)) continue;
    this.#entries.set(entry.id, entry);
    this.enter(entry, now);
    fresh += 1;
  }
  return fresh;
}
