/** One round. Every gate picks one of the others, and the two
 * exchange notices as their lists were when the round began. */
export function round(
  gates: readonly Gossiper[],
  random: Random,
  now: number,
  lost: Lost = () => false,
): void {
  const notices = gates.map((gate) => gate.notices());
  gates.forEach((gate, at) => {
    const pick = Math.floor(random() * (gates.length - 1));
    const peer = pick < at ? pick : pick + 1;
    if (lost(at, peer)) return;
    gate.receive(notices[peer], now);
    gates[peer]?.receive(notices[at], now);
  });
}
