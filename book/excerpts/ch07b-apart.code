/** Claim a path: ask for the claim, then post its bond. */
claim(agent: string, path: string): Answer {
  const ttlMs = LEASE;
  const given = this.#ask({ op: 'claim', path, agent, ttlMs });
  if ('ok' in given) return given;
  const { grant } = given;
  // A renewal has its bond already.
  const id = this.#behind.get(path)?.[grant.token - 1] ?? 0;
  const had = this.#funds.bonds[id - 1];
  if (had?.standing === 'held') {
    this.#keep(path, grant, id);
    return { ok: true, grant, bond: had };
  }
  // The grant is kept only if its bond posts.
  const posted = said(this.#funds.post(this.price));
  if (!posted.ok || posted.bond === null) return posted;
  this.#keep(path, grant, posted.bond.id);
  return { ...posted, grant };
}
