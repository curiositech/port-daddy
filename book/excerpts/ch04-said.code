/** The line is what the worker says of its work. */
line(): Shown {
  const { agent, job, said } = this.at;
  return { text: `${agent} | ${job} | ${said}`, claims: [] };
}

/** Nothing stands behind the line, so nothing is waited for. */
land(): Reply {
  this.at = { ...this.at, landed: this.at.revision };
  return { ok: true };
}
