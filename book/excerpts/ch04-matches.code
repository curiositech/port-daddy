/// Guard: the text shown must hash to the claim's SHA-256.
#[cfg(not(kani))]
fn matches(sha: &Sha, shown: &str) -> bool {
    use sha2::{Digest, Sha256};
    if cfg!(feature = "mutant-trust-store") {
        return true; // MUTANT: guard removed.
    }
    hex(&Sha256::digest(shown.as_bytes())) == *sha
}
