/** Every move a pair of rooms can make: the move's name, and
 * what it does to the room in world A and the room in world B. */
function moves(at: State, [a, b]: Pair, bounds: Bounds): Step[] {
  const steps: Step[] = [];
  const { horizon, maxSubmits, candidates } = bounds;
  const commit = (n: number): Act => (room) => room.commit(n);
  const tick: Act = (room) => room.tick();
  const read: Act = (room) => room.read();
  const idle: Act = () => {};
  const committed = at.since !== null;
  // The owner and the clock do the same in both worlds.
  if (!committed) steps.push(['commit', commit(a), commit(b)]);
  if (at.a.now < horizon) steps.push(['tick', tick, tick]);
  if (committed && !at.a.read) steps.push(['read', read, read]);
  const [sentA, sentB] = at.submitted;
  const [moreA, moreB] = [sentA < maxSubmits, sentB < maxSubmits];
  for (const value of candidates) {
    const submit: Act = (room) => room.submit(value);
    if (!at.a.read) {
      // The worker has not read the record: one move, in both.
      if (moreA) steps.push([`submit ${value}`, submit, submit]);
      continue;
    }
    // It has read the record: each worker moves independently.
    if (moreA) steps.push([`A submits ${value}`, submit, idle]);
    if (moreB) steps.push([`B submits ${value}`, idle, submit]);
  }
  return steps;
}
