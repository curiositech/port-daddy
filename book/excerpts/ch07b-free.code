/// Give back the bond behind a grant that claims.rs has just
/// released. A second release finds the bond settled, and
/// moves nothing.
pub fn free(
    grant: Grant,
    stake: &Stake,
    bonds: &Bonds,
) -> Result<Staked, Reason> {
    let (funds, bond) = (bonds.funds, Some(stake.bond));
    let shown = Bonds {
        bond,
        ..bonds.clone()
    };
    let moved = match stake.bond.standing {
        Standing::Held => bonds::refund(&shown, stake.bond.id)?,
        _ => Moved { funds, bond },
    };
    Ok(Staked { grant, moved })
}
