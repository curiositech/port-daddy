/// Pay a plan out. `done` of its `of` milestones were done. The
/// provider earns that share of the bounty and gets that share
/// of the bond back. The rest of the bounty returns to the
/// requester, and the rest of the bond is forfeited.
pub fn settle(
    plans: &Plans,
    id: u64,
    done: u64,
    of: u64,
) -> Result<PlansUpdate, Reason> {
    let plan = open_plan(plans.plan.as_ref(), id)?;
    let (earned, unearned) = split(plan.bounty, done, of)?;
    let (returned, forfeit) = split(plan.bond, done, of)?;
    let (mut requester, mut provider) = (
        plans.requester + unearned,
        plans.provider + earned + returned,
    );
    if plans.shared {
        // One wallet receives both sides' payments.
        requester += earned + returned;
        provider = requester;
    }
    let stage = Stage::Settled;
    Ok(PlansUpdate {
        requester,
        provider,
        commons: plans.commons + forfeit,
        plan: Some(Plan { stage, ..*plan }),
    })
}
