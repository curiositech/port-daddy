/// Guard: work with no stored diff gets no line.
fn stored_diff(work: &Work) -> Option<Sha> {
    if cfg!(feature = "mutant-missing-diff") {
        // MUTANT: make a line with or without a diff.
        return Some(work.diff.clone().unwrap_or_default());
    }
    work.diff.clone()
}

/// Guard: only a run of the current revision counts.
fn current_run(work: &Work) -> Option<&Run> {
    if cfg!(feature = "mutant-any-run") {
        return work.run.as_ref(); // MUTANT: guard removed.
    }
    work.run
        .as_ref()
        .filter(|run| run.revision == work.revision)
}
