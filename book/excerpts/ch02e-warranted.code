/// Check the warrant to take back the last card of an admitted
/// chain. It must come from the harbor, or from the holder of
/// a card of that chain.
pub fn warranted(
    pass: Pass,
    warrant: Option<&Warrant>,
    gate: &Gate,
    policy: &Policy,
) -> Result<Pass, Reason> {
    if policy.withdrawers == Withdrawers::Anyone {
        return Ok(pass);
    }
    let Some(warrant) = warrant else {
        return unwarranted(pass);
    };
    // The key must be the harbor's, or one a card of this chain
    // names: the card's own holder, or a holder above it.
    if !above(&pass, gate, &warrant.by) {
        return Err(Reason::NotAbove);
    }
    // The gate works out what the warrant must be a signature
    // over. It takes nobody's word for the card.
    let card = pass.cards.last().map_or("", String::as_str);
    let text = text(&gate.key, card);
    if !signed(&warrant.by, &text, &warrant.tag) {
        return Err(Reason::NotWarranted);
    }
    Ok(pass)
}
