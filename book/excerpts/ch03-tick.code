/// The clock has moved to `now`. If the slot is due and has not
/// been used, the declared part of the record leaves.
pub fn tick(room: &Room, now: u64) -> Passed {
    if !due(room, now) || spent(room) {
        return kept(room);
    }
    let Some(from) = source(room) else {
        return kept(room);
    };
    let value = declared(room, from);
    Passed {
        used: true,
        out: Some(Release { at: now, value }),
        ..kept(room)
    }
}
