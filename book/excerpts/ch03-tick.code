/// The clock has moved to `now`. If the slot is due and has
/// not been used, release the declared bits of the record.
pub fn tick(room: &Room, now: u64) -> RoomUpdate {
    if !due(room, now) || spent(room) {
        return unchanged(room);
    }
    let Some(from) = source(room) else {
        return unchanged(room);
    };
    let value = declared(room, from);
    RoomUpdate {
        used: true,
        out: Some(Release { at: now, value }),
        ..unchanged(room)
    }
}
