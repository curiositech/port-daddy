/// A card may grant only what its parent grants, and may not
/// expire later.
fn within(
    card: &Claims,
    parent: &Claims,
    no: usize,
) -> Result<(), Reason> {
    for right in &card.can {
        if !grants(&parent.can, right) {
            return Err(Reason::Widens {
                card: no,
                right: right.clone(),
            });
        }
    }
    if outlives(card.exp, parent.exp) {
        return Err(Reason::Outlives {
            card: no,
            until: card.exp,
            parent: parent.exp,
        });
    }
    Ok(())
}

/// One right covers another: the same verb, on no more paths.
fn covers(held: &Right, other: &Right) -> bool {
    held.verb == other.verb && includes(&held.on, &other.on)
}

/// A pattern that ends in `*` includes every path that starts
/// with the text before the star, and every pattern that
/// matches only such paths. Any other pattern is one path.
fn includes(pattern: &str, other: &str) -> bool {
    match pattern.strip_suffix('*') {
        Some(start) => {
            let inner = other.strip_suffix('*').unwrap_or(other);
            inner.starts_with(start)
        }
        None => pattern == other,
    }
}
