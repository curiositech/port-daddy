/** Drop each entry the core lets go of. */
forget(now: number): number {
  let dropped = 0;
  for (const [id, entry] of this.#entries) {
    const drop = { op: 'forget', id } as const;
    const state = { gate: { entry } };
    const answer = this.#core.decide(drop, state, POLICY, now);
    if (answer.verdict === 'admit') {
      this.#entries.delete(id);
      dropped += 1;
    }
  }
  return dropped;
}
