/** Take a card back, and keep its chain to show other gates. */
override withdraw(chain: readonly string[], now: number): Taking {
  const taking = super.withdraw(chain, now);
  const id = idIfCard(chain.at(-1) ?? '');
  if (taking.ok) this.#shown.set(id, chain);
  return taking;
}

/** The news: the chain of every card held as taken back. */
news(): Chains {
  return [...this.#shown.values()];
}

/** Hear another gate's news. Each chain new to this gate is
 * checked here, as if it had been shown here. */
hear(news: unknown, now: number): number {
  let fresh = 0;
  for (const chain of chainsIn(news)) {
    const id = idIfCard(chain.at(-1) ?? '');
    if (this.#shown.has(id)) continue;
    if (this.withdraw(chain, now).ok) fresh += 1;
  }
  return fresh;
}
