/** Let a chain through if its cards are good and its holder has
 * signed what is asked. `nonce` is the gate's challenge, if it
 * hands them out. */
export function signedAsk(
  shown: Showing,
  cards: Gate,
  now: number,
  nonce = '',
): Verdict {
  const good = cards.admit(shown.chain, shown.ask, now);
  if (!good.ok) return good;
  if (!shown.proof) return refused('no-proof', NO_PROOF);
  const last = shown.chain.at(-1) ?? '';
  const text = said(nonce, shown.ask, idOf(last));
  if (signedBy(last, text, shown.proof)) return good;
  return refused('not-proved', NOT_PROVED);
}
