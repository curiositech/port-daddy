/** Admit a chain if its cards are valid and its holder has
 * signed the request. `nonce` is the gate's challenge, if it
 * issues them. */
export function checkSigned(
  presented: Presentation,
  cards: Gate,
  now: number,
  nonce = '',
): Verdict {
  const { chain, requested, proof } = presented;
  const valid = cards.admit(chain, requested, now);
  if (!valid.ok) return valid;
  if (!proof) return refused('no-proof', NO_PROOF);
  const last = chain.at(-1) ?? '';
  const text = proofText(nonce, requested, idOf(last));
  if (signedBy(last, text, proof)) return valid;
  return refused('not-proved', NOT_PROVED);
}
