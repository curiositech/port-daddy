/** The text a revocation is a signature over. It holds no
 * challenge, so it is the same at every gate. */
export function revocationText(
  harborKey: string,
  card: string,
): string {
  return JSON.stringify(['revoke', harborKey, card]);
}

/** Sign a revocation of the last card of a chain. */
export function signRevocation(
  keys: Keys,
  harborKey: string,
  chain: readonly string[],
): Revocation {
  const last = chain.at(-1);
  const card = last ? idOf(last) : '';
  const text = revocationText(harborKey, card);
  const tag = sign(null, Buffer.from(text), keys.secret);
  return { by: keys.public, tag: tag.toString('base64url') };
}
