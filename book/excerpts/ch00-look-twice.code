/** Add one, looking twice: read again before writing, and start
 * again if the version has changed. */
export function* lookTwice(cell: Shared, me: string, think = 1) {
  for (;;) {
    const seen = cell.read(me);
    yield* thinking(think);
    const again = cell.read(me);
    if (again.version !== seen.version) continue;
    yield; // the second read and the write are two requests
    cell.put(me, seen.value + 1);
    return;
  }
}
