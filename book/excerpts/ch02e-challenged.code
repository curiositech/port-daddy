/** Revoke a card for whoever answers one of this gate's
 * challenges with the harbor's key or one the chain names. */
override revoke(
  chain: readonly string[],
  now: number,
  answer?: Revocation,
): RevokeResult {
  if (!answer || !('nonce' in answer)) {
    return refused('no-answer', NO_ANSWER);
  }
  const { by, nonce, tag } = answer as Answer;
  // The challenge must be one this gate issued.
  const open = this.opened({ nonce, tag });
  if (!open || open.until < now) {
    return refused('unknown-challenge', NOT_OPEN);
  }
  this.close(nonce);
  if (by !== this.key && !chain.map(keyIn).includes(by)) {
    return refused('not-in-chain', NOT_IN_CHAIN);
  }
  const id = idIfCard(chain.at(-1) ?? '');
  if (!signedWith(by, answerText(nonce, id), tag)) {
    return refused('not-answered', NOT_ANSWERED);
  }
  const result = super.revoke(chain, now);
  const kept = { chain, answer: { by, nonce, tag } };
  if (result.ok) this.#answered.set(id, kept);
  return result;
}
