/// The guard: the wallet covers the bond. It returns the
/// wallet's new balance, so the check and the debit are one
/// step.
fn covered(wallet: u64, asked: u64) -> Result<u64, Reason> {
    if cfg!(feature = "mutant-overdraw") {
        // MUTANT: guard removed.
        return Ok(wallet.saturating_sub(asked));
    }
    let short = Reason::Short { wallet, asked };
    wallet.checked_sub(asked).ok_or(short)
}
