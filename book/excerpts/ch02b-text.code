/// The text a proof is a signature over: a JSON list that begins
/// with the word `proof` and the challenge, and ends with the
/// requested right and the id of the last card. A card's signed
/// text begins with the harbor's header, so no proof is a card.
fn text(nonce: &str, right: Option<&Right>, id: &str) -> String {
    let right = right.map(right_text).unwrap_or_default();
    json!(["proof", nonce, right, id]).to_string()
}
