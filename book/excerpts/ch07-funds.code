/// A project's funds, in whole units.
pub struct Funds {
    /// Free to spend.
    pub wallet: u64,
    /// Held against the bonds that are posted.
    pub escrow: u64,
    /// Forfeited. No operation here pays out of it.
    pub pool: u64,
}

/// The project's total units, if the host can represent that
/// count exactly.
pub fn supply(funds: &Funds) -> Option<u64> {
    let free = funds.wallet.checked_add(funds.escrow)?;
    free.checked_add(funds.pool).filter(|all| *all <= CEILING)
}
