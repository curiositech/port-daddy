/// Refuse a chain if any card in it was taken back. The gate
/// must have looked every card up, and not only the last.
pub fn standing(
    pass: Pass,
    looked: &Looked,
    policy: &Policy,
) -> Result<Pass, Reason> {
    if policy.withdrawals == Withdrawals::Unasked {
        return Ok(pass);
    }
    for (card, id) in links(&pass) {
        // The core has worked each id out for itself. An id the
        // gate did not look up is one nobody can vouch for.
        if !asked(looked, id) {
            return Err(Reason::NotLookedUp { card });
        }
        if looked.found.contains(id) {
            return Err(Reason::Withdrawn { card });
        }
    }
    Ok(pass)
}
