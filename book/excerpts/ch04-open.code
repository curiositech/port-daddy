/// The operator opens one claim, and is shown `shown`. The
/// claim counts as opened if `shown` has the claim's hash.
pub fn open(
    work: &Work,
    claim: usize,
    shown: &str,
) -> Result<Review, Reason> {
    let mut review = review(work)?;
    let Some(named) = review.line.claims.get(claim) else {
        return Err(Reason::NoSuchClaim { claim });
    };
    if !matches(&named.sha, shown) {
        return Err(Reason::HashMismatch { claim });
    }
    if !review.opened.contains(&named.sha) {
        review.opened.push(named.sha.clone());
    }
    Ok(review)
}
