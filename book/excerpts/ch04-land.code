/// An act that cannot be undone. The work must be verified, and
/// every claim on its line must have been opened.
pub fn land(work: &Work) -> Result<Review, Reason> {
    let review = review(work)?;
    if !verified(&review.line) {
        return Err(Reason::NotVerified);
    }
    if let Some(claim) = first_unopened(&review) {
        return Err(Reason::NotOpened { claim });
    }
    Ok(Review {
        landed: true,
        ..review
    })
}
