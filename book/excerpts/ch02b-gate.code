/** Issue a challenge, valid for thirty seconds. */
challenge(now: number): string {
  this.#sweep(now);
  const nonce = this.#nonces();
  this.#open.set(nonce, { nonce, until: now + ANSWER_WITHIN });
  return nonce;
}

/** Decide one presentation in a single turn: the challenge is
 * looked up and deleted with nothing running in between. */
admit(
  chain: readonly string[],
  requested: Right | undefined,
  now: number,
  proof?: Proof,
): Verdict {
  const open = proof && this.#open.get(proof.nonce);
  const state = { gate: { key: this.#key, open } };
  const op = 'present' as const;
  const proposal = { op, chain, requested, proof };
  const answer = this.core.decide(proposal, state, PROVED, now);
  if (answer.verdict === 'refuse') {
    return refused(answer.reason.code, explain(answer.reason));
  }
  this.#close(answer.pass.answered);
  return { ok: true, holder: answer.pass.holder };
}
