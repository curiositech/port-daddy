/// Check a chain of cards, the harbor's first, and a request.
pub fn admit(
    chain: &[String],
    requested: Option<&Right>,
    gate: &Gate,
    now: u64,
) -> Result<Pass, Reason> {
    let mut links: Vec<Link> = Vec::new();
    for (at, card) in chain.iter().enumerate() {
        let no = at + 1;
        // The key this card must be signed with: the one its
        // parent names, or the harbor's for the first card.
        let parent = links.last();
        let key = parent.map_or(&gate.key, |p| &p.claims.key);
        let (claims, tag) = signed(card, key, no)?;
        let id = match (parent, &claims.jti, &claims.par) {
            // The harbor's card carries a serial number.
            (None, Some(serial), None) => serial.clone(),
            // A delegated card names its parent.
            (Some(parent), None, Some(par)) => {
                names_parent(par, parent, no)?;
                within(&claims, limit(&links, parent), no)?;
                hash(&tag)
            }
            _ => return Err(Reason::Unbound { card: no }),
        };
        if expired(now, claims.exp) {
            let until = claims.exp;
            return Err(Reason::Expired { card: no, until });
        }
        links.push(Link { id, claims });
    }
    let pass = Pass::from(&links).ok_or(Reason::NoCard)?;
    match requested.filter(|r| !grants(&pass.can, r)) {
        Some(right) => Err(Reason::NotGranted {
            right: right.clone(),
        }),
        None => Ok(pass),
    }
}
