{
  "version": 1,
  "purpose": "Define the curated GitHub-distribution subset for Port Daddy. Export from committed HEAD, not the dirty working tree, so internal workshop edits do not leak into the public mirror.",
  "defaultRef": "HEAD",
  "defaultOutputDir": ".public-export",
  "includeExactPaths": [
    ".env.example",
    ".gitignore",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "VERSION",
    "config.json",
    "features.manifest.json",
    "install-daemon.ts",
    "jest.config.js",
    "mcp-server.json",
    "package-lock.json",
    "package.json",
    "pd-fleet.yml",
    "pd_logo.svg",
    "pd_logo_darkmode.svg",
    "server.ts",
    "scripts/build-core.sh",
    "scripts/build-daemon-binary.mjs",
    "scripts/build-public-samples.mjs",
    "scripts/build-single-binary.mjs",
    "tsconfig.json",
    "v4.dag.yaml",
    "docs/DELEGATION-MODES.md",
    "docs/FLEET-CSP-PROTOCOL.md",
    "docs/ROADMAP.md",
    "docs/SECURITY_SOUNDNESS.md",
    "docs/sdk.md",
    "docs/openapi.yaml"
  ],
  "includePrefixes": [
    ".claude-plugin/",
    ".github/",
    "apps/FleetBar/",
    "bin/",
    "cli/",
    "completions/",
    "core/",
    "docs/adr/",
    "docs/reports/",
    "demos/express-api/",
    "examples/",
    "fleet/",
    "fleet-config-ui/",
    "hooks/",
    "lib/",
    "mcp/",
    "migrations/",
    "public/",
    "routes/",
    "shared/",
    "skills/port-daddy-agent-skill/",
    "templates/",
    "tests/"
  ],
  "excludeExactPaths": [
    "public/Untitled 2.png",
    "public/app-surgery.html",
    "public/fleet-config.html",
    "public/fleet-live.html"
  ],
  "excludePrefixes": [
    "apps/FleetBar/.build/",
    "docs/plans/",
    "docs/recovery/",
    "website-v2/"
  ],
  "excludeRegexes": [
    "(^|/)\\.DS_Store$",
    "(^|/)__pycache__/",
    "(^|/)node_modules/",
    "(^|/)\\.build/",
    "\\.pyc$",
    "\\.bak$",
    "^analyses/",
    "^dashboard/",
    "^docs/IDEAS_INDEX\\.md$",
    "^docs/V4-RECOVERY-MAP\\.md$",
    "^gemini-plans/",
    "^IMG_5014\\.png$",
    "^PLAN\\.md$",
    "^port-daddy-asciinema-skills-plan\\.md$",
    "^screenshots/",
    "^test-results/"
  ],
  "smokeIncludedPaths": [
    "AGENTS.md",
    "README.md",
    "apps/FleetBar/Package.swift",
    "docs/ROADMAP.md",
    "lib/client.ts",
    "public/index.html"
  ],
  "smokeExcludedPaths": [
    ".cartographer/status.md",
    "analyses/product-appeal.md",
    "docs/recovery/CURRENT-WORK.md",
    "public/app-surgery.html",
    "website-v2/public/llms.txt"
  ]
}
