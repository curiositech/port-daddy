{
  "candidatePaths": [
    {
      "path": "/Users/agent/.port-daddy/registry.db",
      "canonical": true,
      "kind": "home"
    }
  ],
  "envPin": {
    "varName": "PORT_DADDY_DB"
  },
  "journalMode": "wal",
  "busyTimeoutMs": 0,
  "migrations": [
    {
      "id": "001_init",
      "postVerify": {
        "table": "sessions",
        "probeSql": "SELECT 1 FROM sessions LIMIT 1"
      }
    }
  ],
  "writerTopology": {
    "strategy": "single-writer",
    "writers": [
      {
        "name": "daemon",
        "mode": "exclusive"
      }
    ]
  },
  "busyHandlingPolicy": "serialized_writer"
}
