{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portdaddy.dev/schemas/swarm-invocation-v2.json",
  "title": "ControllerOwnedInvocationContract structural envelope only",
  "$comment": "This schema validates JSON shape. Cross-field semantics are enforced by validate-swarm-invocation.mjs.",
  "$defs": {
    "text": {"type":"string","pattern":"\\S"},
    "textList": {"type":"array","items":{"$ref":"#/$defs/text"},"uniqueItems":true},
    "positiveInt": {"type":"integer","minimum":1},
    "nonNegativeFinite": {"type":"number","minimum":0},
    "node": {"type":"object","additionalProperties":false,"required":["id","type","dependencies","effectClass","outputSchemaRef"],"properties":{"id":{"$ref":"#/$defs/text"},"type":{"enum":["work","evidence","review","gather","terminal"]},"dependencies":{"$ref":"#/$defs/textList"},"effectClass":{"$ref":"#/$defs/text"},"outputSchemaRef":{"$ref":"#/$defs/text"}}},
    "gather": {"type":"object","additionalProperties":false,"required":["id","members","policy","reducerId"],"properties":{"id":{"$ref":"#/$defs/text"},"members":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"},"uniqueItems":true},"policy":{"enum":["ALL","QUORUM","DEADLINE_PARTIAL"]},"reducerId":{"$ref":"#/$defs/text"},"quorum":{"$ref":"#/$defs/positiveInt"},"deadlineMs":{"$ref":"#/$defs/positiveInt"}},"allOf":[{"if":{"properties":{"policy":{"const":"QUORUM"}}},"then":{"required":["quorum"]},"else":{"not":{"required":["quorum"]}}},{"if":{"properties":{"policy":{"const":"DEADLINE_PARTIAL"}}},"then":{"required":["deadlineMs"]},"else":{"not":{"required":["deadlineMs"]}}}]},
    "reducer": {"type":"object","additionalProperties":false,"required":["id","version","implementationDigest","deterministic"],"properties":{"id":{"$ref":"#/$defs/text"},"version":{"$ref":"#/$defs/text"},"implementationDigest":{"$ref":"#/$defs/text"},"deterministic":{"const":true}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion","kind","contractId","truthState","intent","plan","topology","authority","limits","nodes","gathers","reducers","reservationPolicy","leasePolicy","messagePolicy","reviewPolicy","cancellationPolicy","replayPolicy","evidence","terminalStatus"],
  "properties": {
    "schemaVersion":{"const":"2.0.0"}, "kind":{"const":"ControllerOwnedInvocationContract"}, "contractId":{"$ref":"#/$defs/text"}, "truthState":{"enum":["T0_STATIC","PROPOSED","UNKNOWN","BLOCKED_BY_HALT"]}, "terminalStatus":{"enum":["STATIC_VALID","STATIC_INVALID","INCOMPLETE_STATIC","OUT_OF_SCOPE","OUT_OF_SCOPE_LIVE_OPERATION"]},
    "intent":{"type":"object","additionalProperties":false,"required":["intentDigest","objective","completionPredicate","excludedEffects"],"properties":{"intentDigest":{"$ref":"#/$defs/text"},"objective":{"$ref":"#/$defs/text"},"completionPredicate":{"$ref":"#/$defs/text"},"excludedEffects":{"$ref":"#/$defs/textList"}}},
    "plan":{"type":"object","additionalProperties":false,"required":["digest","revision","limitDigest"],"properties":{"digest":{"$ref":"#/$defs/text"},"revision":{"$ref":"#/$defs/positiveInt"},"limitDigest":{"$ref":"#/$defs/text"}}},
    "topology":{"type":"object","additionalProperties":false,"required":["planning","runtime","supportStatus","acceptanceRef"],"properties":{"planning":{"$ref":"#/$defs/text"},"runtime":{"$ref":"#/$defs/text"},"supportStatus":{"enum":["EXACT","NARROWED","OMITTED","BLOCKED"]},"acceptanceRef":{"type":["null","string"],"pattern":"\\S"}},"allOf":[{"if":{"properties":{"supportStatus":{"const":"EXACT"}}},"then":{"properties":{"acceptanceRef":{"type":"null"}}},"else":{"properties":{"acceptanceRef":{"$ref":"#/$defs/text"}}}}]},
    "authority":{"type":"object","additionalProperties":false,"required":["admissionController","capacityOwner","lifecycleOwner","effectOwner","evidenceOwner","reviewer"],"properties":{"admissionController":{"$ref":"#/$defs/text"},"capacityOwner":{"$ref":"#/$defs/text"},"lifecycleOwner":{"$ref":"#/$defs/text"},"effectOwner":{"$ref":"#/$defs/text"},"evidenceOwner":{"$ref":"#/$defs/text"},"reviewer":{"$ref":"#/$defs/text"}}},
    "limits":{"type":"object","additionalProperties":false,"required":["maxConcurrency","maxAttempts","maxReworkRounds","maxRecursiveBirths","maxDurationMs","maxMessageBytes","resourceCeiling"],"properties":{"maxConcurrency":{"$ref":"#/$defs/positiveInt"},"maxAttempts":{"$ref":"#/$defs/positiveInt"},"maxReworkRounds":{"const":1},"maxRecursiveBirths":{"const":0},"maxDurationMs":{"$ref":"#/$defs/positiveInt"},"maxMessageBytes":{"$ref":"#/$defs/positiveInt"},"resourceCeiling":{"type":"object","additionalProperties":false,"required":["modelTokens","providerUsd","operatorAttentionSeconds"],"properties":{"modelTokens":{"$ref":"#/$defs/nonNegativeFinite"},"providerUsd":{"$ref":"#/$defs/nonNegativeFinite"},"operatorAttentionSeconds":{"$ref":"#/$defs/nonNegativeFinite"}}}}},
    "nodes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/node"}}, "gathers":{"type":"array","items":{"$ref":"#/$defs/gather"}}, "reducers":{"type":"array","items":{"$ref":"#/$defs/reducer"}},
    "reservationPolicy":{"type":"object","additionalProperties":false,"required":["planGrantIsCeiling","bindingFields","terminalDispositions"],"properties":{"planGrantIsCeiling":{"const":true},"bindingFields":{"$ref":"#/$defs/textList"},"terminalDispositions":{"type":"array","minItems":1,"items":{"enum":["SETTLED","RELEASED","HELD_AMBIGUOUS"]},"uniqueItems":true}}},
    "leasePolicy":{"type":"object","additionalProperties":false,"required":["monotonicGeneration","externalFence","renewalRequiresReservation"],"properties":{"monotonicGeneration":{"const":true},"externalFence":{"const":true},"renewalRequiresReservation":{"const":true}}},
    "messagePolicy":{"type":"object","additionalProperties":false,"required":["ephemeralKinds","durableKinds","authoritativeEphemeral"],"properties":{"ephemeralKinds":{"$ref":"#/$defs/textList"},"durableKinds":{"$ref":"#/$defs/textList"},"authoritativeEphemeral":{"const":false}}},
    "reviewPolicy":{"type":"object","additionalProperties":false,"required":["independentReviewer","maxReworkRounds"],"properties":{"independentReviewer":{"const":true},"maxReworkRounds":{"const":1}}},
    "cancellationPolicy":{"type":"object","additionalProperties":false,"required":["ackDeadlineRequired","fenceRequired","terminationWitnessRequired","providerReconciliationRequired"],"properties":{"ackDeadlineRequired":{"const":true},"fenceRequired":{"const":true},"terminationWitnessRequired":{"const":true},"providerReconciliationRequired":{"const":true}}},
    "replayPolicy":{"type":"object","additionalProperties":false,"required":["effectsDenied","projections"],"properties":{"effectsDenied":{"const":true},"projections":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"},"uniqueItems":true}}},
    "evidence":{"type":"object","additionalProperties":false,"required":["staticLocators","dynamicEvidence"],"properties":{"staticLocators":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/text"},"uniqueItems":true},"dynamicEvidence":{"$ref":"#/$defs/textList"}}}
  }
}
