{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://portdaddy.dev/schemas/conversation-trace-v2.schema.json",
  "title":"ConversationTraceV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","protocolId","conversationId","epoch","scope","observedAt","limits","participants","gathers","messages","terminal","truthEffect","authorityEffect"],
  "properties":{
    "schemaVersion":{"const":"2.0.0"},"protocolId":{"type":"string","minLength":1},"conversationId":{"type":"string","minLength":1},"epoch":{"type":"integer","minimum":1},"scope":{"type":"string","minLength":1},"observedAt":{"type":"string","format":"date-time"},
    "limits":{"type":"object","additionalProperties":false,"required":["maxMessages","deadlineAt"],"properties":{"maxMessages":{"type":"integer","minimum":1},"deadlineAt":{"type":"string","format":"date-time"}}},
    "participants":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/participant"}},"gathers":{"type":"array","items":{"$ref":"#/$defs/gather"}},"messages":{"type":"array","items":{"$ref":"#/$defs/message"}},"terminal":{"$ref":"#/$defs/terminal"},"truthEffect":{"const":"NONE"},"authorityEffect":{"const":"NONE"}
  },
  "$defs":{
    "participant":{"type":"object","additionalProperties":false,"required":["principalRef","bodyGeneration","role","audiences"],"properties":{"principalRef":{"type":"string","minLength":1},"bodyGeneration":{"type":"integer","minimum":1},"role":{"type":"string","minLength":1},"audiences":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true}}},
    "gather":{"type":"object","additionalProperties":false,"required":["gatherId","membership","policy","quorum","inputKind","reducer","deadlineAt"],"properties":{"gatherId":{"type":"string","minLength":1},"membership":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"policy":{"enum":["ALL","QUORUM","FIRST_SUCCESS"]},"quorum":{"type":["integer","null"],"minimum":1},"inputKind":{"type":"string","minLength":1},"reducer":{"enum":["ORDERED_LIST","PRESERVE_DISSENT","FIRST_BY_CANONICAL_ORDER"]},"deadlineAt":{"type":"string","format":"date-time"}}},
    "message":{"type":"object","additionalProperties":false,"required":["messageId","protocolId","conversationId","epoch","senderPrincipalRef","senderBodyGeneration","audience","audienceLabels","scope","senderSequence","kind","correlationId","causationId","payloadType","payloadDigest","observedAt","expiresAt","verificationReceiptRef","gatherId"],"properties":{"messageId":{"type":"string","minLength":1},"protocolId":{"type":"string","minLength":1},"conversationId":{"type":"string","minLength":1},"epoch":{"type":"integer","minimum":1},"senderPrincipalRef":{"type":"string","minLength":1},"senderBodyGeneration":{"type":"integer","minimum":1},"audience":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"audienceLabels":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},"scope":{"type":"string","minLength":1},"senderSequence":{"type":"integer","minimum":1},"kind":{"enum":["REQUEST","RESPONSE","CONTRIBUTION","DISSENT","GATHER_RESULT","CANCEL_REQUEST","TERMINAL_FENCE","ACK"]},"correlationId":{"type":["string","null"]},"causationId":{"type":["string","null"]},"payloadType":{"type":"string","minLength":1},"payloadDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"observedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"verificationReceiptRef":{"type":"string","minLength":1},"gatherId":{"type":["string","null"]}}},
    "terminal":{"type":"object","additionalProperties":false,"required":["state","fenceMessageId","requiredAcknowledgements","receivedAcknowledgements","stateDigest","unresolvedParticipants"],"properties":{"state":{"enum":["COMPLETED","BLOCKED","TIMED_OUT","CANCELLED","DISSENT_RECORDED"]},"fenceMessageId":{"type":["string","null"]},"requiredAcknowledgements":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"receivedAcknowledgements":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"stateDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"unresolvedParticipants":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}}
  }
}
