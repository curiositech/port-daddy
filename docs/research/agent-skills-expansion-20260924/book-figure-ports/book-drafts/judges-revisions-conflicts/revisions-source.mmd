stateDiagram-v2
  direction LR
  state "Compile evidence" as Compile {
    [*] --> Current_compile
    Current_compile --> Stale_compile: source input changes
  }
  state "Acceptance evidence" as Accept {
    [*] --> Current_acceptance
    Current_acceptance --> Stale_acceptance: source input or policy changes
  }
  state "Publication authority" as Publish {
    [*] --> Granted
    Granted --> Blocked: authority revoked
  }

  Stale_compile --> Revalidate: rebuild artifact evidence
  Stale_acceptance --> Revalidate: rerun acceptance evidence
  Revalidate --> Current_compile: artifact checks pass
  Revalidate --> Current_acceptance: acceptance checks pass
  Blocked --> [*]

  note right of Revalidate
    An earlier UNKNOWN publication
    remains a separate reconciliation obligation.
  end note
