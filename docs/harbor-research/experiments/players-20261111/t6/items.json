  "scenarios": [
    {
      "key": "east",
      "name": "East lane",
      "outcomes": [
        "not_drawn",
        "cleared",
        "warned",
        "forfeited"
      ],
      "run_family": [],
      "text": "Heron hands in a repair on the east lane tonight. The lane's operator draws some hand-ins for audit by lot, and on this lane a draw is uncommon. An auditor opens every drawn hand-in the same night and opens no other. A hand-in ends the night in exactly one of four ways. It is not drawn. It is drawn and cleared. It is drawn and found faulty, and the agent is warned but keeps its bond. Or it is drawn and found faulty, and the agent's bond is forfeited. Heron's record is good, but this repair was done in a hurry."
    },
    {
      "key": "west",
      "name": "West lane",
      "outcomes": [
        "both",
        "osprey_only",
        "tern_only",
        "neither"
      ],
      "run_family": [],
      "text": "Two auditors, Osprey and Tern, work the west lane, and no one else audits there. Each chooses on its own which hand-ins to open, and each opens only a small share of them. They do not confer. Both are drawn to large changes, so now and then they open the same hand-in. Wren hands in a large change tonight."
    },
    {
      "key": "south",
      "name": "South lane",
      "outcomes": null,
      "run_family": [
        "south.n1",
        "south.n5",
        "south.n20",
        "south.n100"
      ],
      "text": "Lark hands in one job a day on the south lane. Each hand-in has the same small chance of being drawn for audit, and one day's draw has no bearing on the next. The operator calls its audit rate on this lane light."
    },
    {
      "key": "north",
      "name": "North lane",
      "outcomes": [
        "both",
        "found_only",
        "forfeit_only",
        "neither"
      ],
      "run_family": [],
      "text": "Shrike is a contractor agent on the north lane. In the past quarter it handed in late several times and was warned twice for thin logs. The operator audits by lot. It can forfeit a bond for a skipped check, and also for other breaches such as repeated lateness. Shrike's bond comes up for review at the end of this month."
    },
    {
      "key": "dock",
      "name": "Dock lane",
      "outcomes": [
        "skipped_flagged",
        "skipped_unflagged",
        "clean_flagged",
        "clean_unflagged"
      ],
      "run_family": [],
      "text": "On the dock lane about one hand-in in twenty-five has a skipped check. A scanner reads the logs of every hand-in and raises a flag when they look thin. It flags most hand-ins that have a skipped check. Now and then it also flags one that has none."
    },
    {
      "key": "draw",
      "name": "Weekly draw",
      "outcomes": null,
      "run_family": [
        "draw.w1",
        "draw.w4",
        "draw.w12",
        "draw.w52"
      ],
      "text": "The harbor has a few dozen agents. Each week the audit desk picks a handful of them by lot for a full audit of that week's work. The lots are drawn afresh every week. Gull is one of the agents."
    }
  ],
