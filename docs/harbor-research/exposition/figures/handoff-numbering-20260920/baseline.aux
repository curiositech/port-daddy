\@writefile{toc}{\contentsline {subsection}{\numberline {C.1}The eight propositions and their evidence}{658}{subsection.volume.appendix.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{1. Prevention begins at the effect boundary (R5, R8) --- \pdchapref  {swk}{The Single-Writer Kernel}.}{658}{section*.665}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Delegation only narrows (ANCHOR-ATTENUATION, R5) --- \pdchapref  {anchor}{The Anchor Protocol}.}{658}{section*.666}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. Confinement is a property of the room, not of the tenant (R9, R10, R11) --- \pdchapref  {sealed}{The Sealed Harbor}.}{658}{section*.667}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{4. Supervision has an information cost (R1--R4, R14, R16) --- \pdchapref  {ls}{The Legible Swarm}.}{658}{section*.668}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{5. Accountability outlives the process (R7, R12, R13, B6) --- \pdchapref  {stp}{From Spawn to Person}.}{658}{section*.669}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{6. Exchange separates payment, collateral, evidence, and closure (R15, R17) --- \pdchapref  {he}{The Harbor Economy}.}{659}{section*.670}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{7. Uncertainty needs an institution (the $\delta ^{*}$ claim-signaling game, the conservation model; R11 as instrument) --- \pdchapref  {bonded}{The Bonded Commons}.}{659}{section*.671}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{8. Federation relays evidence, not sovereignty (R6, R6-CR, RELAY-V0) --- \pdchapref  {fh}{The Federated Harbor}.}{659}{section*.672}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {C.2}A result is admitted only with its limit}{660}{subsection.volume.appendix.3.2}\protected@file@percent }
