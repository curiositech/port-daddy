\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{The guarded claim lifecycle as a state machine. Acquire is a single insert against a uniqueness constraint; re-claim and release are idempotent; expiry moves a claim to \emph  {expired}, from which the next read lazily sweeps it back to \emph  {free}. There is no \emph  {queued} state and therefore no fairness or bounded-wait guarantee: a losing caller must retry, and nothing schedules it a turn. [internal]}}{19}{figure.1.5}\protected@file@percent }
\newlabel{swk:fig:swk-claim-lifecycle}{{1.5}{19}{The guarded claim lifecycle as a state machine. Acquire is a single insert against a uniqueness constraint; re-claim and release are idempotent; expiry moves a claim to \emph {expired}, from which the next read lazily sweeps it back to \emph {free}. There is no \emph {queued} state and therefore no fairness or bounded-wait guarantee: a losing caller must retry, and nothing schedules it a turn. [internal]}{figure.1.5}{}}
\newlabel{swk:fig:swk-claim-lifecycle@cref}{{[figure][5][]1.5}{[1][19][]19}}
