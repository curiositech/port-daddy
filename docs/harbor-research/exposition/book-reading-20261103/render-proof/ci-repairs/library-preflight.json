    {
      "yaml_step": 19,
      "name": "Every marginalia plate has a licence sidecar in the allow-list",
      "command": "set -euo pipefail\npython3 scripts/harbor-research/check_marginalia_sidecars.py\n# A test module that cannot import is reported as one error and the\n# run still says \"Ran N tests\" -- which is how 11 page-measurement\n# tests went missing while the line above looked like it had run\n# them. Count what actually ran.\n# `|| true`, because errexit kills the step at a failing command\n# substitution before the echo runs -- which is how a genuinely\n# failing suite produced a red step with no output at all, the same\n# silence this counter was added to end. The exit status is taken\n# from the captured status, not from the substitution.\nout=$(python3 -m unittest discover -s tests/harbor-research -p 'test_*.py' 2>&1) || suite_failed=1\necho \"$out\"\nif [ \"${suite_failed:-0}\" = \"1\" ]; then\n  echo \"::error::the harbor-research suite failed; its output is above\"\n  exit 1\nfi\n# The floor is the count the suite actually has, raised whenever it\n# grows -- it sat at 212 while the suite had grown to 291, which is a\n# floor that would no longer have caught the missing-import case it\n# was written for.\nran=$(printf '%s' \"$out\" | sed -n 's/^Ran \\([0-9]*\\) tests.*/\\1/p')\nif [ \"${ran:-0}\" -lt 428 ]; then\n  echo \"::error::the harbor-research suite ran ${ran:-0} tests, fewer than the 428 it has; a module failed to import\"\n  exit 1\nfi\n",
      "cwd": ".",
