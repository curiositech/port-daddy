  "root": {
    "intent": "Prove that bounded agent work can start, stop, fail, checkpoint, and continue in a new body without losing identity, authority, evidence, or economic truth.",
    "nonGoals": [
      "Restart or dogfood the halted local Port Daddy runtime",
      "Treat a provider session, PID, VM, actor office, or durable session row as the durable person",
      "Infer remaining subscription allowance from a price or a successful request",
      "Expose the full MCP catalog or use schema hiding as authorization",
      "Allow a coding harness to supervise or certify its own containment",
      "Claim cross-provider semantic continuity before fixture and adversarial proof"
    ],
    "invariants": [
      "One AgentNode has at most one effect-capable body generation",
      "Every body is externally witnessed and fenced",
      "Every source tree is an immutable origin/main pin plus a disposable linked worktree",
      "UNKNOWN capacity, effect outcome, capability semantics, or body state is never rendered healthy",
      "Subscription allowance and cash remain separate native-unit ledgers",
      "A successor receives newly compiled capabilities and never a copied credential",
      "A non-idempotent effect in DISPATCHED state blocks replay until reconciled",
      "Operator Stop remains reachable outside the guest and provider session",
      "No test may create recursive unbounded birth, retry, network, or spend"
    ]
  },
