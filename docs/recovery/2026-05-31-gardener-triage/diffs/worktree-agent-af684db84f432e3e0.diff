+// ---------------------------------------------------------------------------
+// pd session budget — termination-policy management
+// ---------------------------------------------------------------------------
+//
+// Forms:
+//   pd session budget                              -- show current
+//   pd session budget --set-max-tokens N           -- bump / set
+//   pd session budget --set-max-time 30m           -- 30s / 5m / 2h / 1d
+//   pd session budget --set-max-messages M         -- set message cap
+//   pd session budget --reset                      -- zero counters; back to 'active'
+//
+// If --session/--agent are not given, falls back to the local .portdaddy
+// context (same convention as `pd note` / `pd files`).
+
+function formatRemaining(remaining: number | null, limit: number | null, unit: string): string {
+  if (limit === null) return 'unbounded';
+  if (remaining === null) return `0 ${unit} / ${limit} ${unit}`;
+  return `${remaining} ${unit} remaining / ${limit} ${unit} limit`;
+}
+
+async function sessionBudget(rest: string[], options: CLIOptions): Promise<void> {
+  // Resolve target session via local context unless explicit.
+  const pd = createSessionClient(options);
+  const resolved = await resolveActiveSessionForFiles(pd, options);
+  if (!resolved) {
+    ui.error('No active session found. Use --session <id> or run `pd begin` first.');
+    process.exit(1);
+  }
+  const sessionId = resolved.sessionId;
+
+  // Parse mutation flags. The CLI parser assigns `true` for valueless flags
+  // (e.g. `--reset`), strings for `--flag value`, so the raw type spans all three.
+  const setTokensRaw = options['set-max-tokens'] ?? options.setMaxTokens;
+  const setTimeRaw = options['set-max-time'] ?? options.setMaxTime;
+  const setMsgsRaw = options['set-max-messages'] ?? options.setMaxMessages;
+  const reset = !!(options.reset);
+
+  const limits: Record<string, number | null> = {};
+  let mutating = false;
+
+  const isClearSentinel = (v: unknown): boolean =>
+    v === 'null' || v === '' || v === true;
+
+  if (setTokensRaw !== undefined) {
+    mutating = true;
+    if (isClearSentinel(setTokensRaw)) {
+      limits.maxTokens = null;
+    } else {
+      const n = typeof setTokensRaw === 'number' ? setTokensRaw : parseInt(String(setTokensRaw), 10);
+      if (!Number.isFinite(n) || n < 0) {
+        ui.error(`--set-max-tokens must be a non-negative integer or "null". Got: ${String(setTokensRaw)}`);
+        process.exit(1);
+      }
+      limits.maxTokens = n;
+    }
+  }
+  if (setTimeRaw !== undefined) {
+    mutating = true;
+    if (isClearSentinel(setTimeRaw)) {
+      limits.maxSeconds = null;
+    } else {
+      const secs = parseDurationToSeconds(setTimeRaw as string | number);
+      if (secs === null) {
+        ui.error(`--set-max-time must be a duration (30m, 2h, 90s, ...). Got: ${String(setTimeRaw)}`);
+        process.exit(1);
+      }
+      limits.maxSeconds = secs;
+    }
+  }
+  if (setMsgsRaw !== undefined) {
+    mutating = true;
+    if (isClearSentinel(setMsgsRaw)) {
+      limits.maxMessages = null;
+    } else {
+      const n = typeof setMsgsRaw === 'number' ? setMsgsRaw : parseInt(String(setMsgsRaw), 10);
+      if (!Number.isFinite(n) || n < 0) {
+        ui.error(`--set-max-messages must be a non-negative integer or "null". Got: ${String(setMsgsRaw)}`);
+        process.exit(1);
+      }
+      limits.maxMessages = n;
+    }
+  }
+
+  // Reset path. If state is currently exhausted, confirm — un-blocks
+  // the session, which is potentially destructive intent.
+  if (reset) {
+    const probe: PdFetchResponse = await pdFetch(
+      `${PORT_DADDY_URL}/sessions/${encodeURIComponent(sessionId)}/budget`,
+    );
+    const probeData = await probe.json() as { snapshot?: { state?: string } } | null;
+    const probedState = probeData?.snapshot?.state;
+    if (probe.ok && probedState === 'exhausted' && !options.yes && canPrompt()) {
+      const confirm = await promptSelect({
+        label: `Session is 'exhausted'. Reset will un-block it. Continue?`,
+        choices: [
+          { value: 'no', label: 'No, leave as-is' },
+          { value: 'yes', label: 'Yes, reset counters and re-arm' },
+        ],
+        default: 'no',
+      });
+      if (confirm !== 'yes') {
+        ui.warn('Reset cancelled');
+        return;
+      }
+    }
+    const res: PdFetchResponse = await pdFetch(
+      `${PORT_DADDY_URL}/sessions/${encodeURIComponent(sessionId)}/budget/reset`,
+      { method: 'POST' },
+    );
+    const data = await res.json();
+    if (!res.ok) {
+      ui.error((data.error as string) || 'Failed to reset budget');
+      process.exit(1);
+    }
+    if (isJson(options)) {
+      console.log(JSON.stringify(data, null, 2));
+      return;
+    }
+    ui.success(`Budget counters reset for session ${sessionId}`);
+    // Fall through to show the new state below.
+    return showBudget(sessionId, options);
+  }
+
+  if (mutating) {
+    const res: PdFetchResponse = await pdFetch(
+      `${PORT_DADDY_URL}/sessions/${encodeURIComponent(sessionId)}/budget`,
+      {
+        method: 'PUT',
+        headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify(limits),
+      },
+    );
+    const data = await res.json();
+    if (!res.ok) {
+      ui.error((data.error as string) || 'Failed to set budget');
+      process.exit(1);
+    }
+    if (isJson(options)) {
+      console.log(JSON.stringify(data, null, 2));
+      return;
+    }
+    ui.success(`Budget updated for session ${sessionId}`);
+    return showBudget(sessionId, options);
+  }
+
+  // No flags — just show current.
+  return showBudget(sessionId, options);
+}
+
+async function showBudget(sessionId: string, options: CLIOptions): Promise<void> {
+  const res: PdFetchResponse = await pdFetch(
+    `${PORT_DADDY_URL}/sessions/${encodeURIComponent(sessionId)}/budget`,
+  );
+  const data = await res.json() as Record<string, unknown>;
+  if (!res.ok) {
+    ui.error((data.error as string) || 'Failed to fetch budget');
+    process.exit(1);
+  }
+
+  if (isJson(options)) {
+    console.log(JSON.stringify(data, null, 2));
+    return;
+  }
+  const snapMaybe = data.snapshot as { state?: string } | undefined;
+  if (isQuiet(options)) {
+    console.log(snapMaybe?.state ?? 'unknown');
+    return;
+  }
+
+  const snap = data.snapshot as {
+    state: string;
+    limits: { maxTokens: number | null; maxSeconds: number | null; maxMessages: number | null };
+    consumedTokens: number;
+    consumedSeconds: number;
+    consumedMessages: number;
+    remainingTokens: number | null;
+    remainingSeconds: number | null;
+    remainingMessages: number | null;
+    trippedBy: string | null;
+  };
+
+  console.error('');
+  console.error(`  Session: ${sessionId}`);
+  console.error(`  State:   ${snap.state}${snap.trippedBy ? ` (tripped by ${snap.trippedBy})` : ''}`);
+  console.error(`  Tokens:  ${formatRemaining(snap.remainingTokens, snap.limits.maxTokens, 'tokens')} -- ${snap.consumedTokens} consumed`);
+  console.error(`  Time:    ${formatRemaining(snap.remainingSeconds, snap.limits.maxSeconds, 's')} -- ${snap.consumedSeconds}s elapsed`);
+  console.error(`  Msgs:    ${formatRemaining(snap.remainingMessages, snap.limits.maxMessages, 'msgs')} -- ${snap.consumedMessages} written`);
+  console.error('');
+}
+
