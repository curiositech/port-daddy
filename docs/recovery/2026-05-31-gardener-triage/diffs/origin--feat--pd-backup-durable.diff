+      ui.info(`A pre-restore copy will be saved alongside as ${destPath}.pre-restore-<timestamp>.`);
+      const ok = await confirm('Proceed?');
+      if (!ok) {
+        ui.info('Aborted.');
+        return;
+      }
+    }
+
+    const result = await restoreBackup({
