+mentions_main_or_master() {
+  for a in "$@"; do
+    case "$a" in
+      main|master|origin/main|origin/master|refs/heads/main|refs/heads/master) return 0 ;;
+      */main|*/master) return 0 ;;
+    esac
+  done
+  return 1
+}
