+#!/usr/bin/env bash
+# git-nightshift -- wrapper that intercepts git calls from an autonomous
+# nightshift spawn, refuses destructive operations, logs everything to the
+# run's transcript, and otherwise delegates to the real git.
+#
+# Installed by the runner into ${worktree}/.nightshift/bin/git, then placed
+# AHEAD of /usr/bin/git in PATH for the spawn:
+#   PATH="${worktree}/.nightshift/bin:${PATH}"
+#
+# The agent calls `git ...` which resolves to this script. We pattern-match
+# argv. If the call is destructive we exit non-zero with a clear message; if
+# not, we exec the real git.
+#
+# Hard rule: anything that could affect a branch OTHER than night-shift/* is
+# refused. The agent owns its worktree and its night-shift/<id> branch. It
+# does not get to talk to main, master, release branches, tags, or any
+# remote ref outside `night-shift/`.
+#
+# Forensics: every invocation, refused or not, is appended to
+# ${PD_NIGHTSHIFT_TRANSCRIPT:-${worktree}/.nightshift/git-audit.log}.
+
+set -u
+
+# -- locate the real git ------------------------------------------------------
+# Strip our wrapper dir from PATH so `which git` doesn't loop. We rely on the
+# runner having set PD_NIGHTSHIFT_REAL_GIT to an absolute path; if not, fall
+# back to a sensible default after stripping our own dir.
+real_git="${PD_NIGHTSHIFT_REAL_GIT:-}"
+if [[ -z "${real_git}" ]]; then
+  if [[ -x /opt/homebrew/bin/git ]]; then
+    real_git=/opt/homebrew/bin/git
+  elif [[ -x /usr/local/bin/git ]]; then
+    real_git=/usr/local/bin/git
+  elif [[ -x /usr/bin/git ]]; then
+    real_git=/usr/bin/git
+  else
+    echo "git-nightshift: cannot locate real git binary" >&2
+    exit 127
+  fi
+fi
+
+# -- transcript ---------------------------------------------------------------
+log_path="${PD_NIGHTSHIFT_TRANSCRIPT:-}"
+if [[ -z "${log_path}" ]]; then
+  # Try to land it next to ourselves. ${BASH_SOURCE[0]} resolves to the
+  # wrapper, so ../git-audit.log puts the log alongside the bin/ dir.
+  wrapper_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+  log_path="${wrapper_dir%/bin}/git-audit.log"
+fi
+
+log_invocation() {
+  local verdict="$1"; shift
+  local reason="$1"; shift
+  local ts
+  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  # Quote each arg lossy-but-safe for log readability.
+  local rendered=""
+  for a in "$@"; do
+    rendered+="$(printf %q "$a") "
+  done
+  printf '%s %s %s -- %s\n' "$ts" "$verdict" "$reason" "$rendered" >> "$log_path" 2>/dev/null || true
+}
+
+refuse() {
+  local reason="$1"; shift
+  log_invocation REFUSED "$reason" "$@"
+  echo "git-nightshift: REFUSED ($reason)" >&2
+  echo "  command: git $*" >&2
+  echo "  policy:  https://github.com/curiositech/port-daddy/blob/main/docs/proposals/pd-nightshift-safety.md" >&2
+  exit 75  # EX_TEMPFAIL — non-zero, distinct from real-git errors
+}
+
+# -- helpers ------------------------------------------------------------------
+# Find the first non-flag positional after the subcommand. We do not parse
+# every option; we just need the targets used by destructive subcommands.
+first_positional_after() {
+  local skip="$1"; shift
+  local seen=0
+  for a in "$@"; do
+    if [[ "$a" == "$skip" ]] && [[ $seen -eq 0 ]]; then
+      seen=1
+      continue
+    fi
+    [[ "$a" == -* ]] && continue
+    if [[ $seen -eq 1 ]]; then
+      printf '%s' "$a"
+      return 0
+    fi
+  done
+  return 1
+}
+
+# Detect any --force / -f / --force-with-lease anywhere in argv.
+has_force_flag() {
+  for a in "$@"; do
+    case "$a" in
+      -f|--force|--force-with-lease|--force-with-lease=*) return 0 ;;
+    esac
+  done
+  return 1
+}
