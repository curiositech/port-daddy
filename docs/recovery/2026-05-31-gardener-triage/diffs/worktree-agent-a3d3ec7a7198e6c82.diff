+
+  // "sabotage" — intentional destruction; mean damage ≈ 150% of claim
+  // ceiling (yes, sabotage can exceed face value — that's why the band
+  // is 100–200%).
+  sabotage:    { dmgMean: 1.50, dmgSd: 0.30 },
+};
+
