{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://portdaddy.dev/schemas/textbook.schema.json",
  "title": "The Book: chapter order, numbering, parts, and edition metadata",
  "description": "The single source of record for the textbook edition of the coordination papers. Consumed by scripts/generate-mega-whitepaper.mjs (the Book), website-v2/src/data/whitePapers.ts (the site), and the shared figures/pd-textbook-map.tex the standalone chapters print. Numbers appear nowhere else.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edition",
    "parts",
    "chapters"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "edition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "version",
        "date",
        "pdf",
        "claim"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "pdf": {
          "type": "string",
          "pattern": "\\.pdf$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numeral",
          "title",
          "color",
          "blurb",
          "chapters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "numeral": {
            "type": "string",
            "pattern": "^[IVX]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^pd[a-z]+$",
            "description": "The part's hue. Chapters inherit it for all chrome (openers, rails, running feet); chapter-specific hues belong to figures, not chrome."
          },
          "blurb": {
            "type": "string",
            "minLength": 1
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "id",
          "prefix",
          "title",
          "source",
          "pdf",
          "role",
          "formerNumeral",
          "oneLine",
          "question",
          "epigraph"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]*$"
          },
          "prefix": {
            "type": "string",
            "pattern": "^[a-z]+$",
            "description": "Label namespace in the Book and part of TeX macro names; lowercase letters only."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "\\.tex$"
          },
          "pdf": {
            "type": "string",
            "pattern": "\\.pdf$"
          },
          "role": {
            "type": "string",
            "enum": [
              "builds",
              "proves"
            ]
          },
          "discharges": {
            "type": "string",
            "description": "For a proving chapter: the id of the earlier chapter whose promises it discharges."
          },
          "formerNumeral": {
            "type": "string",
            "pattern": "^[IVX]+$",
            "description": "First-edition numbering, kept only for the concordance."
          },
          "oneLine": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "description": "The question the chapter answers; set large on the chapter opener and repeated as the rail heading on its first page."
          },
          "epigraph": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Author, work, year. Quote exactly; the epigraph is attributed, never paraphrased."
              }
            }
          }
        }
      }
    }
  }
}
