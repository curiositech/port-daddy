(* ============================================================================
 * whitepaper/formal/proverif/coordination/isolation.pv
 *
 * ProVerif model for Port Daddy adversarial-fleet coordination isolation.
 *
 * What we model
 *   The daemon (note/msg/tuple persistence + routing) is the Dolev-Yao
 *   adversary. It can read every ciphertext written to either fleet
 *   namespace, replay them, drop them, or write its own. It does NOT
 *   hold either fleet key.
 *
 *   sec-eng-lead is a separate process holding both fleet keys plus
 *   its own Ed25519 root. Personas are processes holding ONE fleet key
 *   (the one for their fleet, this round) plus their own signing key.
 *
 *   Gate B is modeled as a one-shot lead operation: the lead receives
 *   the ENTIRE attack stream from Phase 1, decrypts under the red key,
 *   re-encrypts under the defense key, signs the bundle, and emits it
 *   to defense.
 *
 * Properties checked
 *   (S1) RedPayloadSecrecyPhase1: a payload written by a red persona in
 *        Phase 1 is not derivable by the attacker (i.e., the daemon does
 *        not learn it) before Gate B fires.
 *   (S2) DefensePayloadSecrecy: a payload written by a defense persona
 *        in Phase 2 is not derivable by the attacker, ever.
 *   (S3) GateBUniqueness: defense personas only learn red plaintext
 *        through a message authenticated as coming from sec-eng-lead
 *        (i.e., not from any direct red→defense path the daemon could
 *        forge).
 *
 * What the model intentionally does NOT cover (documented gaps)
 *   - Side channels (timing, cardinality of tags). Tags are public.
 *   - Compromise of the lead's keystore. Out of scope; covered by the
 *     SECURITY.md rotation runbook.
 *   - Compromise of a persona process. The fleet-key would leak, but
 *     that's per-process hardening, not the comms layer.
 *   - The actual round-salt KDF rotation. We model fixed per-round keys.
 *
 * How to run
 *   $ eval $(opam env) && proverif whitepaper/formal/proverif/coordination/isolation.pv
 *   Expected output:
 *     RESULT not attacker(red_msg[]) is true.        (S1)
 *     RESULT not attacker(def_msg[]) is true.        (S2)
 *     RESULT inj-event(DefenseLearnsRed(x))
 *            ==> inj-event(LeadEmitsToDefense(x)) is true.   (S3)
 * ============================================================================ *)

(* --- Symbolic crypto -------------------------------------------------------- *)

(* AEAD with associated data. We model AES-256-GCM symbolically; the AD
   is a parameter that must match for decryption to succeed. This captures
   the AD binding that defends against namespace-mismatched decrypts. *)
type key.
type ad.
type signkey.
type vkey.

fun aenc(bitstring, key, ad): bitstring.
reduc forall m: bitstring, k: key, a: ad; adec(aenc(m, k, a), k, a) = m.

(* Ed25519 signature *)
fun sign(bitstring, signkey): bitstring.
fun pk(signkey): vkey.
reduc forall m: bitstring, s: signkey; verify(sign(m, s), m, pk(s)) = true.

(* Public AD constants — these are emitted on the public channel by the
   daemon (tags are public). *)
free ad_red_v21:  ad.   (* fleet=red, project=red, round=v2.1 *)
free ad_def_v21:  ad.   (* fleet=def, project=def, round=v2.1 *)
free ad_audit_v21: ad.

(* The public channel is the daemon. Anything sent on `daemon` is in the
   attacker's pocket. *)
free daemon: channel.

(* The "key handover" channels are private and bounded — sec-eng-lead
   distributes fleet keys to personas at Gate A. We model this with
   private channels so the keys never appear on `daemon`. *)
free red_keychan:  channel [private].
free def_keychan:  channel [private].
free lead_keychan: channel [private].

(* --- Events for property (S3) ---------------------------------------------- *)

event RedWrites(bitstring).
event LeadEmitsToDefense(bitstring).
event DefenseLearnsRed(bitstring).

(* --- Secrets we ask ProVerif about ----------------------------------------- *)

free red_msg: bitstring [private].   (* the message the red persona sends in Phase 1 *)
free def_msg: bitstring [private].   (* the message the defense persona sends in Phase 2 *)

(* --- Queries --------------------------------------------------------------- *)

(* (S1) Red payload secrecy across Phase 1 — daemon never learns red_msg. *)
query attacker(red_msg).

(* (S2) Defense payload secrecy — daemon never learns def_msg. *)
query attacker(def_msg).

(* (S3) Defense only learns red plaintext via sec-eng-lead authenticated channel. *)
query x: bitstring;
  inj-event(DefenseLearnsRed(x)) ==> inj-event(LeadEmitsToDefense(x)).

(* --- Processes ------------------------------------------------------------- *)

(* RedPersona: receives the red fleet key on its private channel from the
   lead, then encrypts red_msg under it with the red AD, signs, and
   publishes the ciphertext to the daemon. *)
let RedPersona(rk: key, sk_red: signkey) =
  event RedWrites(red_msg);
  let ct = aenc(red_msg, rk, ad_red_v21) in
  let s  = sign(ct, sk_red) in
  out(daemon, (ct, s, pk(sk_red))).

(* DefensePersona: similarly, receives defense fleet key, encrypts def_msg
   under it with the defense AD, signs, publishes. *)
let DefensePersona(dk: key, sk_def: signkey) =
  let ct = aenc(def_msg, dk, ad_def_v21) in
  let s  = sign(ct, sk_def) in
  out(daemon, (ct, s, pk(sk_def))).

(* DefenseReceiver: a defense persona that listens for a sealed Gate-B
   bundle from the lead. It verifies the lead signature, decrypts under
   the defense fleet key with the *defense* AD, and emits a marker
   event indicating it has learned a red message. *)
let DefenseReceiver(dk: key, sk_lead_pub: vkey) =
  in(daemon, (gate_ct: bitstring, gate_sig: bitstring));
  if verify(gate_sig, gate_ct, sk_lead_pub) = true then
    let plain = adec(gate_ct, dk, ad_def_v21) in
    event DefenseLearnsRed(plain).

(* SecEngLead: holds both fleet keys + own signing key. At Gate B, it
   reads the (ct, sig, pk) tuple from the daemon, verifies the red
   signature, decrypts under the red fleet key with red AD, re-encrypts
   under the defense fleet key with defense AD, signs the bundle, and
   sends to defense via the daemon. *)
let SecEngLead(rk: key, dk: key, sk_lead: signkey, sk_red_pub: vkey) =
  in(daemon, (ct: bitstring, s: bitstring, pkr: vkey));
  if verify(s, ct, sk_red_pub) = true then
    let plain = adec(ct, rk, ad_red_v21) in
    event LeadEmitsToDefense(plain);
    let resealed = aenc(plain, dk, ad_def_v21) in
    let s2 = sign(resealed, sk_lead) in
    out(daemon, (resealed, s2)).

(* Top-level: lead generates everyone's keys, hands them out on private
   channels, then runs the personas + lead in parallel. The attacker
   (daemon) gets only what's published on `daemon`. *)
process
  new rk: key;
  new dk: key;
  new sk_red: signkey;
  new sk_def: signkey;
  new sk_lead: signkey;
  out(red_keychan, (rk, sk_red));
  out(def_keychan, (dk, sk_def));
  out(lead_keychan, (rk, dk, sk_lead, pk(sk_red), pk(sk_def)));
  (* The lead's pubkey is public (anyone can verify). *)
  out(daemon, pk(sk_lead));
  (
      ( in(red_keychan, (rk_p: key, sk_red_p: signkey)); RedPersona(rk_p, sk_red_p) )
    | ( in(def_keychan, (dk_p: key, sk_def_p: signkey)); DefensePersona(dk_p, sk_def_p) )
    | ( in(def_keychan, (dk_p2: key, _: signkey));      DefenseReceiver(dk_p2, pk(sk_lead)) )
    | ( in(lead_keychan, (rk_l: key, dk_l: key, sk_lead_p: signkey, pkr: vkey, pkd: vkey));
        SecEngLead(rk_l, dk_l, sk_lead_p, pkr) )
  )
