[0.006, "o", "\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m curl -sS http://127.0.0.1:19876/health\r\n{\"status\":\"ok\",\"service\":\"atlas-api\",\"port\":19876}\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd find 'porthole-service-proof:app:main'\r\n\r\nID                                 PORT    STATUS      URL\r\n───────────────────────────────────────────────────────────────────────────\r\nporthole-service-proof:app:main    19876   assigned    http://localhost:19876\r\n\r\nTotal: 1 service(s)\r\n\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd health 'porthole-service-proof:app:main'\r\nporthole-service-proof:app:main: healthy\r\n\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd down --dir . --yes\r\ndestructive: Down will SIGTERM the orchestrator (PID 2224) and stop every service it manages in .. Any unsaved in-process state is lost.\r\ndestructive: confirmation bypassed via --yes / PORT_DADDY_YES\r\n\u001b[9"]
