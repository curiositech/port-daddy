[0.005, "o", "\u001b[1m\u001b[38;5;221mENGINE◆\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m node -e 'const config=JSON.parse(require(\"node:fs\").readFileSync(\".portdaddyrc\",\"utf8\")); if (typeof config.project !== \"string\") process.exit(2); console.log(\"Configured project: \" + config.project)'\r\nConfigured project: porthole-service-proof\r\n\r\n\u001b[1m\u001b[38;5;221mENGINE◆\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd up --dir .\r\n\r\n  Config: .portdaddyrc\r\n  Detected 1 service(s):\r\n\r\n    api  local        → porthole-service-proof:app:main\r\n\r\n\u001b[90m│\r\n\u001b[34m●\u001b[39m  Starting: api\r\n\r\n  Claiming ports...\r\n    api  → 19876\r\n\r\n\u001b[36mapi\u001b[39m | atlas-api listening on 19876\r\n\u001b[90m│\r\n\u001b[32m◆\u001b[39m  api healthy (port 19876)\r\n\r\n\u001b[90m│\r\n\u001b[32m◆\u001b[39m  All 1 service(s) running. Press Ctrl+C to stop.\r\n  Dashboard: /\r\n\r\n\r\n\u001b[90m│\r\n\u001b[33m▲\u001b[39m  Shutting down...\r\n\r\n\u001b[90m│\r\n\u001b[33m▲\u001b[39m  All services stopped.\r\n\r\n\r\n"]
[0.000, "o", "\r\n"]
[0.005, "o", "\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m curl -sS http://127.0.0.1:19876/health\r\n{\"status\":\"ok\",\"service\":\"atlas-api\",\"port\":19876}\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd find 'porthole-service-proof:app:main'\r\n\r\nID                                 PORT    STATUS      URL\r\n───────────────────────────────────────────────────────────────────────────\r\nporthole-service-proof:app:main    19876   assigned    http://localhost:19876\r\n\r\nTotal: 1 service(s)\r\n\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd health 'porthole-service-proof:app:main'\r\nporthole-service-proof:app:main: healthy\r\n\r\n\u001b[1m\u001b[38;5;81mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd down --dir . --yes\r\ndestructive: Down will SIGTERM the orchestrator (PID 40006) and stop every service it manages in .. Any unsaved in-process state is lost.\r\ndestructive: confirmation bypassed via --yes / PORT_DADDY_YES\r\n\u001b["]
[0.000, "o", "90m│\r\n\u001b[33m▲\u001b[39m  Stopping port-daddy up (PID 40006)...\r\n\u001b[90m│\r\n\u001b[32m◆\u001b[39m  Stopped.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"]
