[0.005, "o", "\u001b[1m\u001b[36mENGINE◆\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd up --dir .\r\n\r\n  Config: .portdaddyrc\r\n  Detected 1 service(s):\r\n\r\n    api  local        → service-proof:app:main\r\n\r\n\u001b[90m│\r\n\u001b[34m●\u001b[39m  Starting: api\r\n\r\n  Claiming ports...\r\n    api  → 19876\r\n\r\n\u001b[36mapi\u001b[39m | atlas-api listening on 19876\r\n\u001b[90m│\r\n\u001b[32m◆\u001b[39m  api healthy (port 19876)\r\n\r\n\u001b[90m│\r\n\u001b[32m◆\u001b[39m  All 1 service(s) running. Press Ctrl+C to stop.\r\n  Dashboard: /\r\n\r\n\r\n\u001b[90m│\r\n\u001b[33m▲\u001b[39m  Shutting down...\r\n\r\n\u001b[90m│\r\n\u001b[33m▲\u001b[39m  All services stopped.\r\n\r\n\r\n\r\n\r\n\r\n"]
[0.001, "o", "\r\n"]
[0.004, "o", "\u001b[1m\u001b[36mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m curl -sS http://127.0.0.1:19876/health\r\n{\"status\":\"ok\",\"service\":\"atlas-api\",\"port\":19876}\r\n\u001b[1m\u001b[36mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd find porthole-service-proof\r\nNo services found\r\n\r\nHint: To find all services for \"porthole-service-proof\", try:\r\n  port-daddy find 'porthole-service-proof:*'\r\n\r\nRemember to quote wildcards to prevent shell expansion.\r\n\r\n\u001b[1m\u001b[36mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd health\r\n\r\nSystem Status: \u001b[32mNOMINAL\r\n\u001b[39m──────────────────────────────────────────────────\r\nDaemon:   Online (PID 26729)\r\nUptime:   235m 45s\r\n\r\n\r\n\u001b[1m\u001b[36mBRIDGE◇\u001b[0m \u001b[1m\u001b[32m❯\u001b[0m pd down --dir . --yes\r\ndestructive: Down will SIGTERM the orchestrator (PID 9243) and stop every service it manages in .. Any unsaved in-process state is lost.\r\ndestructive: confirmation bypassed via --yes / PORT_DADDY_YES\r\n\u001b[90m│\r\n\u001b[33m▲\u001b[39m  Stopping port-daddy up (PID 9243)...\r\n\u001b[90m│\r"]
