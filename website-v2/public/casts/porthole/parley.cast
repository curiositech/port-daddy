[0.000, "o", "\u001b[6;1H  \u001b[38;5;117msurface   \u001b[39m src/checkout.ts\r\n  \u001b[38;5;117mstate     \u001b[39m CONVENED\r\n  \u001b[38;5;117mparties   \u001b[39m agent-bind-checkout-retry-safety-ac3293ba, agent-challeng\r\ne-checkout-ownership-e36fa072, agent-settle-checkout-ownership-6578506\r\nf\r\n  \u001b[38;5;117mmissing   \u001b[39m none\u001b[13;1H  \u001b[38;5;114mDECISION PATH (6)\r\n\u001b[39m  01 · \u001b[1mopening position\u001b(B\u001b[m · agent-settle-checkout-ownership-6578506f\r\n       I own checkout flow. Capture funds first, then authorize fulfil\r\nlment; rollback remains bounded.\u001b[24;72H"]
