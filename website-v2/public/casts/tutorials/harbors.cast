[2.952998, "o", "  \r\n    Harbors (1):\r\n  \r\n    port-daddy:fleet  (20 members, expires: never)\r\n      capabilities: gardener, qa, test-hunter, documentarian, simplifier, cartographer, spark, purser, spider, lookout, snipe, tender, shipwright, code-reviewer, red-team, test-author, tautology-sniffer, tenderfoot, officer-of-the-watch, harbor-pilot, steward\r\n      channels:     git:committed, promotion:release-surfaces, spark:idea, spider:connections, coordination:inconsistency, pull_request:opened, pull_request:synchronize, pull_request:merged, pull_request:finding-high, git:status, qa:clean, qa:findings, developer-generalization:health\r\n      members:      port-daddy:fleet:gardener, port-daddy:fleet:qa, port-daddy:fleet:test-hunter, port-daddy:fleet:documentarian, port-daddy:fleet:simplifier, port-daddy:fleet:cartographer, port-daddy:fleet:spark, port-daddy:fleet:spider, port-daddy:fleet:lookout-pr, port-daddy:fleet:snipe, port-daddy:fleet:tender, port-daddy:fleet:shipwright, port-daddy:fleet:code-reviewer, port-daddy:fleet:red-team, port-daddy:fleet:test-author, port-daddy:fleet:tautology-sniffer, port-daddy:fleet:tenderfoot, port-daddy:fleet:officer-of-the-watch, port-daddy:fleet:harbor-pilot, port-daddy:fleet:steward\r\n"]
