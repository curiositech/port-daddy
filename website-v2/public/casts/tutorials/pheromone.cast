[3.609, "o", "  Usage: pd pheromone <spray|file|files|show|ls> [args]\r\n  \r\n  Subcommands:\r\n    spray <table> <id> <key> <strength>   Set a pheromone (0..1)\r\n    file <path> <strength>                Sugar for files/<path>/heat\r\n    files [--path P] [--depth N]          File heat map\r\n    show <table> <id>                     Read pheromones for entity\r\n    ls                                    List all non-zero pheromones\r\n  \r\n  Tables: files, services, projects, sessions, agents\r\n"]
