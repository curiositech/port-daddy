[4.234554, "o", "  Usage: pd spawn --backend <backend> -- <task>\r\n         pd spawn --backend claude -- \"Write a hello world program\"\r\n  \r\n  Backends: cli:claude-code, cli:codex, cli:agy, cli:gemini, cli:groq, cli:grok, claude-cli, claude, gemini, cloudflare, openai, groq, codex, deepseek, xai, ollama, lmstudio, aider, custom\r\n  \r\n  Options:\r\n    --backend <name>      AI backend to use (default: ollama)\r\n    --model <name>        Model override\r\n    --tier <level>        Model tier override (low, mid, high)\r\n    --identity <id>       PD semantic identity (project:stack:context)\r\n    --purpose <text>      Human-readable task description\r\n    --budget <usd>        Required spend ceiling for this launch\r\n    --allowedTools <str>  Tool permissions for claude-cli backend\r\n    --maxTokens <n>       Max tokens for claude/claude-cli backends"]
[4.23469, "o", "\r\n    --inject-squid-hooks  Install Giant Squid tentacles before launching supported CLI backends\r\n    -j, --json            JSON output\r\n    -q, --quiet           Suppress output\r\n"]
