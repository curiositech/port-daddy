[0.631, "o", "  # pd-fleet.yml — Port Daddy's own fleet configuration\r\n  #\r\n  # This file declares the background agents that help develop Port Daddy.\r\n  # Run with: pd fleet up\r\n  #\r\n  # Backend is configurable per agent.\r\n  # Pin `model:` whenever your backend supports it so fleet costs are predictable.\r\n  # This checked-in fleet only pins launch-ready, exact-telemetry runtimes for\r\n  # LLM-powered agents. Use Fleet Control Center to bulk switch the runtime when\r\n  # another backend is setup and ready.\r\n  \r\n  fleet:\r\n    # Name must match `basename(projectDir)` so the post-commit hook's\r\n    # `project:<basename>:<hash>:git:committed` channel matches what\r\n    # `lib/fleet-channels.ts` subscribes on (slug = fleet.name). Renaming\r\n    # this field breaks every git:committed-triggered agent silently.\r\n    name: port-daddy\r\n    harbor: \"{project}:fleet\"\r\n"]
