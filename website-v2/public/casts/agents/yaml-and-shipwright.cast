[0.017, "o", "\r\n"]
[0.592, "o", "  # pd-fleet.yml — Port Daddy's own fleet configuration\r\n  #\r\n  # This file declares the background agents that help develop Port Daddy.\r\n  # Run with: pd fleet up\r\n  #\r\n  # Backend is configurable per agent.\r\n  # Pin `model:` whenever your backend supports it so fleet costs are predictable.\r\n  # This fleet is intentionally local-first: Ollama for background cognition,\r\n  # Codex mini for code-changing agents, and custom for non-LLM jobs.\r\n  \r\n  fleet:\r\n    # Name must match `basename(projectDir)` so the post-commit hook's\r\n    # `project:<basename>:<hash>:git:committed` channel matches what\r\n    # `lib/fleet-channels.ts` subscribes on (slug = fleet.name). Renaming\r\n    # this field breaks every git:committed-triggered agent silently.\r\n"]
[0.000, "o", "    name: port-daddy\r\n    harbor: \"{project}:fleet\"\r\n  \r\n"]
[0.456, "o", "\r\n  \u001b[0;90mrecorded from real Port Daddy CLI commands\u001b[0m\r\n"]
[1.009, "x", "0"]
