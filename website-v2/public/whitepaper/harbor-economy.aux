\@writefile{toc}{\contentsline {subsection}{\numberline {12.1}Static escrow vs.\ competitive underwriting}{24}{subsection.12.1}\protected@file@percent }
\newlabel{sec:fh-equilibria}{{12.1}{24}{Static escrow vs.\ competitive underwriting}{subsection.12.1}{}}
\newlabel{sec:youle:welfare}{{12.1}{24}{Static escrow vs.\ competitive underwriting}{subsection.12.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Static escrow vs.\ competitive Vickrey auction. Both regimes underwrite the same coverage $B_T = \mu (1+s)$; only the financing mechanism differs. In (a) the principal ties up $B_T$ for the coverage period, paying an opportunity cost $r \cdot B_T$. In (b) insurers compete; the principal pays only the second-lowest bid $q^*$. The competitive regime Pareto-dominates the static one under the welfare assumptions of \S  \ref {sec:youle:welfare} below.}}{24}{figure.caption.24}\protected@file@percent }
\newlabel{fig:auction-inline}{{12}{24}{Static escrow vs.\ competitive Vickrey auction. Both regimes underwrite the same coverage $B_T = \mu (1+s)$; only the financing mechanism differs. In (a) the principal ties up $B_T$ for the coverage period, paying an opportunity cost $r \cdot B_T$. In (b) insurers compete; the principal pays only the second-lowest bid $q^*$. The competitive regime Pareto-dominates the static one under the welfare assumptions of \S \ref {sec:youle:welfare} below}{figure.caption.24}{}}
\newlabel{prop:reserve}{{12.1}{24}{Underwriting reframes the bond as reserve adequacy}{proposition.12.1}{}}
