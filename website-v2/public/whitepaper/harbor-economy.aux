\citation{spivak2012}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Conservation as a (lax) functor. Within a single unit of account the map $F:\mathbf  {Harbor}\to \mathbf  {Federation}$ is a \emph  {conservative functor}: it preserves the composition of settlement morphisms, so the per-harbor invariant $\text  {wallet}+\text  {escrow}+\text  {commons}=\text  {supply}$ lifts exactly to the federation (proven). The moment harbors price bonds in heterogeneous units, $F$ is at most a \emph  {lax} functor --- conservation is preserved only up to the bounded-escrow slack $\varphi $, and the coherence conditions are unproven. The headline ``conservation composes upward'' is licensed \emph  {only} with this scope rider. The three cross-harbor open problems (settlement, equivocation, unit-of- account) are one sheaf-gluing obstruction in disguise; the double-spend race is literally the non-vanishing of the first cohomology $H^1$ of the gluing.}}{13}{figure.caption.12}\protected@file@percent }
\newlabel{fig:he-conservation-functor}{{5}{13}{Conservation as a (lax) functor. Within a single unit of account the map $F:\mathbf {Harbor}\to \mathbf {Federation}$ is a \emph {conservative functor}: it preserves the composition of settlement morphisms, so the per-harbor invariant $\text {wallet}+\text {escrow}+\text {commons}=\text {supply}$ lifts exactly to the federation (proven). The moment harbors price bonds in heterogeneous units, $F$ is at most a \emph {lax} functor --- conservation is preserved only up to the bounded-escrow slack $\varphi $, and the coherence conditions are unproven. The headline ``conservation composes upward'' is licensed \emph {only} with this scope rider. The three cross-harbor open problems (settlement, equivocation, unit-of- account) are one sheaf-gluing obstruction in disguise; the double-spend race is literally the non-vanishing of the first cohomology $H^1$ of the gluing}{figure.caption.12}{}}
\newlabel{thm:functor}{{7.1}{13}{Single-unit federation is a conservative functor}{theorem.7.1}{}}
\newlabel{thm:lax}{{7.2}{13}{Multi-currency federation is at most lax}{theorem.7.2}{}}
