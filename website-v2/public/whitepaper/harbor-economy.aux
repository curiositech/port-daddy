\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Cross-harbor settlement protocol. The escrow is a third party in the sense that neither $A$ nor $B$ alone can compel an outcome, but it is \emph  {not} a trusted third party in the operational sense: the protocol restricts its decision space to two outcomes (clear or refuse) and prices its maximum extractable fee $\phi $ up front. Redirecting funds, equivocating about a clearing decision, or delaying past TTL are structurally forbidden by the property checks in Theorem~\ref {thm:fh-escrow-bound}. The escrow is a \emph  {bounded} third party --- the bond it holds plus the cap on $\phi $ make its misbehavior bounded-loss rather than catastrophic.}}{19}{figure.caption.18}\protected@file@percent }
\newlabel{fig:fh-settlement}{{8}{19}{Cross-harbor settlement protocol. The escrow is a third party in the sense that neither $A$ nor $B$ alone can compel an outcome, but it is \emph {not} a trusted third party in the operational sense: the protocol restricts its decision space to two outcomes (clear or refuse) and prices its maximum extractable fee $\phi $ up front. Redirecting funds, equivocating about a clearing decision, or delaying past TTL are structurally forbidden by the property checks in Theorem~\ref {thm:fh-escrow-bound}. The escrow is a \emph {bounded} third party --- the bond it holds plus the cap on $\phi $ make its misbehavior bounded-loss rather than catastrophic}{figure.caption.18}{}}
\newlabel{conj:trustless}{{9.1}{19}{Trustless cross-harbor settlement}{conjecture.9.1}{}}
\newlabel{thm:fh-escrow-bound}{{9.1}{19}{Trustless cross-harbor settlement}{conjecture.9.1}{}}
