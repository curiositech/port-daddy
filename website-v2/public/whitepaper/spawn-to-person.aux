\@writefile{toc}{\contentsline {paragraph}{The rate-the-raters recursion --- does it terminate?}{27}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {The rate-the-raters recursion.} Bond-and-slash pushes the grading problem up a level: who audits the auditors? Under sampling, a slash exceeding the maximum bribe, and a conflict-free re-auditor pool larger than any clique, the incentive to corrupt each level is strictly smaller than the level below --- making the tower contractive with a finite honest fixed point. This is the precise statement of what Paper~4's central IC theorem needs and currently lacks.}}{28}{figure.caption.22}\protected@file@percent }
\newlabel{fig:rate-raters}{{12}{28}{\textbf {The rate-the-raters recursion.} Bond-and-slash pushes the grading problem up a level: who audits the auditors? Under sampling, a slash exceeding the maximum bribe, and a conflict-free re-auditor pool larger than any clique, the incentive to corrupt each level is strictly smaller than the level below --- making the tower contractive with a finite honest fixed point. This is the precise statement of what Paper~4's central IC theorem needs and currently lacks}{figure.caption.22}{}}
\newlabel{conj:contract}{{11.1}{28}{Contractive re-audit}{conjecture.11.1}{}}
