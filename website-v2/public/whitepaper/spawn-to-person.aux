\citation{zheng2023judging}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Multi-dimensional reputation.} A witnessed outcome carries a quality \emph  {vector} $\mathbf  {q}=(q_{\text  {acc}},q_{\text  {aes}}, q_{\text  {eff}})$. Each axis is scored by a \emph  {different} competent judge: a test oracle for accuracy, a senior reviewer for aesthetics, the cost meter for efficiency. The buyer reads the vector and applies their own weights --- which is exactly what avoids collapsing quality into one Goodhart-able scalar.}}{24}{figure.caption.17}\protected@file@percent }
\newlabel{fig:multidim}{{10}{24}{\textbf {Multi-dimensional reputation.} A witnessed outcome carries a quality \emph {vector} $\mathbf {q}=(q_{\text {acc}},q_{\text {aes}}, q_{\text {eff}})$. Each axis is scored by a \emph {different} competent judge: a test oracle for accuracy, a senior reviewer for aesthetics, the cost meter for efficiency. The buyer reads the vector and applies their own weights --- which is exactly what avoids collapsing quality into one Goodhart-able scalar}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {10.2}The neutral-judge market (the harbor's universities and rating agencies)}{24}{subsection.10.2}\protected@file@percent }
