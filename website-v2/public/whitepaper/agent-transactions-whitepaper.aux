\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Magic-link single-use atomicity. The SQL \texttt  {UPDATE \dots  WHERE consumed\_at IS NULL RETURNING} is the runtime analogue of the ProVerif private-channel cap: SQLite serializes concurrent writers, so the first caller drains the cap and the second consumer's transaction returns zero rows. Verified properties: injective single-use ($\mathrm  {inj\text  {-}event}(\texttt  {consumed\_for}) \Rightarrow \mathrm  {inj\text  {-}event}(\texttt  {issued\_for})$) and binding.}}{36}{figure.caption.67}\protected@file@percent }
\newlabel{fig:magic-link-inline}{{8}{36}{Magic-link single-use atomicity. The SQL \texttt {UPDATE \dots WHERE consumed\_at IS NULL RETURNING} is the runtime analogue of the ProVerif private-channel cap: SQLite serializes concurrent writers, so the first caller drains the cap and the second consumer's transaction returns zero rows. Verified properties: injective single-use ($\mathrm {inj\text {-}event}(\texttt {consumed\_for}) \Rightarrow \mathrm {inj\text {-}event}(\texttt {issued\_for})$) and binding}{figure.caption.67}{}}
\newlabel{thm:federated-security}{{12.1}{36}{Federated Security, informal}{theorem.12.1}{}}
