\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.9}A5 --- Sybil deterrence is coverage-bounded}{29}{subsubsection.7.5.9}\protected@file@percent }
\newlabel{sec:youle:a5}{{7.5.9}{29}{A5 --- Sybil deterrence is coverage-bounded}{subsubsection.7.5.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm  {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm  {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}.}}{29}{figure.caption.53}\protected@file@percent }
\newlabel{fig:sybil-inline}{{5}{29}{Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}}{figure.caption.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm  {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm  {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm  {kyc}}$ + reputation gating + per-class $B_{\mathrm  {dep}}$); pure deposit-based deterrence is provably insufficient.}}{30}{figure.caption.54}\protected@file@percent }
\newlabel{fig:sybil-mc-inline}{{6}{30}{A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm {kyc}}$ + reputation gating + per-class $B_{\mathrm {dep}}$); pure deposit-based deterrence is provably insufficient}{figure.caption.54}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.10}A6 --- Cartel sustainability under the folk theorem}{30}{subsubsection.7.5.10}\protected@file@percent }
\newlabel{sec:youle:a6}{{7.5.10}{30}{A6 --- Cartel sustainability under the folk theorem}{subsubsection.7.5.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cartel repeated-game node under the supplied grim-trigger model. Each round a member maintains the floor or undercuts it by $\varepsilon $. Detection occurs before the current-round payoff and applies loss $L$; a one-shot deviation takes $\pi _D$ and ends the cartel stream. The displayed recurrence is specific to that event timing and payoff model.}}{31}{figure.caption.55}\protected@file@percent }
\newlabel{fig:cartel-game-inline}{{7}{31}{Cartel repeated-game node under the supplied grim-trigger model. Each round a member maintains the floor or undercuts it by $\varepsilon $. Detection occurs before the current-round payoff and applies loss $L$; a one-shot deviation takes $\pi _D$ and ends the cartel stream. The displayed recurrence is specific to that event timing and payoff model}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces A6 --- Repeated-game cartel calculation. Left: sustainability over the tested $(p_d,\delta )$ grid under the supplied grim-trigger payoff model; cobalt cells satisfy that model's cartel inequality and white cells do not. Black bars mark the grid crossing. Right: simulated rounds to first detection. At $\delta =0.95$ the analytical threshold is $p_d^\star \approx 0.0478$ and the grid first flips at $0.05$; neither value transfers to a different payoff, event timing, or monitoring model without re-derivation.}}{32}{figure.caption.56}\protected@file@percent }
