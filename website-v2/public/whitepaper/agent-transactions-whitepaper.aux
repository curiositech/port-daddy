\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.9}A5 --- Sybil deterrence is coverage-bounded}{28}{subsubsection.7.5.9}\protected@file@percent }
\newlabel{sec:youle:a5}{{7.5.9}{28}{A5 --- Sybil deterrence is coverage-bounded}{subsubsection.7.5.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm  {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm  {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}.}}{28}{figure.caption.49}\protected@file@percent }
\newlabel{fig:sybil-inline}{{5}{28}{Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}}{figure.caption.49}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm  {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm  {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm  {kyc}}$ + reputation gating + per-class $B_{\mathrm  {dep}}$); pure deposit-based deterrence is provably insufficient.}}{29}{figure.caption.50}\protected@file@percent }
\newlabel{fig:sybil-mc-inline}{{6}{29}{A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm {kyc}}$ + reputation gating + per-class $B_{\mathrm {dep}}$); pure deposit-based deterrence is provably insufficient}{figure.caption.50}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.10}A6 --- Cartel sustainability under the folk theorem}{29}{subsubsection.7.5.10}\protected@file@percent }
\newlabel{sec:youle:a6}{{7.5.10}{29}{A6 --- Cartel sustainability under the folk theorem}{subsubsection.7.5.10}{}}
