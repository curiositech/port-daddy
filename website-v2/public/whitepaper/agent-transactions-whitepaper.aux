\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.9}A5 --- Sybil deterrence is coverage-bounded}{27}{subsubsection.7.5.9}\protected@file@percent }
\newlabel{sec:youle:a5}{{7.5.9}{27}{A5 --- Sybil deterrence is coverage-bounded}{subsubsection.7.5.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm  {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm  {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}.}}{27}{figure.caption.46}\protected@file@percent }
\newlabel{fig:sybil-inline}{{4}{27}{Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm {dep}} \geq B_T$ additional deposit provides no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-mc-inline}}{figure.caption.46}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm  {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm  {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm  {kyc}}$ + reputation gating + per-class $B_{\mathrm  {dep}}$); pure deposit-based deterrence is provably insufficient.}}{28}{figure.caption.47}\protected@file@percent }
\newlabel{fig:sybil-mc-inline}{{5}{28}{A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm {kyc}}$ + reputation gating + per-class $B_{\mathrm {dep}}$); pure deposit-based deterrence is provably insufficient}{figure.caption.47}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {7.5.10}A6 --- Cartel sustainability under the folk theorem}{28}{subsubsection.7.5.10}\protected@file@percent }
\newlabel{sec:youle:a6}{{7.5.10}{28}{A6 --- Cartel sustainability under the folk theorem}{subsubsection.7.5.10}{}}
\citation{owens2026anchor}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Cartel repeated-game node under the grim-trigger strategy. Each round a colluding member chooses between maintaining the floor $q_{\mathrm  {floor}}$ or undercutting it by $\varepsilon $. Detection probability $p_d$ slashes the colluder; one-shot defection takes the $\pi _D$ gain once and forfeits future $\pi _C$ stream. The sustainability inequality on the right reduces to the closed-form threshold $p_d^\star $ used in Figure~\ref {fig:cartel-folk}.}}{29}{figure.caption.48}\protected@file@percent }
\newlabel{fig:cartel-game-inline}{{6}{29}{Cartel repeated-game node under the grim-trigger strategy. Each round a colluding member chooses between maintaining the floor $q_{\mathrm {floor}}$ or undercutting it by $\varepsilon $. Detection probability $p_d$ slashes the colluder; one-shot defection takes the $\pi _D$ gain once and forfeits future $\pi _C$ stream. The sustainability inequality on the right reduces to the closed-form threshold $p_d^\star $ used in Figure~\ref {fig:cartel-folk}}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces A6 --- Repeated-game cartel folk-theorem. Left: sustainability map over the $(p_d, \delta )$ grid; red cells are configurations where the grim-trigger cartel beats one-shot defection in expected PV (sustainable), white cells are where it does not (collapses). The thick black vertical bars mark the per-row threshold $p_d^\star $. Right: mean cartel lifespan (rounds until first detection) vs.\ $p_d$, one line per discount factor $\delta $. At the realistic $\delta = 0.95$, $p_d^\star \approx 0.10$: protocols must achieve $\ge 10\%$ per-round detection to break repeated-game cartels.}}{29}{figure.caption.49}\protected@file@percent }
\newlabel{fig:cartel-folk}{{7}{29}{A6 --- Repeated-game cartel folk-theorem. Left: sustainability map over the $(p_d, \delta )$ grid; red cells are configurations where the grim-trigger cartel beats one-shot defection in expected PV (sustainable), white cells are where it does not (collapses). The thick black vertical bars mark the per-row threshold $p_d^\star $. Right: mean cartel lifespan (rounds until first detection) vs.\ $p_d$, one line per discount factor $\delta $. At the realistic $\delta = 0.95$, $p_d^\star \approx 0.10$: protocols must achieve $\ge 10\%$ per-round detection to break repeated-game cartels}{figure.caption.49}{}}
