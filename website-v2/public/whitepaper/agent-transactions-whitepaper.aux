\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Magic-link single-use atomicity. The SQL \texttt  {UPDATE \dots  WHERE consumed\_at IS NULL RETURNING} is the runtime analogue of the ProVerif private-channel cap: SQLite serializes concurrent writers, so the first caller drains the cap and the second consumer's transaction returns zero rows. Verified properties: injective single-use ($\mathrm  {inj\text  {-}event}(\texttt  {consumed\_for}) \Rightarrow \mathrm  {inj\text  {-}event}(\texttt  {issued\_for})$) and binding.}}{26}{figure.caption.44}\protected@file@percent }
\newlabel{fig:magic-link-diag}{{1}{26}{Magic-link single-use atomicity. The SQL \texttt {UPDATE \dots WHERE consumed\_at IS NULL RETURNING} is the runtime analogue of the ProVerif private-channel cap: SQLite serializes concurrent writers, so the first caller drains the cap and the second consumer's transaction returns zero rows. Verified properties: injective single-use ($\mathrm {inj\text {-}event}(\texttt {consumed\_for}) \Rightarrow \mathrm {inj\text {-}event}(\texttt {issued\_for})$) and binding}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Multi-hop delegation walker. Each hop $k$ signs a binding tuple $(n_k, \mathrm  {id}_{k-1}, \mathrm  {id}_k, h)$ under Ed25519, where $h$ is the message hash that must remain constant across the chain. The walker verifies depth-$N$ chains with a nonce-freshness table and rejects splices, replays, hop-swaps, and substitution.}}{26}{figure.caption.45}\protected@file@percent }
\newlabel{fig:delegation-diag}{{2}{26}{Multi-hop delegation walker. Each hop $k$ signs a binding tuple $(n_k, \mathrm {id}_{k-1}, \mathrm {id}_k, h)$ under Ed25519, where $h$ is the message hash that must remain constant across the chain. The walker verifies depth-$N$ chains with a nonce-freshness table and rejects splices, replays, hop-swaps, and substitution}{figure.caption.45}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cuckoo filter (Fan et al.~\cite  {fan2014cuckoo}). 8-bit fingerprints, 4 entries per bucket, partial-key cuckoo hashing. Insert lands at either of two candidate buckets $i_1, i_2 = i_1 \oplus h(\mathrm  {fp})$; on full, evict and re-insert at the kicked fingerprint's alternate. The runtime caps load factor at $0.95$ to keep occupancy inside the regime where the false-positive bound holds.}}{27}{figure.caption.46}\protected@file@percent }
\newlabel{fig:cuckoo-diag}{{3}{27}{Cuckoo filter (Fan et al.~\cite {fan2014cuckoo}). 8-bit fingerprints, 4 entries per bucket, partial-key cuckoo hashing. Insert lands at either of two candidate buckets $i_1, i_2 = i_1 \oplus h(\mathrm {fp})$; on full, evict and re-insert at the kicked fingerprint's alternate. The runtime caps load factor at $0.95$ to keep occupancy inside the regime where the false-positive bound holds}{figure.caption.46}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Static escrow vs.\ competitive Vickrey auction (\S  \ref {sec:youle:welfare}). Both regimes underwrite the same coverage $B_T = \mu (1+s)$; only the financing mechanism differs. In (a) the principal ties up $B_T$ for the coverage period, paying an opportunity cost $r \cdot B_T$. In (b) insurers compete; the principal pays only the second-lowest bid $q^*$.}}{27}{figure.caption.47}\protected@file@percent }
\newlabel{fig:auction-diag}{{4}{27}{Static escrow vs.\ competitive Vickrey auction (\S \ref {sec:youle:welfare}). Both regimes underwrite the same coverage $B_T = \mu (1+s)$; only the financing mechanism differs. In (a) the principal ties up $B_T$ for the coverage period, paying an opportunity cost $r \cdot B_T$. In (b) insurers compete; the principal pays only the second-lowest bid $q^*$}{figure.caption.47}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Cartel repeated-game node under the grim-trigger strategy. Each round a colluding member chooses between maintaining the floor $q_{\mathrm  {floor}}$ or undercutting it by $\varepsilon $. Detection probability $p_d$ slashes the colluder; one-shot defection takes the $\pi _D$ gain once and forfeits future $\pi _C$ stream. The sustainability inequality on the right reduces to the closed-form threshold $p_d^\star $ used in Figure~\ref {fig:cartel-folk}.}}{28}{figure.caption.48}\protected@file@percent }
\newlabel{fig:cartel-game-diag}{{5}{28}{Cartel repeated-game node under the grim-trigger strategy. Each round a colluding member chooses between maintaining the floor $q_{\mathrm {floor}}$ or undercutting it by $\varepsilon $. Detection probability $p_d$ slashes the colluder; one-shot defection takes the $\pi _D$ gain once and forfeits future $\pi _C$ stream. The sustainability inequality on the right reduces to the closed-form threshold $p_d^\star $ used in Figure~\ref {fig:cartel-folk}}{figure.caption.48}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm  {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm  {dep}} \geq B_T$ extra deposit gives no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-deposit-floor}.}}{28}{figure.caption.49}\protected@file@percent }
\newlabel{fig:sybil-diag}{{6}{28}{Sybil attack flow. The attacker spawns $K$ Sybil identities, each posting deposit $B_{\mathrm {dep}}$, then undercuts honest bids by $\varepsilon $ and defaults on loss. The protocol confiscates the Sybil's deposit on default, but the slash amount is capped at the coverage $B_T$ --- so beyond $B_{\mathrm {dep}} \geq B_T$ extra deposit gives no extra deterrence. Empirically demonstrated in Figure~\ref {fig:sybil-deposit-floor}}{figure.caption.49}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C}Monte Carlo Visualizations}{28}{appendix.C}\protected@file@percent }
\newlabel{app:montecarlo}{{C}{28}{Monte Carlo Visualizations}{appendix.C}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Pareto dominance of competitive auction over static escrow. Left: dominance rate as a function of reputation noise $\sigma _r$ at $n=5$ insurers, split by cartel size. Dominance holds robustly with no cartel even at $\sigma _r = 0.5$; with 3 colluders it collapses past $\sigma _r \approx 0.1$. Right: dominance rate vs.\ $n$ at $\sigma _r = 0$ and no cartel; $n=3$ is the empirical optimum due to the winner's-curse order-statistic effect noted in \S  \ref {sec:youle:welfare}.}}{29}{figure.caption.50}\protected@file@percent }
\newlabel{fig:pareto-dominance}{{7}{29}{Pareto dominance of competitive auction over static escrow. Left: dominance rate as a function of reputation noise $\sigma _r$ at $n=5$ insurers, split by cartel size. Dominance holds robustly with no cartel even at $\sigma _r = 0.5$; with 3 colluders it collapses past $\sigma _r \approx 0.1$. Right: dominance rate vs.\ $n$ at $\sigma _r = 0$ and no cartel; $n=3$ is the empirical optimum due to the winner's-curse order-statistic effect noted in \S \ref {sec:youle:welfare}}{figure.caption.50}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm  {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm  {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm  {kyc}} +$ reputation gating $+$ per-class $B_{\mathrm  {dep}}$); pure deposit-based deterrence is provably insufficient.}}{29}{figure.caption.51}\protected@file@percent }
\newlabel{fig:sybil-deposit-floor}{{8}{29}{A5 --- Sybil attack: deposit-only deterrence has a coverage-bounded ceiling. Left: attacker net profit per 50-transaction trial stays positive across the entire deposit sweep ($B_{\mathrm {dep}} \in [0.5, 1000]$ USD). Right: commons deficit converges to zero around $B_{\mathrm {dep}} \approx 200$ USD --- the protocol is fully reimbursed, but the attacker still profits because deposit slash is capped at coverage $B_T = \mu (1+s)$. Closing A5 requires a composite mechanism ($C_{\mathrm {kyc}} +$ reputation gating $+$ per-class $B_{\mathrm {dep}}$); pure deposit-based deterrence is provably insufficient}{figure.caption.51}{}}
