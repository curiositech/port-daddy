\citation{ietf2024jwtbcp}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Capability attenuation under delegation. Each child capability is a strict subset of its parent's (rights and TTL both shrink monotonically). AgentB inherits only what AgentA explicitly delegates, and cannot re-grant capabilities it does not hold. This is enforced both at issuance (parent signs over the child's attenuated claim set) and at verification (the verifier checks the chain of \texttt  {is\_subset} relations).}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:anchor-capability-attenuation}{{2}{4}{Capability attenuation under delegation. Each child capability is a strict subset of its parent's (rights and TTL both shrink monotonically). AgentB inherits only what AgentA explicitly delegates, and cannot re-grant capabilities it does not hold. This is enforced both at issuance (parent signs over the child's attenuated claim set) and at verification (the verifier checks the chain of \texttt {is\_subset} relations)}{figure.caption.3}{}}
