\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Multi-hop delegation walker (Phase~3). Each hop $k$ signs the binding tuple $(n_k, \mathrm  {id}_{k-1}, \mathrm  {id}_k, h)$ under Ed25519. The walker verifies depth-$N$ chains with a nonce-freshness table and rejects splices, replays, hop-swaps, and substitution. Runtime: \texttt  {lib/delegation-chain.ts}; conformance test: 17 / 17.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:anchor-delegation-diag}{{1}{14}{Multi-hop delegation walker (Phase~3). Each hop $k$ signs the binding tuple $(n_k, \mathrm {id}_{k-1}, \mathrm {id}_k, h)$ under Ed25519. The walker verifies depth-$N$ chains with a nonce-freshness table and rejects splices, replays, hop-swaps, and substitution. Runtime: \texttt {lib/delegation-chain.ts}; conformance test: 17 / 17}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cuckoo filter revocation gate (Fan et al.~\cite  {fan2014cuckoo}) with the v2.6 load-factor ceiling defeating the pollution attack. Insert lands at either of two candidate buckets $i_1, i_2 = i_1 \oplus h(\mathrm  {fp})$; on full, evict and re-insert at the kicked fingerprint's alternate. Insert rejection at $0.95$ caps occupancy inside the regime where the false-positive bound holds.}}{15}{figure.caption.11}\protected@file@percent }
\newlabel{fig:anchor-cuckoo-diag}{{2}{15}{Cuckoo filter revocation gate (Fan et al.~\cite {fan2014cuckoo}) with the v2.6 load-factor ceiling defeating the pollution attack. Insert lands at either of two candidate buckets $i_1, i_2 = i_1 \oplus h(\mathrm {fp})$; on full, evict and re-insert at the kicked fingerprint's alternate. Insert rejection at $0.95$ caps occupancy inside the regime where the false-positive bound holds}{figure.caption.11}{}}
