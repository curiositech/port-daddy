\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The three Harbor Card phases. Each phase is a refinement of the previous, both in capability and in adversary model. Phase~1 (HS256) is a teaching baseline; Phase~2 (Ed25519) removes the shared-secret trust boundary; Phase~3 (delegation) adds capability attenuation across an agent chain. All three are mechanized in ProVerif (\S  \ref {app:mech}).}}{3}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:anchor-phases}{{1}{3}{The three Harbor Card phases. Each phase is a refinement of the previous, both in capability and in adversary model. Phase~1 (HS256) is a teaching baseline; Phase~2 (Ed25519) removes the shared-secret trust boundary; Phase~3 (delegation) adds capability attenuation across an agent chain. All three are mechanized in ProVerif (\S \ref {app:mech})}{figure.caption.2}{}}
\citation{cve20159235}
