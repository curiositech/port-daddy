\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Gossip-synchronized revocation across a five-daemon mesh. At $t=0$ daemon~A locally revokes a Harbor Card (its filter and revocation table). Anti-entropy gossip ships deltas to two random peers every 30\,s, reaching all daemons in $O(\log m)$ rounds. For a ten-daemon mesh this gives global propagation in $\approx 2$\,minutes, well inside the MTTR window where leaked cards remain economically useful. Version vectors guarantee convergence even under reordered or duplicated delta deliveries.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:anchor-revocation-gossip}{{6}{9}{Gossip-synchronized revocation across a five-daemon mesh. At $t=0$ daemon~A locally revokes a Harbor Card (its filter and revocation table). Anti-entropy gossip ships deltas to two random peers every 30\,s, reaching all daemons in $O(\log m)$ rounds. For a ten-daemon mesh this gives global propagation in $\approx 2$\,minutes, well inside the MTTR window where leaked cards remain economically useful. Version vectors guarantee convergence even under reordered or duplicated delta deliveries}{figure.caption.11}{}}
\newlabel{prop:filter-mono}{{2.2}{9}{Filter Monotonicity over a TTL Epoch}{property.2.2}{}}
\newlabel{prop:no-reanim}{{2.3}{9}{No Partial Reanimation}{property.2.3}{}}
\newlabel{prop:fresh}{{2.4}{9}{Filter Freshness Bound}{property.2.4}{}}
