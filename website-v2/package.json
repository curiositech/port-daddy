{
  "name": "website-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run generate:seo && npm run generate:skill-audit",
    "build": "tsc -b && vite build",
    "postbuild": "tsx scripts/inject-route-html.mjs",
    "snap:routes": "tsx scripts/snap-routes.mjs",
    "build:full": "npm run build && npm run snap:routes",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:visuals": "node scripts/generate-gemini-assets.mjs",
    "generate:dark-variants": "node scripts/generate-dark-variants.mjs",
    "optimize:visuals": "node scripts/generate-gemini-assets.mjs --optimize-existing",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "generate:seo": "tsx scripts/generate-seo-artifacts.mjs",
    "generate:skill-audit": "node scripts/generate-skill-audit.mjs",
    "generate:og": "tsx scripts/generate-og-cards.mjs",
    "test:a11y:mcp": "node scripts/check-mcp-a11y.mjs",
    "test:a11y:shell": "node scripts/check-public-shell-a11y.mjs",
    "crawl:docs": "node scripts/crawl-docs-surface.mjs",
    "test:tutorial-command-surfaces": "node scripts/check-tutorial-command-surfaces.mjs",
    "test:whitepaper-metadata": "tsx scripts/check-whitepaper-metadata.ts",
    "test:console-palette": "node scripts/check-console-palette-tokens.mjs",
    "fix:whitepaper-metadata": "tsx scripts/check-whitepaper-metadata.ts --fix",
    "test:figure-palette": "node scripts/check-figure-palette.mjs",
    "test:install-commands": "node scripts/check-install-commands.mjs",
    "record:gifs": "bash scripts/record-site-terminal-gifs.sh --all && bash scripts/record-agent-terminal-gifs.sh --all",
    "test:gifs": "node scripts/check-terminal-recordings.mjs",
    "test:porthole": "tsx scripts/check-porthole-casts.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/three": "^0.183.1",
    "asciinema-player": "^3.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "10.2.19",
    "@storybook/react": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "storybook": "^10.2.19",
    "tailwindcss": "^4.2.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
