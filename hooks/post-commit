#!/usr/bin/env zsh
# =============================================================================
# Port Daddy Post-Commit Hook
# =============================================================================
# Publishes to a project-scoped git:committed channel after every commit.
# Fleet agents trigger without cross-project bleed across multiple checkouts.
#
# Disable: chmod -x .git/hooks/post-commit
# =============================================================================

PORT_FILE="${PORT_DADDY_PORT_FILE:-$HOME/.port-daddy/daemon.port}"
if [[ -n "${PD_URL:-}" ]]; then
  PORT_DADDY_BASE="$PD_URL"
elif [[ -n "${PORT_DADDY_URL:-}" ]]; then
  PORT_DADDY_BASE="$PORT_DADDY_URL"
elif [[ -f "$PORT_FILE" ]]; then
  PORT_DADDY_BASE="http://localhost:$(tr -d '[:space:]' < "$PORT_FILE")"
else
  # No published endpoint means there is no daemon we can address honestly.
  # Keep the Git hook non-blocking and skip the ambient notification.
  command -v git-lfs >/dev/null 2>&1 && git lfs post-commit "$@"
  exit 0
fi

PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
PROJECT_SLUG=$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' | cut -c1-24)
PROJECT_HASH=$(printf '%s' "$PROJECT_ROOT" | shasum -a 256 | cut -c1-12)
CHANNEL="project:${PROJECT_SLUG:-project}:${PROJECT_HASH}:git:committed"

# Gather commit info
SHA=$(git rev-parse --short HEAD 2>/dev/null)
MSG=$(git log -1 --pretty=%s 2>/dev/null)
AUTHOR=$(git log -1 --pretty=%an 2>/dev/null)
FILES_CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | head -20 | tr '\n' ', ')
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Build payload
PAYLOAD=$(cat <<ENDJSON
{
  "payload": {
    "sha": "${SHA}",
    "message": "${MSG}",
    "author": "${AUTHOR}",
    "branch": "${BRANCH}",
    "files": "${FILES_CHANGED}"
  }
}
ENDJSON
)

# Publish to the project-scoped channel (fire-and-forget, don't block commit)
curl -s -X POST "${PORT_DADDY_BASE}/msg/${CHANNEL}" \
  -H 'Content-Type: application/json' \
  -d "${PAYLOAD}" \
  --connect-timeout 2 \
  --max-time 3 \
  >/dev/null 2>&1 &

# Also run git-lfs post-commit if present
command -v git-lfs >/dev/null 2>&1 && git lfs post-commit "$@"

# >>> Port Daddy Skill Sync
# When this commit touched the first-party skills/ catalog, refresh the local
# per-runtime symlink fan-out (.claude/skills, .codex/skills, .agy/skills, …) so
# every agent tool sees the same library. Fire-and-forget: never blocks or fails
# a commit (the fan-out is gitignored, machine-local state). Manual: npm run skills:sync
if git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null | grep -q '^skills/'; then
  if command -v npx >/dev/null 2>&1 && [[ -f "$PROJECT_ROOT/scripts/sync-skills.ts" ]]; then
    ( cd "$PROJECT_ROOT" && npx tsx scripts/sync-skills.ts --scope project --quiet >/dev/null 2>&1 & )
  fi
fi
# <<< Port Daddy Skill Sync

exit 0
