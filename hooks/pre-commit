#!/usr/bin/env zsh
# =============================================================================
# Port Daddy Pre-Commit Guard
# =============================================================================
# Prevents rogue agents (or humans) from gutting critical files.
# Defense-in-depth: tests catch regressions, this hook blocks commits.
#
# Uses zsh (available on macOS) for associative array support.
# =============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

fail() {
  echo "${RED}PRE-COMMIT BLOCKED:${NC} $1" >&2
  ERRORS=$((ERRORS + 1))
}

# ---------------------------------------------------------------------------
# 1. Critical files must not be deleted
# ---------------------------------------------------------------------------
CRITICAL_FILES=(
  server.ts
  lib/services.ts
  lib/sessions.ts
  lib/agents.ts
  lib/locks.ts
  lib/messaging.ts
  lib/identity.ts
  lib/db.ts
  lib/client.ts
  lib/sugar.ts
  lib/config.ts
  lib/activity.ts
  lib/webhooks.ts
  lib/dns.ts
  lib/health.ts
  lib/harbors.ts
  lib/resurrection.ts
  lib/orchestrator.ts
  lib/detect.ts
  lib/scan.ts
  bin/port-daddy-cli.ts
  mcp/server.ts
  public/index.html
  package.json
)

DELETED_FILES=$(git diff --cached --name-only --diff-filter=D 2>/dev/null || true)
for f in $CRITICAL_FILES; do
  if echo "$DELETED_FILES" | grep -qx "$f"; then
    fail "$f was DELETED. This file is critical infrastructure."
  fi
done

# ---------------------------------------------------------------------------
# 2. Critical files must not be gutted below minimum line counts
#    Thresholds are ~40% of current size — catches gutting while allowing
#    legitimate refactoring.
# ---------------------------------------------------------------------------
typeset -A MIN_LINES
MIN_LINES=(
  server.ts 300
  lib/services.ts 200
  lib/sessions.ts 400
  lib/agents.ts 300
  lib/locks.ts 150
  lib/messaging.ts 150
  lib/identity.ts 60
  lib/db.ts 80
  lib/client.ts 800
  lib/sugar.ts 100
  lib/config.ts 80
  lib/activity.ts 150
  lib/webhooks.ts 200
  lib/dns.ts 150
  lib/health.ts 100
  lib/harbors.ts 100
  lib/detect.ts 400
  lib/scan.ts 100
  lib/orchestrator.ts 150
  bin/port-daddy-cli.ts 800
  mcp/server.ts 800
  # public/index.html: the web dashboard was retired (surface consolidation,
  # 2026-07) — the root page is now a deliberately minimal pointer to the
  # native surfaces. Floor guards against accidental truncation only.
  public/index.html 60
)

MODIFIED_FILES=$(git diff --cached --name-only --diff-filter=M 2>/dev/null || true)
for f threshold in ${(kv)MIN_LINES}; do
  if echo "$MODIFIED_FILES" | grep -qx "$f"; then
    LINES=$(git show ":$f" 2>/dev/null | wc -l | tr -d ' ')
    if (( LINES < threshold )); then
      fail "$f was gutted to $LINES lines (minimum: $threshold). Restore the file."
    fi
  fi
done

# ---------------------------------------------------------------------------
# 3. Database and binary files must never be committed
# ---------------------------------------------------------------------------
# --diff-filter=d: deletions carry no staged content, and blocking them would
# prevent the one commit that removes an already-tracked artifact.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d 2>/dev/null || true)
for f in ${(f)STAGED_FILES}; do
  case "$f" in
    *.db|*.db-wal|*.db-shm|*.sqlite|*.sqlite3)
      fail "Database file '$f' is staged. Remove it: git reset HEAD '$f'"
      ;;
    */target/release/*|*/target/debug/*)
      fail "Rust build artifact '$f' is staged. Add '**/target/' to .gitignore."
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 4. No suspicious padding/injection patterns
# ---------------------------------------------------------------------------
for f in ${(f)STAGED_FILES}; do
  case "$f" in
    *.ts|*.js|*.html|*.css|*.json|*.md)
      PADDING_COUNT=$(git show ":$f" 2>/dev/null | grep -c 'PADDING_ANCHOR\|STIGMERGIC_SWARM\|VISUAL_RICHNESS_[0-9]' 2>/dev/null || true)
      if (( PADDING_COUNT > 10 )); then
        fail "$f contains $PADDING_COUNT suspicious padding lines. This looks like injection."
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 5. Website public-shell guard
# ---------------------------------------------------------------------------
if echo "$STAGED_FILES" | grep -q '^website-v2/'; then
  echo "${YELLOW}Running website-v2 public-shell contract checks...${NC}" >&2

  if ! npm --prefix website-v2 test -- src/public-shell-contracts.test.ts >/dev/null 2>&1; then
    fail "website-v2 public-shell contracts failed. Fix the routed shell before committing."
  fi

  if ! npm --prefix website-v2 run build >/dev/null 2>&1; then
    fail "website-v2 build failed. The public shell must build clean before committing."
  fi
fi

# ---------------------------------------------------------------------------
# 6. Secret-at-rest guard on the staged diff (ADR-0088 Phase B / ADR-0053)
# ---------------------------------------------------------------------------
# `pd safe guard --staged` reuses the A1 structured-format + entropy scanner
# against `git diff --staged` and exits 1 when a NEW secret is staged. It prints
# only path/line/rule-id/last-4 — never the raw value. Fail-OPEN if the `pd`
# binary is absent (do not block a commit just because pd isn't installed);
# fail-CLOSED when pd is present and finds a staged secret.
if command -v pd >/dev/null 2>&1; then
  if ! pd safe guard --staged --quiet >/dev/null 2>&1; then
    # Re-run without --quiet so the operator sees which finding blocked them.
    pd safe guard --staged >&2 || true
    fail "staged changes add a secret (pd safe guard). Un-stage it or corral it: pd safe corral <KEY> --apply."
  fi
fi

# ---------------------------------------------------------------------------
# 7. README freshness guard
# ---------------------------------------------------------------------------
# >>> README Freshness Guard
# The README rotted from v3.13 to v3.24 because nothing at commit time asked
# whether a surface change was reflected in it. This gate blocks a commit that
# stages changes to README-documented surfaces (CLI verb registry, MCP tools,
# OpenAPI contract, fleet topology, new cli/commands/ files) without staging a
# README.md update alongside. Agents: update the affected README section, then
# `git add README.md`. Genuinely internal change? PD_README_OK=1 git commit …
# Fail-open when node or the script is absent (old branches must not hard-fail).
README_GUARD="$(git rev-parse --show-toplevel)/scripts/check-readme-freshness.mjs"
if command -v node >/dev/null 2>&1 && [[ -f "$README_GUARD" ]]; then
  node "$README_GUARD" --staged
  README_GUARD_RC=$?
  # exit 1 = README update required; exit 2 = could not determine (fail-open)
  if (( README_GUARD_RC == 1 )); then
    fail "operator-facing surface changed without a README.md update (see above)."
  fi
fi
# <<< README Freshness Guard

# ---------------------------------------------------------------------------
# 8. ADR number-collision guard
# ---------------------------------------------------------------------------
# >>> ADR Collision Guard
# docs/adr/ accreted twelve number collisions (two or three ADRs sharing one
# NNNN) because nothing at commit time checked "is this number already taken?".
# A collided number silently misroutes every link, `pd adr` lookup, and
# downstream re-extraction. This gate FAILS CLOSED when any ADR number maps to
# more than one live file (forwarding stubs — files carrying an
# `ADR-RENUMBERED-TO:` marker — are excluded), and when the generated registry
# docs/adr/adr-numbering-registry.json is stale. It only runs when a staged
# path is under docs/adr/. Fix a collision: rename the squatter to the next free
# number, leave a forwarding stub, then
#   node scripts/adr-number-collision-guard.mjs --write-registry && git add docs/adr
# One-time bulk-renumber pass only: PD_ADR_GUARD_OK=1 git commit … (logged).
# Fail-open when node or the script is absent (old branches must not hard-fail).
ADR_GUARD="$(git rev-parse --show-toplevel)/scripts/adr-number-collision-guard.mjs"
if command -v node >/dev/null 2>&1 && [[ -f "$ADR_GUARD" ]]; then
  node "$ADR_GUARD" --staged
  ADR_GUARD_RC=$?
  # exit 1 = collision or stale registry; exit 2 = could not determine (fail-open)
  if (( ADR_GUARD_RC == 1 )); then
    fail "ADR number collision or stale registry (see above)."
  fi
fi
# <<< ADR Collision Guard

# ---------------------------------------------------------------------------
# Result
# ---------------------------------------------------------------------------
if (( ERRORS > 0 )); then
  echo "" >&2
  echo "${RED}Commit blocked: $ERRORS issue(s) found.${NC}" >&2
  echo "If this is intentional, use: git commit --no-verify" >&2
  exit 1
fi

exit 0
