# demos/scenarios/auction.tape
Output demos/gifs/auction.gif
Set FontSize 22
Set Width 1200
Set Height 600
Set Padding 60

# Start in Light
Set Theme "Catppuccin Latte"
Type "# Mode: Exploration"
Enter
Type "pd demo auction"
Enter
Sleep 3s

# Switch to Dark for the win
Set Theme "Catppuccin Macchiato"
Type "# Mode: Convergence"
Enter
Sleep 4s
