#!/usr/bin/expect -f
set timeout 15
set send_slow {1 .08}
spawn vim -N -u NORC -c "syntax on" -c "set nonumber laststatus=2" drive.sh
sleep 1.6
send -s "j"; send -s "j"; send -s "j"; send -s "j"; send -s "j"; send -s "j"
sleep 0.8
send "G"
sleep 1.2
send "gg"
sleep 1.0
send "/type_cmd\r"
sleep 1.4
send ":q\r"
expect eof
