[7.008942, "o", "\u001b[m\u001b[m\u001b[0m\u001b[H\u001b[2J\u001b[28;1H\"drive.sh\" 30L, 596B\u001b[2;1H½\u001b[6n\u001b[2;1H  \u001b[3;1H\u001bPzz\u001b\\\u001b[0%m\u001b[6n\u001b[3;1H           \u001b[1;1H\u001b[1;1H\u001b[34m#!/usr/bin/env bash\r\r\n# Honest demo driver: typing is simulated, every byte of output is a real\u001b[0m\u001b[2;74H\u001b[K\u001b[3;1H\u001b[34m# command running against the real installed daemon. No filtering, no truncation.\u001b[0m\u001b[3;82H\u001b[K\u001b[4;1H\u001b[33mset\u001b[0m\u001b[36m \u001b[0m\u001b[35m-uo\u001b[0m\u001b[36m pipefail\r\r\n\r\r\nPROMPT_DIR\u001b[0m=\u001b[33m\"\u001b[0m\u001b[31m~/coding/port-daddy\u001b[0m\u001b[33m\"\u001b[0m\r\r\n\u001b[36mtype_cmd() {\u001b[0m\r\r\n  \u001b[33mlocal\u001b[0m \u001b[36mtext\u001b[0m=\u001b[33m\"\u001b[0m\u001b[35m$1\u001b[0m\u001b[33m\"\u001b[0m i\r\r\n  \u001b[33mprintf\u001b[0m \u001b[33m'\u001b[0m\u001b[31m\\033[1;36m%s\\033[0m \\033[1;32mâ\u001b[0m\u001b[34m~]\u001b[0m\u001b[31m¯\\033[0m \u001b[0m\u001b[33m'\u001b[0m \u001b[33m\"\u001b[0m\u001b[35m$PROMPT_DIR\u001b[0m\u001b[33m\"\r\r\n\u001b[0m  \u001b[33msleep\u001b[0m \u001b[31m0\u001b[0m.\u001b[31m6\u001b[0m\r\r\n  \u001b[33mfor ((i = \u001b[0m\u001b[31m0\u001b[0m\u001b[33m; i < \u001b[0m\u001b[35m${#text}\u001b[0m\u001b[33m; i += \u001b[0m\u001b[31m1\u001b[0m\u001b[33m));\u001b[0m \u001b[33mdo\r\r\n\u001b[0m    \u001b[33mprintf\u001b[0m \u001b[33m'\u001b[0m\u001b[31m%s\u001b[0m\u001b[33m'\u001b[0m \u001b[33m\"\u001b[0m\u001b[35m${text\u001b[0m\u001b[33m:\u001b[0m\u001b[35m$i\u001b[0m\u001b[33m:1\u001b[0m\u001b[35m}\u001b[0m\u001b[33m\"\r\r\n\u001b[0m    \u001b[33msleep\u001b[0m \u001b[31m0\u001b[0m.\u001b"]
[7.008947, "o", "[31m028\u001b[0m\r\r\n"]
[7.00899, "o", "  \u001b[33mdone\r\r\n\u001b[0m  \u001b[33msleep\u001b[0m \u001b[31m0\u001b[0m.\u001b[31m35\u001b[0m\r\r\n  \u001b[33mprintf\u001b[0m \u001b[33m'\u001b[0m\u001b[31m\\n\u001b[0m\u001b[33m'\u001b[0m\r\r\n\u001b[36m}\r\r\n\r\r\nrun() {\u001b[0m\r\r\n  type_cmd \u001b[33m\"\u001b[0m\u001b[35m$1\u001b[0m\u001b[33m\"\u001b[0m\r\r\n  bash \u001b[35m-c\u001b[0m \u001b[33m\"\u001b[0m\u001b[35m$1\u001b[0m\u001b[33m\"\u001b[0m \u001b[31m2\u001b[0m\u001b[33m>&1\r\r\n\u001b[0m  \u001b[33mprintf\u001b[0m \u001b[33m'\u001b[0m\u001b[31m\\n\u001b[0m\u001b[33m'\r\r\n\u001b[0m  \u001b[33msleep\u001b[0m \u001b[31m0\u001b[0m.\u001b[31m9\u001b[0m\r\r\n\u001b[36m}\u001b[0m\r\r\n\r\r\n\u001b[33msleep\u001b[0m \u001b[31m0\u001b[0m.\u001b[31m4\u001b[0m\r\r\n\u001b[1m\u001b[7mdrive.sh                                                                                            \u001b[1;1H"]
[7.011168, "o", "\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\r\r\n\u001b[0m\u001b[1;1H\u001b[4M\u001b[23;1H\u001b[4L\u001b[23;1H\u001b[33mfor\u001b[0m cmd \u001b[33min\u001b[0m \u001b[33m\"\u001b[0m\u001b[35m$@\u001b[0m\u001b[33m\"\u001b[0m; \u001b[33mdo\u001b[0m\r\r\n  run \u001b[33m\"\u001b[0m\u001b[35m$cmd\u001b[0m\u001b[33m\"\r\r\ndone\r\r\nsleep\u001b[0m \u001b[31m1\u001b[0m.\u001b[31m2\u001b[0m\u001b[28;1H\u001b[K\u001b[26;1H\u001b[23;1H\u001b[4M\u001b[1;1H\u001b[4L\u001b[1;1H\u001b[34m#!/usr/bin/env bash\r\r\n# Honest demo driver: typing is simulated, every byte of output is a real\r\r\n# command running against the real installed daemon. No filtering, no truncation.\u001b[0m\r\r\n\u001b[33mset\u001b[0m\u001b[36m \u001b[0m\u001b[35m-uo\u001b[0m\u001b[36m pipefail\u001b[1;1H\u001b[28;1H\u001b[0m/type_cmd\r"]
