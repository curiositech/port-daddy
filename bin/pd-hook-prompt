#!/bin/sh
# pd-hook-prompt — UserPromptSubmit tentacle (ADR-0091, Giant Squid Harness)
# =============================================================================
# Claude Code (and parity-verified vendors) invoke this on UserPromptSubmit with
# the prompt event JSON on stdin. We grep the Ink Cloud matrix for steering
# Alerts (PD_ALERT_*) and Pheromones (PD_PHEROMONE_*) relevant to the current
# working directory and print them to stdout. Claude Code PREPENDS hook stdout to
# the model's context for that turn — that is the "Suggestibility Envelope".
#
# CONTRACT: exit 0 always (this tentacle is ADVISORY, never blocking). Any error
# must fail OPEN — emit nothing, let the turn proceed un-steered. A hook that
# crashes the CLI is a broken product; a hook that stays quiet is merely degraded
# coordination (ADR §Mitigation).
#
# Dependency-light: pure POSIX sh + grep/sed. jq is used only to read `cwd` from
# the event JSON when present; we fall back to $PWD. No node required.
set -u

PD_HOME="${PD_HOME:-$HOME/.port-daddy}"
MATRIX="${PD_MATRIX_FILE:-$PD_HOME/matrix.env}"
# Prompt context is a scarce resource. Two actionable facts plus one heading is
# the hard product budget: three lines / 512 bytes. Callers may lower these
# limits for a more austere harness, but may not raise them and turn the hook
# into a briefing dump.
MAX_ENTRIES="${PD_SQUID_PROMPT_MAX_ENTRIES:-2}"
MAX_BYTES="${PD_SQUID_PROMPT_MAX_BYTES:-512}"
case "$MAX_ENTRIES" in ''|*[!0-9]*) MAX_ENTRIES=2 ;; esac
case "$MAX_BYTES" in ''|*[!0-9]*) MAX_BYTES=512 ;; esac
[ "$MAX_ENTRIES" -le 2 ] 2>/dev/null || MAX_ENTRIES=2
[ "$MAX_BYTES" -le 512 ] 2>/dev/null || MAX_BYTES=512
TTL_SECONDS="${PD_SQUID_PROMPT_TTL_SECONDS:-1800}"
# Hard cap on candidate lines entering the expensive per-line loop below, no
# matter how many the cheap grep prefilter still lets through. Without this, a
# long-lived, multi-project fleet whose matrix.env accumulates thousands of
# pheromones (unbounded — the writer, pd-hook-post-tool, does not prune) makes
# this hook's per-line sed/date forks the dominant cost: at ~3k lines this hook
# measured 20-30s+ (timeout) before this fix.
SCAN_CAP="${PD_SQUID_PROMPT_SCAN_CAP:-60}"

# Drain stdin so the CLI's pipe write never blocks, capturing it for cwd parsing.
EVENT="$(cat 2>/dev/null || true)"

# Best-effort cwd from the event; harmless fallback to $PWD.
CWD="$PWD"
if command -v jq >/dev/null 2>&1 && [ -n "$EVENT" ]; then
  J="$(printf '%s' "$EVENT" | jq -r '.cwd // .workspace // empty' 2>/dev/null || true)"
  [ -n "$J" ] && CWD="$J"
fi

# Relevance: use the exact pd project root (or cwd when no marker is available),
# never a basename substring. `app` must not receive traces from `other-app`.
BASENAME="$(basename "$CWD" 2>/dev/null || echo "$CWD")"
PROJECT_ROOT="$CWD"
d="$CWD"
while [ -n "$d" ] && [ "$d" != "/" ]; do
  if [ -d "$d/.portdaddy" ]; then PROJECT_ROOT="$d"; break; fi
  d="$(dirname "$d" 2>/dev/null || true)"
done

# Read the matrix once if it exists. Alerts are rare and always global, so a
# capped raw grep is enough. Pheromones are what blow up at scale (one per
# file mutation, fleet-wide, forever), so they get ONE extra cheap substring
# prefilter (`grep -F`, still O(1) forks total — not one per line) narrowing
# to lines that at least mention this project root before ANY per-line
# sed/date work runs below. The prefilter is intentionally loose (substring,
# not the exact prefix the per-line loop enforces) so it can only ever admit
# false positives, never drop a true match — correctness stays with the
# per-line loop; this is purely a cost-shaping pass.
ALERTS=""
PHER=""
if [ -f "$MATRIX" ]; then
  # tail, not head: the matrix is append-only (oldest first), and only the
  # freshest entries can pass is_fresh below — taking the oldest SCAN_CAP
  # matches would force a full-cap scan that rejects every one of them on a
  # quiet/idle matrix, instead of finding fresh matches and breaking early.
  ALERTS="$(grep -E '^PD_ALERT_[A-Za-z0-9_]+=' "$MATRIX" 2>/dev/null | tail -n "$SCAN_CAP" || true)"
  PHER="$(grep -E '^PD_PHEROMONE_[A-Za-z0-9_]+=' "$MATRIX" 2>/dev/null | grep -F -- "$PROJECT_ROOT" | tail -n "$SCAN_CAP" || true)"
fi

emit_value() {
  # $1 = a `KEY="val"` matrix line → print just the unquoted value.
  printf '%s\n' "$1" | sed -E 's/^[A-Za-z0-9_]+="?//; s/"$//'
}

# ── SITREP dial (per-repo end-of-turn compulsion) ────────────────────────────
# Mirrors the ADR-0092 suggestibility dial's resolution shape: PD_SITREP env
# override first, then a parent-walk over agent.config.json /
# .portdaddy/sitrep.json / .portdaddy/project.json reading `.sitrep.endOfTurn`
# (or a bare `.sitrep` string). Closed enum off|suggest|enforce. DEFAULT IS
# ENFORCE — operator doctrine reversal, 2026-08-22: the end-of-turn SITREP is
# the harness's visible value surface, so an absent or unreadable config fails
# toward the full contract, never toward silence. Repos that want quiet turns
# opt out explicitly (sitrep.endOfTurn: off) — no half-assed defaults.
# NOTE: this dial governs the standing SITREP contract only; the coordination
# content below (alerts/pheromones) keeps its own #8059 bounding untouched.

normalize_sitrep() {
  LEVEL="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  case "$LEVEL" in
    off|suggest|enforce) printf '%s' "$LEVEL" ;;
    *) printf '' ;;
  esac
}

json_sitrep_level() {
  CFG="$1"
  [ -f "$CFG" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    jq -r '.sitrep.endOfTurn // .sitrep // empty' "$CFG" 2>/dev/null || true
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$CFG" <<'PY' 2>/dev/null || true
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise SystemExit
    value = data.get("sitrep")
    if isinstance(value, dict):
        value = value.get("endOfTurn")
    if isinstance(value, str):
        print(value)
except Exception:
    pass
PY
    return 0
  fi
  # No JSON parser available → no dial read. The caller's default (enforce)
  # keeps the contract standing rather than letting missing tooling silence it.
  return 0
}

config_sitrep_level() {
  DIR="$CWD"
  case "$DIR" in
    /*) : ;;
    *) DIR="$(pwd 2>/dev/null || printf '.')" ;;
  esac
  while [ -n "$DIR" ] && [ "$DIR" != "/" ]; do
    for CFG in "$DIR/agent.config.json" "$DIR/.portdaddy/sitrep.json" "$DIR/.portdaddy/project.json"; do
      RAW="$(json_sitrep_level "$CFG" | head -n1)"
      LEVEL="$(normalize_sitrep "$RAW")"
      [ -n "$LEVEL" ] && { printf '%s' "$LEVEL"; return 0; }
    done
    NEXT="$(dirname "$DIR" 2>/dev/null || printf '/')"
    [ "$NEXT" = "$DIR" ] && break
    DIR="$NEXT"
  done
  printf ''
}

is_fresh() {
  # Untagged legacy entries remain visible; every new writer includes ts:<ISO>.
  ts="$(printf '%s\n' "$1" | sed -nE 's/.*\| ts:([^ |]+).*/\1/p')"
  [ -n "$ts" ] || return 0
  compact="$(printf '%s' "$ts" | sed -E 's/\.[0-9]+Z$/Z/')"
  epoch="$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$compact" '+%s' 2>/dev/null || true)"
  [ -n "$epoch" ] || epoch="$(date -u -d "$compact" '+%s' 2>/dev/null || true)"
  case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s 2>/dev/null || true)"
  case "$now" in ''|*[!0-9]*) return 1 ;; esac
  age=$((now - epoch))
  [ "$age" -ge 0 ] 2>/dev/null && [ "$age" -le "$TTL_SECONDS" ] 2>/dev/null
}

ENTRIES=""
COUNT=0

if [ -n "$ALERTS" ]; then
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$COUNT" -lt "$MAX_ENTRIES" ] 2>/dev/null || break
    val="$(emit_value "$line")"
    is_fresh "$val" || continue
    ENTRIES="${ENTRIES}- ${val}\n"
    COUNT=$((COUNT + 1))
  done <<EOF
$ALERTS
EOF
fi

if [ -n "$PHER" ]; then
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$COUNT" -lt "$MAX_ENTRIES" ] 2>/dev/null || break
    val="$(emit_value "$line")"
    is_fresh "$val" || continue
    subject="${val%% | *}"
    case "$subject" in
      "$PROJECT_ROOT"|"$PROJECT_ROOT"/*)
        ENTRIES="${ENTRIES}- ${val}\n"
        COUNT=$((COUNT + 1))
        ;;
    esac
  done <<EOF
$PHER
EOF
fi

# Inbox/parley awareness: message bodies never enter prompt context here. The
# hook asks only for the unread count, consumes one of the existing two bounded
# coordination slots, and leaves read/acknowledgement to `pd attention`.
SELF="${PD_ACTOR:-${PD_AGENT_ID:-}}"
DAEMON_URL="${PD_URL:-${PORT_DADDY_URL:-http://127.0.0.1:9876}}"
case "$DAEMON_URL" in */) DAEMON_URL="${DAEMON_URL%/}" ;; esac
case "$DAEMON_URL" in
  http://localhost:*) DAEMON_URL="http://127.0.0.1:${DAEMON_URL##*:}" ;;
  http://127.0.0.1:*) : ;;
  *) DAEMON_URL="" ;; # hooks never wait on DNS or a remote coordination plane
esac
if [ "$COUNT" -lt "$MAX_ENTRIES" ] 2>/dev/null && [ -n "$SELF" ] && [ -n "$DAEMON_URL" ] && command -v curl >/dev/null 2>&1; then
  case "$SELF" in
    *[!A-Za-z0-9._:-]*) : ;;
    *)
      STATS="$(curl -fsS --connect-timeout 0.10 --max-time 0.20 \
        "${DAEMON_URL}/agents/${SELF}/inbox/stats" 2>/dev/null || true)"
      UNREAD=""
      if command -v jq >/dev/null 2>&1; then
        UNREAD="$(printf '%s' "$STATS" | jq -r '.unread // empty' 2>/dev/null || true)"
      elif command -v sed >/dev/null 2>&1; then
        UNREAD="$(printf '%s' "$STATS" | sed -nE 's/.*"unread"[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' | head -n1)"
      fi
      case "$UNREAD" in
        ''|*[!0-9]*|0) : ;;
        *)
          ENTRIES="${ENTRIES}- ${UNREAD} unread inbox/parley item(s); run pd attention before continuing.\n"
          COUNT=$((COUNT + 1))
          ;;
      esac
      ;;
  esac
fi

# Coordination content: the common case stays deliberately zero bytes. Only a
# fresh alert or an exact-project pheromone earns context, and even then the
# envelope stays concise under the #8059 bound below.
OUT=""
[ -z "$ENTRIES" ] || OUT="[PORT DADDY — ACTIONABLE COORDINATION near ${BASENAME}]\n${ENTRIES}"

# SITREP compulsion (operator doctrine, 2026-08-22): the end-of-turn SITREP is
# the harness's visible value surface. When the dial is suggest/enforce every
# turn carries the end-of-turn table contract — the session's ledger of ideas,
# roadmap claims, and agent-assigned work; a row that has code being written
# MUST be linked to a roadmap item at creation time. The block is a fixed-size
# harness contract, so it rides OUTSIDE the coordination byte cap: the #8059
# bound keeps governing alerts/pheromones and only them.
SITREP="$(normalize_sitrep "${PD_SITREP:-}")"
[ -n "$SITREP" ] || SITREP="$(config_sitrep_level)"
[ -n "$SITREP" ] || SITREP="enforce"
SITREP_OUT=""
if [ "$SITREP" != "off" ]; then
  SITREP_OUT="[PORT DADDY — SITREP ${SITREP}]\n"
  SITREP_OUT="${SITREP_OUT}End EVERY turn with a SITREP markdown table (scaffold: pd sitrep --template):\n"
  SITREP_OUT="${SITREP_OUT}| Idea / Suggestion / Remediation | Source (Agent/Operator) | Status | Related PR/Issue | Docs / Roadmap Link |\n"
  SITREP_OUT="${SITREP_OUT}Track every idea raised this session, every roadmap claim, and work assigned by other agents; update Status with the turn's progress and carry unresolved rows forward.\n"
  SITREP_OUT="${SITREP_OUT}A row you are writing code for MUST carry a roadmap link from the moment it is created — mint one first: pd roadmap upsert <slug> --summary \"...\" --estimate <units>.\n"
  if [ "$SITREP" = "enforce" ]; then
    SITREP_OUT="${SITREP_OUT}enforce: a turn that ends without the table is an incomplete turn — emit it before yielding.\n"
  fi
fi

# Emit the Suggestibility Envelope. The coordination block keeps its hard
# bound (printf interprets the \n we built up; head -c enforces the byte cap);
# the SITREP contract is prepended un-capped because it is constant-size
# harness text governed by its own dial, not matrix-driven content. Prefer
# Claude Code's SANCTIONED structured UserPromptSubmit output —
# hookSpecificOutput.additionalContext — which the runtime frames as TRUSTED
# harness context. Raw stdout (the old path) reads to the model as untrusted
# injected content, which is why Claude Code balked at it as prompt injection.
# Same structured shape the pre-tool tentacle already uses.
# Fail-open: no jq → fall back to raw stdout (degraded framing, still advisory).
if [ -n "$OUT" ] || [ -n "$SITREP_OUT" ]; then
  BLOCK=""
  [ -z "$OUT" ] || BLOCK="$(printf '%b' "$OUT" | head -c "$MAX_BYTES" 2>/dev/null)"
  if [ -n "$SITREP_OUT" ]; then
    SITREP_BLOCK="$(printf '%b' "$SITREP_OUT")"
    if [ -n "$BLOCK" ]; then
      BLOCK="$(printf '%s\n%s' "$SITREP_BLOCK" "$BLOCK")"
    else
      BLOCK="$SITREP_BLOCK"
    fi
  fi
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg ctx "$BLOCK" \
      '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}'
  else
    printf '%s' "$BLOCK"
  fi
fi
exit 0
