#!/bin/sh
# pd-hook-prompt — UserPromptSubmit tentacle (ADR-0091, Giant Squid Harness)
# =============================================================================
# Claude Code (and parity-verified vendors) invoke this on UserPromptSubmit with
# the prompt event JSON on stdin. We grep the Ink Cloud matrix for the Reconcile
# Loop's projected key classes plus the legacy Alerts/Pheromones and print what
# is relevant to THIS actor and THIS project root. Claude Code PREPENDS hook
# stdout to the model's context for that turn — the "Suggestibility Envelope".
#
# CONTRACT: exit 0 always (this tentacle is ADVISORY, never blocking). Any error
# must fail OPEN — emit nothing, let the turn proceed un-steered. A hook that
# crashes the CLI is a broken product; a hook that stays quiet is merely degraded
# coordination (ADR §Mitigation).
#
# ── THE QUIET HARNESS ────────────────────────────────────────────────────────
# This tentacle used to speak on EVERY turn, because the standing "maintain an
# active pd plan / run pd sitrep" directive was printed unconditionally. That
# made silence meaningless: an operator could never tell "the fleet is calm"
# from "the harness is broken", and the model learned to skim a block that was
# identical 200 turns running. So the directive is now CONDITIONAL — it prints
# when there is other real content to carry it, or once per
# PD_SQUID_PLAN_NAG_INTERVAL_SECONDS (default 3600) per actor, tracked in a small
# state file under $PD_HOME (never /tmp — macOS purges it). When there is
# genuinely nothing fresh, this hook emits NOTHING and exits 0.
#
# ── THE VOICE LOG ────────────────────────────────────────────────────────────
# Silence is only trustworthy if it is auditable, so every invocation appends ONE
# JSON line to $PD_HOME/squid-voice-log.jsonl carrying the VoiceLogEvent shape
# from lib/squid/reconcile-contract.ts:
#   {"outcome":"spoke",      counts, bytes, classes}
#   {"outcome":"silent",     reason:no-entries|matrix-absent|harness-disabled}
#   {"outcome":"suppressed", reason:over-budget|over-entry-cap|stale-matrix|
#                                   ttl-expired|not-relevant-to-cwd,
#                            counts, bytes, droppedClasses, emittedBytes}
# The `suppressed` case is the load-bearing one: it is how an operator learns
# "the harness HAD something and its own bounds ate it" instead of concluding the
# fleet was quiet. Per skills/responsible-logging the file is byte-bounded and
# rotated tail-first (see write_voice_log), and every step of the write is
# wrapped so a failing sink can never change stdout or the exit code.
#
# `counts` is a SUPERSET of the contract's ReconcileClassCounts: it also carries
# ALERT and PHEROMONE, the two pre-reconcile legacy classes this hook projects
# that the registry does not (yet) own. Dropping them from the log would leave
# an operator staring at `counts:{}` on a turn that emitted ten pheromones.
#
# ── THE KEYSTROKE BUDGET (why nothing here is per-line) ──────────────────────
# This hook runs BETWEEN a human pressing Enter and the model seeing their
# prompt. Every millisecond is a millisecond of dead keyboard. The header rule
# above cuts both ways: a hook that degrades coordination is fine, a hook that
# breaks the vendor loop is not — and a hook that takes 23 seconds HAS broken it.
#
# The trap is that the matrix is UNBOUNDED and grows precisely when the daemon is
# dead: nothing is GCing it, while pd-hook-post-tool keeps appending a pheromone
# per touched file per tool call, so a daemon-less workday reaches thousands of
# keys. Two rules keep the per-turn cost flat regardless:
#
#   1. NO PROCESS PER LINE. Value unquoting and `| ts:` freshness are pure
#      parameter expansion (see set_value / ts_key). The TTL cut-offs are
#      rendered ONCE with `date` into comparable YYYYMMDDHHMMSS integers, because
#      fixed-width ISO-8601 UTC orders identically as text and as an instant.
#      The old shape forked ~4 processes per candidate line (sed to unquote, sed
#      to find the stamp, up to two `date` to parse it): 2000 keys = 23s.
#   2. THE SHELL WALKS AT MOST $SCAN_BOUND LINES PER CLASS. Anything past the
#      bound is accounted for in ONE batched pipeline (see class_overflow), never
#      by looping. That keeps the receipts EXACT — held counts and wanted bytes
#      are whole-matrix truths, not truncated ones — while the shell's own work
#      stays O(bound), not O(matrix).
#
# Rule 2 is also why the stale-matrix case short-circuits (see STALE below)
# rather than projecting a full envelope and deleting it: when the heartbeat is
# dead, every section is discarded anyway, so only the tally is worth paying for.
#
# Dependency-light: pure POSIX sh + grep/sed/tr/cut/head/tail/wc/date. jq is used
# only to read `cwd` from the event JSON and to frame the output. No node needed.
set -u

PD_HOME="${PD_HOME:-$HOME/.port-daddy}"
MATRIX="${PD_MATRIX_FILE:-$PD_HOME/matrix.env}"
MAX_ENTRIES="${PD_SQUID_PROMPT_MAX_ENTRIES:-12}"
MAX_BYTES="${PD_SQUID_PROMPT_MAX_BYTES:-4096}"
TTL_SECONDS="${PD_SQUID_PROMPT_TTL_SECONDS:-1800}"
# RECONCILE_ACCOMPLISHMENT_TTL_MS (900_000) — ambience decays fastest.
ACC_TTL_SECONDS="${PD_SQUID_ACCOMPLISHMENT_TTL_SECONDS:-900}"
# RECONCILE_STALE_AFTER_MS (60_000) — four missed reconcile ticks.
STALE_AFTER_MS="${PD_SQUID_MATRIX_STALE_AFTER_MS:-60000}"
NAG_INTERVAL="${PD_SQUID_PLAN_NAG_INTERVAL_SECONDS:-3600}"
VOICE_LOG="${PD_SQUID_VOICE_LOG:-$PD_HOME/squid-voice-log.jsonl}"
VOICE_LOG_MAX_BYTES="${PD_SQUID_VOICE_LOG_MAX_BYTES:-262144}"
NAG_DIR="${PD_SQUID_PLAN_NAG_DIR:-$PD_HOME/squid-plan-nag}"
# Hard ceiling on how many matrix lines PER CLASS the shell loop itself may walk.
# This is a keystroke-latency bound, not a projection budget: MAX_ENTRIES already
# decides what gets SAID, and this only decides how much the shell may read while
# deciding it. Overflow past the bound is still counted and still billed to the
# operator's receipt (class_overflow), just in one pipeline instead of one loop
# iteration. Default 128 gives ~10x headroom over the 12-entry emission budget,
# so TTL-stale or wrong-project candidates ahead of a live one still get skipped
# past in practice; the bound only bites on a matrix that is already pathological.
SCAN_BOUND="${PD_SQUID_PROMPT_SCAN_BOUND:-128}"
case "$SCAN_BOUND" in ''|*[!0-9]*) SCAN_BOUND=128 ;; esac
[ "$SCAN_BOUND" -ge 1 ] 2>/dev/null || SCAN_BOUND=128
# Never let the bound sit below the emission budget, or the hook could not fill
# MAX_ENTRIES even from a matrix that plainly has the entries for it. Guarded on
# MAX_ENTRIES being a clean integer FIRST: a mis-set PD_SQUID_PROMPT_MAX_ENTRIES
# has always been survivable here (its comparisons are `2>/dev/null` guarded and
# simply read as "budget not reached"), and it must not become fatal by leaking
# a non-number into the `$(( ))` that sizes every bounded read.
case "${MAX_ENTRIES:-}" in
  ''|*[!0-9]*) ;;
  *) [ "$SCAN_BOUND" -ge "$MAX_ENTRIES" ] || SCAN_BOUND="$MAX_ENTRIES" ;;
esac
# This agent's identity; the daemon sets PD_ACTOR per voyage. Unknown → "".
# (pd-hook-pre-tool / pd-hook-post-tool already read it; this hook did not, which
# is why per-actor addressing was previously impossible here.)
SELF="${PD_ACTOR:-}"

# Per-class entry caps, mirroring RECONCILE_KEY_CLASSES[*].entryCap.
CAP_HALT=1
CAP_PARLEY=2
CAP_CLAIM=4
CAP_CI=1
CAP_INBOX=3
CAP_ACC=2

# Drain stdin so the CLI's pipe write never blocks, capturing it for cwd parsing.
EVENT="$(cat 2>/dev/null || true)"

# Best-effort cwd from the event; harmless fallback to $PWD.
CWD="$PWD"
if command -v jq >/dev/null 2>&1 && [ -n "$EVENT" ]; then
  J="$(printf '%s' "$EVENT" | jq -r '.cwd // .workspace // empty' 2>/dev/null || true)"
  [ -n "$J" ] && CWD="$J"
fi

NOW="$(date +%s 2>/dev/null || true)"
case "${NOW:-}" in ''|*[!0-9]*) NOW=0 ;; esac
NOW_MS=$((NOW * 1000))

# ── Actor addressing ─────────────────────────────────────────────────────────
# Mirrors actorKey() in lib/squid/reconcile-contract.ts VERBATIM (that TSDoc
# snippet is executed and diffed against the TS function in the contract's test
# suite). Do not "tidy" the BRE intervals into `*` — they are load-bearing.
pd_actor_key() {
  k=$(printf '%s' "$1" \
    | sed -e 's/[^A-Za-z0-9]\{1,\}/_/g' -e 's/^_\{1,\}//' -e 's/_\{1,\}$//' \
    | tr '[:lower:]' '[:upper:]' \
    | cut -c1-64 \
    | sed -e 's/_\{1,\}$//')
  [ -n "$k" ] || k=X
  # The trailing CRC is what makes the address INJECTIVE. Normalization alone
  # aliases `agent-one`/`agent.one`, and truncation aliases any two ids sharing
  # a 64-char prefix — either way two agents land on one mailbox and read each
  # other's mail. `cksum` is the one checksum POSIX specifies, so this number is
  # identical to posixCksum() in lib/squid/matrix.ts on every platform.
  #
  # If `cksum` is somehow unavailable or returns junk, emit NOTHING. A partial
  # address (`BODY_`) would be worse than no address at all: it ends in the very
  # character the `__` separator relies on never appearing, so it would both
  # miss this agent's real keys AND match a neighbour's anchored prefix. The
  # caller reads the empty result as "unaddressable" and skips every per-actor
  # class, which is the same posture as an unset PD_ACTOR.
  d="$(printf '%s' "$1" | cksum 2>/dev/null | cut -d' ' -f1)"
  case "${d:-}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  printf '%s_%s' "$k" "$d"
}

# Empty PD_ACTOR must NOT normalize to the literal "X" and start reading
# PD_INBOX_X_* — an unidentified agent is addressed by nobody, so it reads no
# per-actor class at all. Silence beats delivering another agent's mail. The
# same rule covers an actor whose address could not be computed at all.
ACTOR_KEY=""
[ -n "$SELF" ] && ACTOR_KEY="$(pd_actor_key "$SELF")"

VAL=""
set_value() {
  # $1 = a `KEY="val"` matrix line → leave just the unquoted value in $VAL.
  #
  # This is the pure-parameter-expansion twin of the sed it replaces
  # (`s/^[A-Za-z0-9_]+="?//; s/"$//`): drop everything through the first `=`,
  # then an optional opening quote, then a trailing quote. It sets a global
  # instead of printing because the CALLER is what used to cost a process —
  # `v="$(emit_value "$l")"` forks a subshell in every POSIX shell, so a
  # fork-free body behind a command substitution would have saved nothing.
  VAL="${1#*=}"
  case "$VAL" in '"'*) VAL="${VAL#\"}" ;; esac
  case "$VAL" in *'"') VAL="${VAL%\"}" ;; esac
}

# Which `date` dialect can render an epoch? Probed ONCE against a fixed instant
# rather than by exit status, because BSD `date -d` is not GNU's "-d <datespec>"
# — it sets the DST value — so a dialect that "succeeds" while ignoring the
# argument must be rejected by its ANSWER, not by its status code.
DATE_MODE=""
if [ "$(date -u -d '@86400' '+%Y%m%d%H%M%S' 2>/dev/null || true)" = "19700102000000" ]; then
  DATE_MODE=gnu
elif [ "$(date -u -r 86400 '+%Y%m%d%H%M%S' 2>/dev/null || true)" = "19700102000000" ]; then
  DATE_MODE=bsd
fi

epoch_to_key() {
  # $1 = epoch seconds → YYYYMMDDHHMMSS on stdout, or "" if `date` cannot say.
  case "$DATE_MODE" in
    gnu) _ek="$(date -u -d "@$1" '+%Y%m%d%H%M%S' 2>/dev/null || true)" ;;
    bsd) _ek="$(date -u -r "$1" '+%Y%m%d%H%M%S' 2>/dev/null || true)" ;;
    *) _ek="" ;;
  esac
  case "${_ek:-}" in ''|*[!0-9]*) _ek="" ;; esac
  printf '%s' "$_ek"
}

# The comparison basis, rendered once per process instead of once per line.
# NOW_KEY 0 means "this machine's `date` could not answer", which reproduces the
# old behaviour exactly: every STAMPED entry then fails the `<= NOW_KEY` test and
# is treated as not-fresh, while unstamped legacy entries stay visible.
NOW_KEY="$(epoch_to_key "$NOW")"
case "${NOW_KEY:-}" in ''|*[!0-9]*) NOW_KEY=0 ;; esac

cutoff_key() {
  # $1 = ttl seconds → the oldest ts still considered fresh, as a comparable key.
  # 0 out means "TTL checking disabled" (the HALT posture). When `date` is mute we
  # return 1: a cut-off that no real stamp can satisfy, so the class fails closed
  # the way the per-line `date` parse used to.
  [ "$1" -gt 0 ] 2>/dev/null || { printf '0'; return 0; }
  [ "$NOW_KEY" -gt 0 ] 2>/dev/null || { printf '1'; return 0; }
  _ck="$(epoch_to_key $((NOW - $1)))"
  case "${_ck:-}" in ''|*[!0-9]*) _ck=1 ;; esac
  printf '%s' "$_ck"
}

CUT_TTL="$(cutoff_key "$TTL_SECONDS")"
CUT_ACC="$(cutoff_key "$ACC_TTL_SECONDS")"

TS_RAW=""
TSK=""
ts_key() {
  # $1 = value → $TS_RAW is its `| ts:<stamp>` marker ("" when untagged) and $TSK
  # is that stamp as a YYYYMMDDHHMMSS integer ("" when it is not a well-formed
  # fixed-width ISO-8601 UTC instant). The two are separate on purpose: an
  # UNTAGGED entry is legacy and stays visible, while a TAGGED-but-unparseable
  # one is corrupt and must not be trusted — the same distinction the old
  # sed-then-date pair drew, and the reason this cannot collapse to one global.
  TS_RAW=""
  TSK=""
  case "$1" in
    *"| ts:"*) _t="${1##*| ts:}" ;;
    *) return 0 ;;
  esac
  # `[^ |]+` in the old regex: the stamp ends at the first space or pipe.
  _t="${_t%%|*}"
  _t="${_t%% *}"
  [ -n "$_t" ] || return 0
  TS_RAW="$_t"
  _y="${_t%%-*}"; _t="${_t#*-}"
  _mo="${_t%%-*}"; _t="${_t#*-}"
  _d="${_t%%T*}"; _t="${_t#*T}"
  _h="${_t%%:*}"; _t="${_t#*:}"
  _mi="${_t%%:*}"; _t="${_t#*:}"
  _s="${_t%%.*}"; _s="${_s%Z}"
  # Exact-width validation stands in for the old `%Y-%m-%dT%H:%M:%SZ` strptime:
  # anything else leaves TSK empty and is judged stale, never silently mis-parsed.
  case "$_y" in [0-9][0-9][0-9][0-9]) ;; *) return 0 ;; esac
  case "$_mo$_d$_h$_mi$_s" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) return 0 ;;
  esac
  # `${x#0}` before the arithmetic: POSIX $(( )) reads a leading zero as octal.
  TSK=$(( _y * 10000000000 + ${_mo#0} * 100000000 + ${_d#0} * 1000000 \
        + ${_h#0} * 10000 + ${_mi#0} * 100 + ${_s#0} ))
}

is_fresh() {
  # $1 = value, $2 = cut-off key from cutoff_key (0 disables the check for
  # mirror-source classes like HALT, whose lifetime is owned by the reconcile
  # tick, not by age).
  # Untagged legacy entries remain visible; every new writer includes ts:<ISO>.
  [ "$2" -gt 0 ] 2>/dev/null || return 0
  ts_key "$1"
  [ -n "$TS_RAW" ] || return 0
  [ -n "$TSK" ] || return 1
  [ "$TSK" -ge "$2" ] 2>/dev/null && [ "$TSK" -le "$NOW_KEY" ] 2>/dev/null
}

# ── Bookkeeping the VoiceLog is built from ───────────────────────────────────
COUNT=0            # entries actually emitted (the MAX_ENTRIES budget)
HELD_TOTAL=0       # candidate entries seen, BEFORE any filter
TTL_DROPPED=0
ROOT_DROPPED=0
CAP_DROPPED=0
# Bytes the projection WANTED to emit. Accumulated as an integer instead of by
# growing a WANT string of every candidate line: repeated append to a shell
# string is quadratic, and at 2000 pheromones that string reached 167 KB — memory
# and memcpy spent purely so `wc -c` could measure it once at the end. `${#VAL}`
# is the shell's own length operator, so the same figure now costs nothing per
# line. (Under a multibyte locale a locale-aware shell counts characters rather
# than bytes; for an observability figure that under-reports only on non-ASCII
# notes, that is the right trade against forking a process per line.)
WANT_BYTES=0

# read_bounded <extended-regex> → $RB_LINES
#   At most SCAN_BOUND+1 matching lines. The +1 is a deliberate sentinel: a
#   walker learns it was truncated by MEETING that line, so the common (short)
#   case pays for no separate counting pass at all.
RB_LINES=""
read_bounded() {
  RB_LINES=""
  [ -n "$1" ] || return 0
  [ "$MATRIX_PRESENT" -eq 1 ] || return 0
  RB_LINES="$(grep -E "$1" "$MATRIX" 2>/dev/null | head -n "$((SCAN_BOUND + 1))" 2>/dev/null || true)"
}

# class_overflow <extended-regex> → $OV_COUNT (+ HELD_TOTAL/CAP_DROPPED/WANT_BYTES)
#   Account for every match PAST the scan bound in ONE batched pipeline.
#
# This is what lets the bound be a latency guard without turning the receipt into
# a lie. The review that found the O(matrix) regression was right that a naive
# `head` loses the HELD/CAP_DROPPED attribution the VoiceLog buys — so we buy it
# back wholesale instead of retail: sed unquotes the entire un-walked tail in a
# single process and `wc -lc` measures it in one more, which makes `counts` and
# `bytes` whole-matrix EXACT. No "at least N" semantics are needed, and none are
# claimed. The remainder is billed to CAP_DROPPED because that is what actually
# happened: the hook's own entry bound dropped it.
OV_COUNT=0
class_overflow() {
  OV_COUNT=0
  _ovs="$(grep -E "$1" "$MATRIX" 2>/dev/null \
        | tail -n "+$((SCAN_BOUND + 1))" 2>/dev/null \
        | sed -E 's/^[A-Za-z0-9_]+="?//; s/"$//' 2>/dev/null \
        | wc -lc 2>/dev/null || true)"
  # `wc -lc` prints "<lines> <chars>". sed terminates every line it writes, so a
  # tail entry costs value+1 bytes there against the "- value\n" = value+3 the
  # projection would have spent on it — hence the +2 per line.
  set -- $_ovs
  _ovn="${1:-0}"; _ovc="${2:-0}"
  case "$_ovn" in ''|*[!0-9]*) _ovn=0 ;; esac
  case "$_ovc" in ''|*[!0-9]*) _ovc=0 ;; esac
  [ "$_ovn" -gt 0 ] 2>/dev/null || return 0
  OV_COUNT="$_ovn"
  HELD_TOTAL=$((HELD_TOTAL + _ovn))
  CAP_DROPPED=$((CAP_DROPPED + _ovn))
  WANT_BYTES=$((WANT_BYTES + _ovc + 2 * _ovn))
}

# render_class <extended-regex> <per-class-cap> <ttl-cut-off-key>
#   in : COUNT / MAX_ENTRIES / SCAN_BOUND / HELD_TOTAL / WANT_BYTES / *_DROPPED
#   out: CLS_SECTION (printf-%b body), CLS_N (emitted), CLS_HELD (candidates)
# A class is emitted in projection-priority order by the call sites below, so the
# shared MAX_ENTRIES budget is consumed most-important-first and anything the cap
# eats is necessarily the tail of RECONCILE_DROP_ORDER — an ordered, logged drop
# rather than the silent `break` this hook used to rely on.
#
# The class reads itself rather than taking pre-grepped lines, so a turn that
# never reaches a class never pays for its grep, and so the walker and
# class_overflow can never be handed two different patterns for the same class.
render_class() {
  CLS_SECTION=""
  CLS_N=0
  CLS_HELD=0
  _pat="$1"
  _cap="$2"
  _ccut="$3"
  read_bounded "$_pat"
  _lines="$RB_LINES"
  [ -n "$_lines" ] || return 0
  _seen=0
  while IFS= read -r _l; do
    [ -n "$_l" ] || continue
    _seen=$((_seen + 1))
    if [ "$_seen" -gt "$SCAN_BOUND" ]; then
      class_overflow "$_pat"
      CLS_HELD=$((CLS_HELD + OV_COUNT))
      break
    fi
    set_value "$_l"
    _v="$VAL"
    CLS_HELD=$((CLS_HELD + 1))
    HELD_TOTAL=$((HELD_TOTAL + 1))
    WANT_BYTES=$((WANT_BYTES + ${#_v} + 3))
    if ! is_fresh "$_v" "$_ccut"; then
      TTL_DROPPED=$((TTL_DROPPED + 1))
      continue
    fi
    if [ "$CLS_N" -ge "$_cap" ] 2>/dev/null || [ "$COUNT" -ge "$MAX_ENTRIES" ] 2>/dev/null; then
      CAP_DROPPED=$((CAP_DROPPED + 1))
      continue
    fi
    CLS_SECTION="${CLS_SECTION}- ${_v}\n"
    CLS_N=$((CLS_N + 1))
    COUNT=$((COUNT + 1))
  done <<EOF
$_lines
EOF
}

# tally_class <extended-regex> → $TALLY_N (+ HELD_TOTAL / WANT_BYTES)
#   The receipt-only twin of render_class, for a turn whose projection is known
#   IN ADVANCE to be discarded. It skips freshness, project-root relevance, the
#   caps and section assembly, because a stale-matrix turn keeps none of those —
#   only the held counts and the size of what went unsaid reach the operator.
TALLY_N=0
tally_class() {
  TALLY_N=0
  _tpat="$1"
  read_bounded "$_tpat"
  _tlines="$RB_LINES"
  [ -n "$_tlines" ] || return 0
  _tn=0
  while IFS= read -r _tl; do
    [ -n "$_tl" ] || continue
    _tn=$((_tn + 1))
    if [ "$_tn" -gt "$SCAN_BOUND" ]; then
      class_overflow "$_tpat"
      _tn=$((_tn - 1 + OV_COUNT))
      break
    fi
    set_value "$_tl"
    HELD_TOTAL=$((HELD_TOTAL + 1))
    WANT_BYTES=$((WANT_BYTES + ${#VAL} + 3))
  done <<EOF
$_tlines
EOF
  TALLY_N="$_tn"
}

# ── The one unconditional read: presence + the reconcile heartbeat ────────────
# Every other class is read lazily by the walker that needs it, so a turn that
# short-circuits (harness disabled, or a stale matrix whose projection would be
# thrown away regardless) never pays for greps whose output it will discard.
MATRIX_PRESENT=0
HEARTBEAT=""
if [ -f "$MATRIX" ]; then
  MATRIX_PRESENT=1
  HEARTBEAT="$(grep -E '^PD_RECON_HEARTBEAT_TS=' "$MATRIX" 2>/dev/null | head -n1 || true)"
  if [ -n "$HEARTBEAT" ]; then
    set_value "$HEARTBEAT"
    HEARTBEAT="$VAL"
  fi
fi

# Per-class match patterns, named once so that the walker, the overflow tally and
# the stale-path tally can never drift apart.
#
# PER-ACTOR CLASSES. The anchored prefix is the whole isolation mechanism: a
# message addressed to actor A is a key actor B's grep cannot match. With no
# PD_ACTOR we leave the pattern EMPTY and read neither class rather than guessing
# — and read_bounded refuses an empty pattern outright, because `grep -E ""`
# matches every line in the matrix.
#
# The DOUBLE underscore is load-bearing (PER_ACTOR_SEPARATOR in
# lib/squid/reconcile-contract.ts). With a single one, actor `alpha` matched
# `PD_INBOX_ALPHA_TWO_M1` — actor `alpha-two`'s mail — because nothing marked
# where the actor address ended. pd_actor_key() collapses runs of
# non-alphanumerics to ONE underscore and strips the ends, so `__` is a
# boundary a normalized actor id can never contain.
P_HALT='^PD_HALT='
P_CLAIM='^PD_CLAIM_[A-Za-z0-9_]+='
P_CI='^PD_CI_[A-Za-z0-9_]+='
P_ACC='^PD_ACCOMPLISHMENT_[A-Za-z0-9_]+='
P_ALERT='^PD_ALERT_[A-Za-z0-9_]+='
P_FA='^PD_ALERT_FLEET_APPROVALS='
P_PHER='^PD_PHEROMONE_[A-Za-z0-9_]+='
P_PARLEY=""
P_INBOX=""
if [ -n "$ACTOR_KEY" ]; then
  P_PARLEY="^PD_PARLEY_${ACTOR_KEY}__[A-Za-z0-9_]+="
  P_INBOX="^PD_INBOX_${ACTOR_KEY}__[A-Za-z0-9_]+="
fi

# ── Staleness: fail OPEN, loudly in the log, silently in the context ─────────
# isMatrixStale() semantics. An ABSENT heartbeat is deliberately NOT stale: it
# means the matrix predates the reconcile loop (or the loop was never enabled),
# and muting every pre-reconcile fleet would be a regression, not a safety win.
STALE=0
case "${HEARTBEAT:-}" in
  ''|*[!0-9]*) ;;
  *) [ $((NOW_MS - HEARTBEAT)) -ge "$STALE_AFTER_MS" ] 2>/dev/null && STALE=1 ;;
esac

DISABLED=0
case "${PD_SQUID_DISABLED:-}" in 1|true|TRUE|yes|on) DISABLED=1 ;; esac

# ── Project-root relevance (exact root, never a basename substring) ──────────
BASENAME="$(basename "$CWD" 2>/dev/null || echo "$CWD")"
PROJECT_ROOT="$CWD"
d="$CWD"
while [ -n "$d" ] && [ "$d" != "/" ]; do
  if [ -d "$d/.portdaddy" ]; then PROJECT_ROOT="$d"; break; fi
  d="$(dirname "$d" 2>/dev/null || true)"
done

SEC_HALT=""; SEC_PARLEY=""; SEC_ALERT=""; SEC_CLAIM=""
SEC_CI=""; SEC_INBOX=""; SEC_ACC=""; SEC_PHER=""
N_HALT=0; N_PARLEY=0; N_FA=0; N_ALERT=0; N_CLAIM=0
N_CI=0; N_INBOX=0; N_ACC=0; N_PHER=0
H_HALT=0; H_PARLEY=0; H_FA=0; H_ALERT=0; H_CLAIM=0
H_CI=0; H_INBOX=0; H_ACC=0; H_PHER=0

if [ "$DISABLED" -eq 1 ]; then
  : # Nothing is read, nothing is projected, nothing is counted.
elif [ "$STALE" -eq 1 ]; then
  # ── Stale matrix → COUNT the candidates, never project them ────────────────
  # isMatrixStale() means every section built below would be built and then
  # deleted: a ten-minute-old halt is not proof the operator still wants the
  # fleet stopped, so nothing may reach the model. The old shape ran the full
  # projection first anyway, purely so the VoiceLog could report what it HELD —
  # measured at ~23 seconds of freshness parsing and section assembly for zero
  # emitted bytes on a 2000-key matrix, which is precisely the matrix a dead
  # daemon produces (nothing GCs it while pd-hook-post-tool keeps appending).
  # The held counts and the size of the unsaid thing are the ONLY survivors of
  # that work, so now they are the only things gathered.
  tally_class "$P_HALT";   H_HALT="$TALLY_N"
  tally_class "$P_PARLEY"; H_PARLEY="$TALLY_N"
  tally_class "$P_ALERT";  H_ALERT="$TALLY_N"
  tally_class "$P_CLAIM";  H_CLAIM="$TALLY_N"
  tally_class "$P_CI";     H_CI="$TALLY_N"
  tally_class "$P_INBOX";  H_INBOX="$TALLY_N"
  tally_class "$P_ACC";    H_ACC="$TALLY_N"
  tally_class "$P_PHER";   H_PHER="$TALLY_N"
  # PD_ALERT_FLEET_APPROVALS is the registry's FLEET_APPROVALS class and every
  # other PD_ALERT_* is a legacy steering alert; one anchored -c splits them so
  # the VoiceLog never reports a pre-reconcile alert as a reconciled approval.
  H_FA="$(grep -cE "$P_FA" "$MATRIX" 2>/dev/null || true)"
  case "${H_FA:-}" in ''|*[!0-9]*) H_FA=0 ;; esac
  [ "$H_FA" -le "$H_ALERT" ] 2>/dev/null || H_FA="$H_ALERT"
  H_ALERT=$((H_ALERT - H_FA))
else
  # Emission order = RECONCILE_PROJECTION_ORDER (HALT, PARLEY, FLEET_APPROVALS,
  # CLAIM, CI, INBOX, ACCOMPLISHMENT), then the legacy pheromone trail. HALT gets
  # cut-off 0: priority 1 is effectively undroppable, and a halt the operator
  # pulled must not expire out from under the fleet on a clock technicality.
  render_class "$P_HALT" "$CAP_HALT" 0
  SEC_HALT="$CLS_SECTION"; N_HALT="$CLS_N"; H_HALT="$CLS_HELD"

  render_class "$P_PARLEY" "$CAP_PARLEY" "$CUT_TTL"
  SEC_PARLEY="$CLS_SECTION"; N_PARLEY="$CLS_N"; H_PARLEY="$CLS_HELD"

  # Alerts: PD_ALERT_FLEET_APPROVALS is the registry's FLEET_APPROVALS class;
  # every other PD_ALERT_* is a legacy steering alert. Counted apart so the
  # VoiceLog does not report a pre-reconcile alert as a reconciled approval.
  read_bounded "$P_ALERT"
  L_ALERT="$RB_LINES"
  if [ -n "$L_ALERT" ]; then
    seen=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      seen=$((seen + 1))
      if [ "$seen" -gt "$SCAN_BOUND" ]; then
        class_overflow "$P_ALERT"
        # The split stays exact past the bound too: FLEET_APPROVALS is a single
        # anchored key, so one -c over the whole file says how many of the
        # un-walked matches were approvals rather than legacy steering alerts.
        fa_all="$(grep -cE "$P_FA" "$MATRIX" 2>/dev/null || true)"
        case "${fa_all:-}" in ''|*[!0-9]*) fa_all=0 ;; esac
        fa_tail=$((fa_all - H_FA))
        [ "$fa_tail" -ge 0 ] 2>/dev/null || fa_tail=0
        [ "$fa_tail" -le "$OV_COUNT" ] 2>/dev/null || fa_tail="$OV_COUNT"
        H_FA=$((H_FA + fa_tail))
        H_ALERT=$((H_ALERT + OV_COUNT - fa_tail))
        break
      fi
      key="${line%%=*}"
      set_value "$line"
      val="$VAL"
      HELD_TOTAL=$((HELD_TOTAL + 1))
      WANT_BYTES=$((WANT_BYTES + ${#val} + 3))
      if [ "$key" = "PD_ALERT_FLEET_APPROVALS" ]; then
        H_FA=$((H_FA + 1))
      else
        H_ALERT=$((H_ALERT + 1))
      fi
      if ! is_fresh "$val" "$CUT_TTL"; then
        TTL_DROPPED=$((TTL_DROPPED + 1))
        continue
      fi
      if [ "$COUNT" -ge "$MAX_ENTRIES" ] 2>/dev/null; then
        CAP_DROPPED=$((CAP_DROPPED + 1))
        continue
      fi
      SEC_ALERT="${SEC_ALERT}- ${val}\n"
      COUNT=$((COUNT + 1))
      if [ "$key" = "PD_ALERT_FLEET_APPROVALS" ]; then
        N_FA=$((N_FA + 1))
      else
        N_ALERT=$((N_ALERT + 1))
      fi
    done <<EOF
$L_ALERT
EOF
  fi

  render_class "$P_CLAIM" "$CAP_CLAIM" "$CUT_TTL"
  SEC_CLAIM="$CLS_SECTION"; N_CLAIM="$CLS_N"; H_CLAIM="$CLS_HELD"

  render_class "$P_CI" "$CAP_CI" "$CUT_TTL"
  SEC_CI="$CLS_SECTION"; N_CI="$CLS_N"; H_CI="$CLS_HELD"

  render_class "$P_INBOX" "$CAP_INBOX" "$CUT_TTL"
  SEC_INBOX="$CLS_SECTION"; N_INBOX="$CLS_N"; H_INBOX="$CLS_HELD"

  render_class "$P_ACC" "$CAP_ACC" "$CUT_ACC"
  SEC_ACC="$CLS_SECTION"; N_ACC="$CLS_N"; H_ACC="$CLS_HELD"

  # Pheromones carry the extra exact-project-root filter: `app` must never
  # receive traces from `other-app`.
  read_bounded "$P_PHER"
  L_PHER="$RB_LINES"
  if [ -n "$L_PHER" ]; then
    seen=0
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      seen=$((seen + 1))
      if [ "$seen" -gt "$SCAN_BOUND" ]; then
        class_overflow "$P_PHER"
        H_PHER=$((H_PHER + OV_COUNT))
        break
      fi
      set_value "$line"
      val="$VAL"
      H_PHER=$((H_PHER + 1))
      HELD_TOTAL=$((HELD_TOTAL + 1))
      WANT_BYTES=$((WANT_BYTES + ${#val} + 3))
      if ! is_fresh "$val" "$CUT_TTL"; then
        TTL_DROPPED=$((TTL_DROPPED + 1))
        continue
      fi
      subject="${val%% | *}"
      case "$subject" in
        "$PROJECT_ROOT"|"$PROJECT_ROOT"/*) ;;
        *) ROOT_DROPPED=$((ROOT_DROPPED + 1)); continue ;;
      esac
      if [ "$COUNT" -ge "$MAX_ENTRIES" ] 2>/dev/null; then
        CAP_DROPPED=$((CAP_DROPPED + 1))
        continue
      fi
      SEC_PHER="${SEC_PHER}- ${val}\n"
      N_PHER=$((N_PHER + 1))
      COUNT=$((COUNT + 1))
    done <<EOF
$L_PHER
EOF
  fi
fi

# NOTE: there is no "discard the projection because the matrix was stale" step
# here any more. A stale matrix takes the tally-only branch above, so the SEC_*
# sections and N_* emitted counts were never built in the first place and COUNT
# is still 0 — the held counts survive as `counts` on a `suppressed /
# stale-matrix` line, visible to the operator and invisible to the model, which
# is the same contract the discard step used to deliver at O(matrix) cost.

# ── The conditional standing directive ───────────────────────────────────────
HAS_CONTENT=0
[ "$COUNT" -gt 0 ] && HAS_CONTENT=1

NAG_KEY="${ACTOR_KEY:-ANON}"
NAG_FILE="$NAG_DIR/$NAG_KEY"
NAG_DUE=1
LAST=""
[ -f "$NAG_FILE" ] && LAST="$(head -n1 "$NAG_FILE" 2>/dev/null || true)"
case "${LAST:-}" in
  ''|*[!0-9]*) NAG_DUE=1 ;;
  *) [ $((NOW - LAST)) -lt "$NAG_INTERVAL" ] 2>/dev/null && NAG_DUE=0 ;;
esac

SHOW_DIRECTIVE=0
if [ "$DISABLED" -eq 0 ]; then
  if [ "$HAS_CONTENT" -eq 1 ] || [ "$NAG_DUE" -eq 1 ]; then SHOW_DIRECTIVE=1; fi
fi
if [ "$SHOW_DIRECTIVE" -eq 1 ]; then
  # Fail-open: an unwritable $PD_HOME just means the nag timer never persists, so
  # the directive shows every turn (noisier, never broken).
  { mkdir -p "$NAG_DIR" 2>/dev/null && printf '%s\n' "$NOW" > "$NAG_FILE" 2>/dev/null; } || true
fi

# ── Assemble the envelope ────────────────────────────────────────────────────
# Headings group PARLEY+INBOX as "FOR YOU" (both are addressed to this agent and
# read as one mailbox) even though the budget above was spent in strict
# projection-priority order.
OUT=""
if [ -n "$SEC_HALT" ]; then
  OUT="${OUT}[PORT DADDY — HALT]\n${SEC_HALT}"
fi
if [ -n "$SEC_PARLEY" ] || [ -n "$SEC_INBOX" ]; then
  OUT="${OUT}[PORT DADDY — FOR YOU]\n${SEC_PARLEY}${SEC_INBOX}"
fi
if [ -n "$SEC_ALERT" ] || [ "$SHOW_DIRECTIVE" -eq 1 ]; then
  OUT="${OUT}[PORT DADDY — STEERING ALERTS]\n"
  if [ "$SHOW_DIRECTIVE" -eq 1 ]; then
    OUT="${OUT}- Agent must maintain an active pd plan and run pd sitrep to synthesize state.\n"
  fi
  OUT="${OUT}${SEC_ALERT}"
fi
if [ -n "$SEC_CLAIM" ] || [ -n "$SEC_CI" ] || [ -n "$SEC_ACC" ]; then
  OUT="${OUT}[PORT DADDY — FLEET]\n${SEC_CLAIM}${SEC_CI}${SEC_ACC}"
fi
if [ -n "$SEC_PHER" ]; then
  OUT="${OUT}[PORT DADDY — PHEROMONE TRACES near ${BASENAME}]\n${SEC_PHER}"
fi

# Emit the bounded Suggestibility Envelope (printf interprets the \n we built
# up; head -c enforces the byte cap). Prefer Claude Code's SANCTIONED structured
# UserPromptSubmit output — hookSpecificOutput.additionalContext — which the runtime
# frames as TRUSTED harness context. Raw stdout (the old path) reads to the model as
# untrusted injected content, which is why Claude Code balked at it as prompt
# injection. Same structured shape the pre-tool tentacle already uses.
# Fail-open: no jq → fall back to raw stdout (degraded framing, still advisory).
FULL=""
BLOCK=""
FULL_BYTES=0
EMITTED_BYTES=0
if [ -n "$OUT" ]; then
  FULL="$(printf '%b' "$OUT")"
  FULL_BYTES="$(printf '%s' "$FULL" | wc -c 2>/dev/null | tr -d ' ')"
  case "$FULL_BYTES" in ''|*[!0-9]*) FULL_BYTES=0 ;; esac
  BLOCK="$(printf '%s' "$FULL" | head -c "$MAX_BYTES" 2>/dev/null)"
  EMITTED_BYTES="$(printf '%s' "$BLOCK" | wc -c 2>/dev/null | tr -d ' ')"
  case "$EMITTED_BYTES" in ''|*[!0-9]*) EMITTED_BYTES=0 ;; esac
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg ctx "$BLOCK" \
      '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}'
  else
    printf '%s' "$BLOCK"
  fi
fi

# =============================================================================
# VOICE LOG — everything past this point is observability and MUST NOT be able
# to change stdout or the exit code. stdout is already flushed above.
# =============================================================================
# WANT_BYTES was tallied inline by the walkers (and, past the scan bound, by
# class_overflow's single batched pipeline), so there is nothing to measure here.
case "$WANT_BYTES" in ''|*[!0-9]*) WANT_BYTES=0 ;; esac

json_escape() {
  printf '%s' "${1:-}" | tr -d '\000-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# {"NAME":n,...} over NAME=n pairs, skipping zeros. Motivation: a count of 0 and
# an absent class are the same fact, and emitting both doubles the line width of
# the most frequently written line in the system.
json_counts() {
  _o=""
  for _p in "$@"; do
    _n="${_p%%=*}"
    _c="${_p#*=}"
    [ "$_c" -gt 0 ] 2>/dev/null || continue
    [ -z "$_o" ] || _o="${_o},"
    _o="${_o}\"${_n}\":${_c}"
  done
  printf '{%s}' "$_o"
}

json_array() {
  _o=""
  for _x in "$@"; do
    [ -n "$_x" ] || continue
    [ -z "$_o" ] || _o="${_o},"
    _o="${_o}\"${_x}\""
  done
  printf '[%s]' "$_o"
}

# Byte-bounded rotation, tail-kept. A line-count tail is NOT a bound (one absurd
# line defeats it), so we cut on bytes and drop the leading partial line. The
# rotate + append are individually guarded: this file is written on EVERY turn of
# EVERY agent, which is exactly the loop shape skills/responsible-logging says
# must never be able to take the process down.
write_voice_log() {
  _line="$1"
  _dir="$(dirname "$VOICE_LOG" 2>/dev/null || printf '.')"
  mkdir -p "$_dir" 2>/dev/null || return 0
  if [ -f "$VOICE_LOG" ]; then
    _sz="$(wc -c < "$VOICE_LOG" 2>/dev/null | tr -d ' ' || printf '0')"
    case "${_sz:-}" in ''|*[!0-9]*) _sz=0 ;; esac
    if [ "$_sz" -gt "$VOICE_LOG_MAX_BYTES" ] 2>/dev/null; then
      _keep=$((VOICE_LOG_MAX_BYTES / 2))
      _tmp="${VOICE_LOG}.rot.$$"
      if tail -c "$_keep" "$VOICE_LOG" 2>/dev/null | sed '1d' > "$_tmp" 2>/dev/null; then
        mv -f "$_tmp" "$VOICE_LOG" 2>/dev/null || rm -f "$_tmp" 2>/dev/null || true
      else
        rm -f "$_tmp" 2>/dev/null || true
      fi
    fi
  fi
  printf '%s\n' "$_line" >> "$VOICE_LOG" 2>/dev/null || return 0
  return 0
}

build_and_write_voice_log() {
  _actor="$(json_escape "$SELF")"
  _ts=$((NOW * 1000))
  _base="\"ts\":${_ts},\"actor\":\"${_actor}\",\"hookEvent\":\"UserPromptSubmit\""

  _counts_emitted="$(json_counts \
    "HALT=$N_HALT" "PARLEY=$N_PARLEY" "FLEET_APPROVALS=$N_FA" "CLAIM=$N_CLAIM" \
    "CI=$N_CI" "INBOX=$N_INBOX" "ACCOMPLISHMENT=$N_ACC" "ALERT=$N_ALERT" \
    "PHEROMONE=$N_PHER")"
  _counts_held="$(json_counts \
    "HALT=$H_HALT" "PARLEY=$H_PARLEY" "FLEET_APPROVALS=$H_FA" "CLAIM=$H_CLAIM" \
    "CI=$H_CI" "INBOX=$H_INBOX" "ACCOMPLISHMENT=$H_ACC" "ALERT=$H_ALERT" \
    "PHEROMONE=$H_PHER")"

  # Emission order (RECONCILE_PROJECTION_ORDER + the two legacy classes).
  _cls=""
  [ "$N_HALT" -gt 0 ] && _cls="$_cls HALT"
  [ "$N_PARLEY" -gt 0 ] && _cls="$_cls PARLEY"
  [ "$N_FA" -gt 0 ] && _cls="$_cls FLEET_APPROVALS"
  [ "$N_ALERT" -gt 0 ] && _cls="$_cls ALERT"
  [ "$N_CLAIM" -gt 0 ] && _cls="$_cls CLAIM"
  [ "$N_CI" -gt 0 ] && _cls="$_cls CI"
  [ "$N_INBOX" -gt 0 ] && _cls="$_cls INBOX"
  [ "$N_ACC" -gt 0 ] && _cls="$_cls ACCOMPLISHMENT"
  [ "$N_PHER" -gt 0 ] && _cls="$_cls PHEROMONE"

  # RECONCILE_DROP_ORDER (lowest priority first), with the legacy classes seated
  # by the priority they are actually emitted at.
  _dropped=""
  [ "$H_PHER" -gt "$N_PHER" ] && _dropped="$_dropped PHEROMONE"
  [ "$H_ACC" -gt "$N_ACC" ] && _dropped="$_dropped ACCOMPLISHMENT"
  [ "$H_INBOX" -gt "$N_INBOX" ] && _dropped="$_dropped INBOX"
  [ "$H_CI" -gt "$N_CI" ] && _dropped="$_dropped CI"
  [ "$H_CLAIM" -gt "$N_CLAIM" ] && _dropped="$_dropped CLAIM"
  [ "$H_ALERT" -gt "$N_ALERT" ] && _dropped="$_dropped ALERT"
  [ "$H_FA" -gt "$N_FA" ] && _dropped="$_dropped FLEET_APPROVALS"
  [ "$H_PARLEY" -gt "$N_PARLEY" ] && _dropped="$_dropped PARLEY"
  [ "$H_HALT" -gt "$N_HALT" ] && _dropped="$_dropped HALT"

  # shellcheck disable=SC2086
  _classes_json="$(json_array $_cls)"
  # shellcheck disable=SC2086
  _dropped_json="$(json_array $_dropped)"

  _outcome=""
  _reason=""
  if [ "$DISABLED" -eq 1 ]; then
    _outcome="silent"; _reason="harness-disabled"
  elif [ "$STALE" -eq 1 ]; then
    _outcome="suppressed"; _reason="stale-matrix"
  elif [ "$MATRIX_PRESENT" -eq 0 ]; then
    _outcome="silent"; _reason="matrix-absent"
  elif [ "$HELD_TOTAL" -eq 0 ]; then
    _outcome="silent"; _reason="no-entries"
  elif [ "$COUNT" -eq 0 ]; then
    # It HELD something and emitted none of it — name the bound that ate it.
    if [ "$TTL_DROPPED" -gt 0 ]; then
      _outcome="suppressed"; _reason="ttl-expired"
    elif [ "$ROOT_DROPPED" -gt 0 ]; then
      _outcome="suppressed"; _reason="not-relevant-to-cwd"
    elif [ "$CAP_DROPPED" -gt 0 ]; then
      _outcome="suppressed"; _reason="over-entry-cap"
    else
      _outcome="silent"; _reason="no-entries"
    fi
  elif [ "$FULL_BYTES" -gt "$MAX_BYTES" ] 2>/dev/null; then
    _outcome="suppressed"; _reason="over-budget"
  elif [ "$CAP_DROPPED" -gt 0 ]; then
    _outcome="suppressed"; _reason="over-entry-cap"
  elif [ "$TTL_DROPPED" -gt 0 ]; then
    _outcome="suppressed"; _reason="ttl-expired"
  elif [ "$ROOT_DROPPED" -gt 0 ]; then
    _outcome="suppressed"; _reason="not-relevant-to-cwd"
  else
    _outcome="spoke"; _reason=""
  fi

  # A turn that put BYTES in front of the model is never "silent". The standing
  # plan directive is emitted on its own on a nag-due turn (SHOW_DIRECTIVE=1)
  # while HELD_TOTAL is 0, so the classification above would file a turn the
  # harness genuinely spoke on as silent/no-entries — and summarize() counts
  # `silent` toward saidNothing/quietRate, so `pd squid voice` would report a
  # talking harness as 100% quiet. `counts`/`classes` stay empty because no
  # matrix class was projected; the bytes are the directive's.
  if [ "$_outcome" = "silent" ] && [ "$EMITTED_BYTES" -gt 0 ] 2>/dev/null; then
    _outcome="spoke"; _reason=""
  fi

  case "$_outcome" in
    spoke)
      _json="{${_base},\"outcome\":\"spoke\",\"counts\":${_counts_emitted},\"bytes\":${EMITTED_BYTES},\"classes\":${_classes_json}}"
      ;;
    silent)
      _json="{${_base},\"outcome\":\"silent\",\"reason\":\"${_reason}\"}"
      ;;
    *)
      _json="{${_base},\"outcome\":\"suppressed\",\"reason\":\"${_reason}\",\"counts\":${_counts_held},\"bytes\":${WANT_BYTES},\"droppedClasses\":${_dropped_json},\"emittedBytes\":${EMITTED_BYTES}}"
      ;;
  esac
  write_voice_log "$_json"
}

build_and_write_voice_log 2>/dev/null || true
exit 0
