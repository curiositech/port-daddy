#!/bin/sh
# pd-hook-prompt — UserPromptSubmit tentacle (ADR-0091, Giant Squid Harness)
# =============================================================================
# Claude Code (and parity-verified vendors) invoke this on UserPromptSubmit with
# the prompt event JSON on stdin. We grep the Ink Cloud matrix for steering
# Alerts (PD_ALERT_*) and Pheromones (PD_PHEROMONE_*) relevant to the current
# working directory and print them to stdout. Claude Code PREPENDS hook stdout to
# the model's context for that turn — that is the "Suggestibility Envelope".
#
# CONTRACT: exit 0 always (this tentacle is ADVISORY, never blocking). Any error
# must fail OPEN — emit nothing, let the turn proceed un-steered. A hook that
# crashes the CLI is a broken product; a hook that stays quiet is merely degraded
# coordination (ADR §Mitigation).
#
# Dependency-light: pure POSIX sh + grep/sed. jq is used only to read `cwd` from
# the event JSON when present; we fall back to $PWD. No node required.
set -u

PD_HOME="${PD_HOME:-$HOME/.port-daddy}"
MATRIX="${PD_MATRIX_FILE:-$PD_HOME/matrix.env}"
MAX_ENTRIES="${PD_SQUID_PROMPT_MAX_ENTRIES:-12}"
MAX_BYTES="${PD_SQUID_PROMPT_MAX_BYTES:-4096}"
TTL_SECONDS="${PD_SQUID_PROMPT_TTL_SECONDS:-1800}"
# Hard cap on candidate lines entering the expensive per-line loop below, no
# matter how many the cheap grep prefilter still lets through. Without this, a
# long-lived, multi-project fleet whose matrix.env accumulates thousands of
# pheromones (unbounded — the writer, pd-hook-post-tool, does not prune) makes
# this hook's per-line sed/date forks the dominant cost: at ~3k lines this hook
# measured 20-30s+ (timeout) before this fix.
SCAN_CAP="${PD_SQUID_PROMPT_SCAN_CAP:-60}"

# Drain stdin so the CLI's pipe write never blocks, capturing it for cwd parsing.
EVENT="$(cat 2>/dev/null || true)"

# Best-effort cwd from the event; harmless fallback to $PWD.
CWD="$PWD"
if command -v jq >/dev/null 2>&1 && [ -n "$EVENT" ]; then
  J="$(printf '%s' "$EVENT" | jq -r '.cwd // .workspace // empty' 2>/dev/null || true)"
  [ -n "$J" ] && CWD="$J"
fi

# Relevance: use the exact pd project root (or cwd when no marker is available),
# never a basename substring. `app` must not receive traces from `other-app`.
BASENAME="$(basename "$CWD" 2>/dev/null || echo "$CWD")"
PROJECT_ROOT="$CWD"
d="$CWD"
while [ -n "$d" ] && [ "$d" != "/" ]; do
  if [ -d "$d/.portdaddy" ]; then PROJECT_ROOT="$d"; break; fi
  d="$(dirname "$d" 2>/dev/null || true)"
done

# Read the matrix once if it exists. Alerts are rare and always global, so a
# capped raw grep is enough. Pheromones are what blow up at scale (one per
# file mutation, fleet-wide, forever), so they get ONE extra cheap substring
# prefilter (`grep -F`, still O(1) forks total — not one per line) narrowing
# to lines that at least mention this project root before ANY per-line
# sed/date work runs below. The prefilter is intentionally loose (substring,
# not the exact prefix the per-line loop enforces) so it can only ever admit
# false positives, never drop a true match — correctness stays with the
# per-line loop; this is purely a cost-shaping pass.
ALERTS=""
PHER=""
if [ -f "$MATRIX" ]; then
  # tail, not head: the matrix is append-only (oldest first), and only the
  # freshest entries can pass is_fresh below — taking the oldest SCAN_CAP
  # matches would force a full-cap scan that rejects every one of them on a
  # quiet/idle matrix, instead of finding fresh matches and breaking early.
  ALERTS="$(grep -E '^PD_ALERT_[A-Za-z0-9_]+=' "$MATRIX" 2>/dev/null | tail -n "$SCAN_CAP" || true)"
  PHER="$(grep -E '^PD_PHEROMONE_[A-Za-z0-9_]+=' "$MATRIX" 2>/dev/null | grep -F -- "$PROJECT_ROOT" | tail -n "$SCAN_CAP" || true)"
fi

emit_value() {
  # $1 = a `KEY="val"` matrix line → print just the unquoted value.
  printf '%s\n' "$1" | sed -E 's/^[A-Za-z0-9_]+="?//; s/"$//'
}

# ── SITREP dial (per-repo end-of-turn compulsion) ────────────────────────────
# Mirrors the ADR-0092 suggestibility dial's resolution shape: PD_SITREP env
# override first, then a parent-walk over agent.config.json /
# .portdaddy/sitrep.json / .portdaddy/project.json reading `.sitrep.endOfTurn`
# (or a bare `.sitrep` string). Closed enum off|suggest|enforce. DEFAULT IS
# OFF — unlike suggestibility (a safety gate that fails closed to enforce),
# sitrep INJECTS instruction text every turn, so an unreadable/absent config
# must fail toward silence, never toward shouting into every repo on the box.

normalize_sitrep() {
  LEVEL="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  case "$LEVEL" in
    off|suggest|enforce) printf '%s' "$LEVEL" ;;
    *) printf '' ;;
  esac
}

json_sitrep_level() {
  CFG="$1"
  [ -f "$CFG" ] || return 0
  if command -v jq >/dev/null 2>&1; then
    # `if type` guard: a bare-string dial ("sitrep": "suggest") must fall
    # through, and a naive `.sitrep.endOfTurn // .sitrep` hard-errors in jq
    # when .sitrep is a string ("Cannot index string"), reading as no dial.
    jq -r '(.sitrep | if type == "object" then .endOfTurn else . end) // empty' "$CFG" 2>/dev/null || true
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$CFG" <<'PY' 2>/dev/null || true
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise SystemExit
    value = data.get("sitrep")
    if isinstance(value, dict):
        value = value.get("endOfTurn")
    if isinstance(value, str):
        print(value)
except Exception:
    pass
PY
    return 0
  fi
  # No JSON parser available → no dial. The caller's default (off) keeps the
  # envelope quiet rather than letting a raw text scan compel output.
  return 0
}

config_sitrep_level() {
  DIR="$CWD"
  case "$DIR" in
    /*) : ;;
    *) DIR="$(pwd 2>/dev/null || printf '.')" ;;
  esac
  while [ -n "$DIR" ] && [ "$DIR" != "/" ]; do
    for CFG in "$DIR/agent.config.json" "$DIR/.portdaddy/sitrep.json" "$DIR/.portdaddy/project.json"; do
      RAW="$(json_sitrep_level "$CFG" | head -n1)"
      LEVEL="$(normalize_sitrep "$RAW")"
      [ -n "$LEVEL" ] && { printf '%s' "$LEVEL"; return 0; }
    done
    NEXT="$(dirname "$DIR" 2>/dev/null || printf '/')"
    [ "$NEXT" = "$DIR" ] && break
    DIR="$NEXT"
  done
  printf ''
}

is_fresh() {
  # Untagged legacy entries remain visible; every new writer includes ts:<ISO>.
  ts="$(printf '%s\n' "$1" | sed -nE 's/.*\| ts:([^ |]+).*/\1/p')"
  [ -n "$ts" ] || return 0
  compact="$(printf '%s' "$ts" | sed -E 's/\.[0-9]+Z$/Z/')"
  epoch="$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$compact" '+%s' 2>/dev/null || true)"
  [ -n "$epoch" ] || epoch="$(date -u -d "$compact" '+%s' 2>/dev/null || true)"
  case "$epoch" in ''|*[!0-9]*) return 1 ;; esac
  now="$(date +%s 2>/dev/null || true)"
  case "$now" in ''|*[!0-9]*) return 1 ;; esac
  age=$((now - epoch))
  [ "$age" -ge 0 ] 2>/dev/null && [ "$age" -le "$TTL_SECONDS" ] 2>/dev/null
}

OUT=""
COUNT=0
OUT="${OUT}[PORT DADDY — STEERING ALERTS]\n"
OUT="${OUT}- Agent must maintain an active pd plan and run pd sitrep to synthesize state.\n"

if [ -n "$ALERTS" ]; then
  SECTION=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$COUNT" -lt "$MAX_ENTRIES" ] 2>/dev/null || break
    val="$(emit_value "$line")"
    is_fresh "$val" || continue
    SECTION="${SECTION}- ${val}\n"
    COUNT=$((COUNT + 1))
  done <<EOF
$ALERTS
EOF
  [ -z "$SECTION" ] || OUT="${OUT}${SECTION}"
fi

REL=""
if [ -n "$PHER" ]; then
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$COUNT" -lt "$MAX_ENTRIES" ] 2>/dev/null || break
    val="$(emit_value "$line")"
    is_fresh "$val" || continue
    subject="${val%% | *}"
    case "$subject" in
      "$PROJECT_ROOT"|"$PROJECT_ROOT"/*)
        REL="${REL}- ${val}\n"
        COUNT=$((COUNT + 1))
        ;;
    esac
  done <<EOF
$PHER
EOF
fi

# SITREP compulsion (before pheromones so it survives the byte cap): when the
# repo's dial is suggest/enforce, every turn carries the end-of-turn table
# contract. The table is the session's ledger of ideas, roadmap claims, and
# agent-assigned work — and any row that has code being written MUST be linked
# to a roadmap item at creation time.
SITREP="$(normalize_sitrep "${PD_SITREP:-}")"
[ -n "$SITREP" ] || SITREP="$(config_sitrep_level)"
[ -n "$SITREP" ] || SITREP="off"
if [ "$SITREP" != "off" ]; then
  OUT="${OUT}[PORT DADDY — SITREP ${SITREP}]\n"
  OUT="${OUT}End EVERY turn with a SITREP markdown table (scaffold: pd sitrep --template):\n"
  OUT="${OUT}| Idea / Suggestion / Remediation | Source (Agent/Operator) | Status | Related PR/Issue | Docs / Roadmap Link |\n"
  OUT="${OUT}Track every idea raised this session, every roadmap claim, and work assigned by other agents; update Status with the turn's progress and carry unresolved rows forward.\n"
  OUT="${OUT}A row you are writing code for MUST carry a roadmap link from the moment it is created — mint one first: pd roadmap upsert <slug> --summary \"...\" --estimate <units>.\n"
  if [ "$SITREP" = "enforce" ]; then
    OUT="${OUT}enforce: a turn that ends without the table is an incomplete turn — emit it before yielding.\n"
  fi
fi

if [ -n "$REL" ]; then
  OUT="${OUT}[PORT DADDY — PHEROMONE TRACES near ${BASENAME}]\n${REL}"
fi

# Emit the bounded Suggestibility Envelope (printf interprets the \n we built
# up; head -c enforces the byte cap). Prefer Claude Code's SANCTIONED structured
# UserPromptSubmit output — hookSpecificOutput.additionalContext — which the runtime
# frames as TRUSTED harness context. Raw stdout (the old path) reads to the model as
# untrusted injected content, which is why Claude Code balked at it as prompt
# injection. Same structured shape the pre-tool tentacle already uses.
# Fail-open: no jq → fall back to raw stdout (degraded framing, still advisory).
if [ -n "$OUT" ]; then
  BLOCK="$(printf '%b' "$OUT" | head -c "$MAX_BYTES" 2>/dev/null)"
  if command -v jq >/dev/null 2>&1; then
    jq -cn --arg ctx "$BLOCK" \
      '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:$ctx}}'
  else
    printf '%s' "$BLOCK"
  fi
fi
exit 0
