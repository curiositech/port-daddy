#!/bin/sh
# pd-hook-post-tool — PostToolUse tentacle (ADR-0091, Giant Squid Harness)
# =============================================================================
# Claude Code invokes this AFTER a tool runs, passing the PostToolUse event JSON
# on stdin: { tool_name, tool_input, tool_response|tool_result, cwd, ... }.
#
# This is "Heaving the Log" (pheromones). When the CLI successfully MUTATES a
# file (Edit/Write/MultiEdit/NotebookEdit), we acquire the matrix lock and append
# a PD_PHEROMONE_<subject>_<ts> trace into the Ink Cloud. K≥8 agents may do this
# concurrently; the lock keeps every appended line intact (ADR Success G5).
#
# Locking: prefer flock(1) when present (Linux). On macOS flock does NOT exist;
# we fall back to an atomic `mkdir` lock — the SAME lock directory the TS layer
# (lib/squid/matrix.ts) uses, so the two never tear each other's writes.
#
# Failure posture: always exit 0. A failed pheromone append is degraded
# coordination, never a broken loop.
set -u

PD_HOME="${PD_HOME:-$HOME/.port-daddy}"
MATRIX="${PD_MATRIX_FILE:-$PD_HOME/matrix.env}"
LOCKDIR="${MATRIX}.lock"
SELF="${PD_ACTOR:-unknown}"

# How many 10ms attempts to make on the matrix lock before giving up. 500 ≈ 5s,
# which is DEFAULT_LOCK.timeoutMs in lib/squid/matrix.ts: both sides of the lock
# wait the same amount for the other, so neither declares defeat while the other
# still believes it may yet win.
LOCK_TRIES="${PD_MATRIX_LOCK_TRIES:-500}"
case "$LOCK_TRIES" in ''|*[!0-9]*) LOCK_TRIES=500 ;; esac

EVENT="$(cat 2>/dev/null || true)"
[ -n "$EVENT" ] || exit 0

# ── Extract tool + file target + success signal (multi-vendor) ──────────────
# Claude/Gemini use snake_case (tool_name / tool_input.*); Codex uses camelCase
# (toolName / toolInput.*) on its app-server surface and snake_case on its hook
# surface. We read both so a pheromone lands for every vendor.
#
# Codex apply_patch carries NO file_path: tool_input is
# { "command": ["apply_patch", "<patch text>"] } and the path(s) live inside the
# patch body after "*** Update|Add|Delete File:" / "*** Move to:" markers (same
# gap fixed in pd-hook-pre-tool, verified against the codex v0.139.0 binary). We
# record one pheromone per touched path so a multi-file apply_patch is fully
# traced, not silently dropped.
TOOL=""
TARGET=""        # primary (first) path — kept for the common single-file path
TARGETS=""       # full newline-list of every touched path
if command -v jq >/dev/null 2>&1; then
  TOOL="$(printf '%s' "$EVENT" | jq -r '.tool_name // .toolName // .tool // empty' 2>/dev/null || true)"
  TARGET="$(printf '%s' "$EVENT" | jq -r '
      .tool_input.file_path
      // .tool_input.path
      // .tool_input.notebook_path
      // .toolInput.file_path
      // .toolInput.path
      // empty' 2>/dev/null || true)"
fi
# Fall back to a raw sed scan whenever jq is absent OR returned nothing (so the
# recorded pheromone always names the real tool, never a generic "tool").
if [ -z "$TOOL" ]; then
  TOOL="$(printf '%s' "$EVENT" | sed -n 's/.*"tool[_N]ame"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
fi
if [ -z "$TARGET" ]; then
  TARGET="$(printf '%s' "$EVENT" | sed -n 's/.*"file_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
fi
[ -n "$TARGET" ] && TARGETS="$TARGET"

# Harvest apply_patch File: paths from the patch body (jq command[1], or raw scan).
PATCH=""
if command -v jq >/dev/null 2>&1; then
  PATCH="$(printf '%s' "$EVENT" | jq -r '
      ( .tool_input.command // .toolInput.command // empty ) as $c
      | if ($c|type) == "array" then ($c | join("\n"))
        elif ($c|type) == "string" then $c
        else empty end' 2>/dev/null || true)"
  [ -n "$PATCH" ] || PATCH="$(printf '%s' "$EVENT" | jq -r '.tool_input.patch // .toolInput.patch // empty' 2>/dev/null || true)"
fi
[ -n "$PATCH" ] || PATCH="$EVENT"
if printf '%s' "$PATCH" | grep -q '\*\*\* '; then
  PATCH_PATHS="$(printf '%s' "$PATCH" \
    | sed 's/\\n/\n/g' \
    | sed -n -E 's/^[*]{3} (Update File|Add File|Delete File|Move to): (.+)$/\2/p' \
    | sed -E 's/[[:space:]]+$//')"
  if [ -n "$PATCH_PATHS" ]; then
    TARGETS="$(printf '%s\n%s' "$TARGETS" "$PATCH_PATHS")"
    [ -n "$TARGET" ] || TARGET="$(printf '%s\n' "$PATCH_PATHS" | head -n1)"
  fi
fi
TARGETS="$(printf '%s\n' "$TARGETS" | sed '/^[[:space:]]*$/d')"

# Only file-mutating tools leave a pheromone. Read-only tools are no-ops.
# Names span vendors: Claude (Edit/Write/MultiEdit/NotebookEdit), Gemini
# (replace/write_file), Codex (apply_patch/str_replace_editor/edit/write/create).
case "$TOOL" in
  Edit|Write|MultiEdit|NotebookEdit|edit|write|create|str_replace_editor|apply_patch|replace|write_file) : ;;
  *) [ -n "$TARGETS" ] || exit 0 ;;   # unknown tool but a target → still record
esac
[ -n "$TARGETS" ] || exit 0

# ── subject suffix (mirror lib/squid/matrix.ts keySuffix) ───────────────────
# The second `s/_+$//` and the X fallback are not tidying: `cut` can expose an
# underscore that was interior before the cut, and an all-punctuation subject
# collapses to nothing. Both cases must match keySuffix() exactly or the daemon
# reconciles a pheromone key this hook never wrote.
suffix() {
  s=$(printf '%s' "$1" \
    | sed -E 's/[^A-Za-z0-9]+/_/g; s/^_+//; s/_+$//' \
    | tr '[:lower:]' '[:upper:]' \
    | cut -c1-80 \
    | sed -E 's/_+$//')
  [ -n "$s" ] || s=X
  printf '%s' "$s"
}
TS_EPOCH="$(date +%s)000"
ISO="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)"

# ── Acquire the lock (flock if present, else mkdir) and append atomically ────
# One pheromone per touched path. A multi-file apply_patch produces N lines; the
# per-path timestamp suffix keeps keys unique within the same epoch ms via a
# monotonic counter so two paths in the same call don't collide.
append_line() {
  mkdir -p "$PD_HOME" 2>/dev/null || true
  [ -f "$MATRIX" ] || {
    {
      echo '# ============================================================================'
      echo '# PORT DADDY STIGMERGIC ATTENTION MATRIX  (~/.port-daddy/matrix.env)'
      echo '# The Ink Cloud (ADR-0091). Hot cache for pd-hook-* tentacles. POSIX-readable.'
      echo ''
    } > "$MATRIX"
  }
  n=0
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    KEY="PD_PHEROMONE_$(suffix "$t")_${TS_EPOCH}${n}"
    VAL="${t} | mutated via ${TOOL:-tool} | intensity:1 | actor:${SELF} | ts:${ISO}"
    printf '%s="%s"\n' "$KEY" "$VAL" >> "$MATRIX"
    n=$((n + 1))
  done <<INNER_EOF
$TARGETS
INNER_EOF
}

# ONE primitive, both platforms: the mkdir-atomic lock DIRECTORY that
# lib/squid/matrix.ts acquires. There used to be an `flock` fast path here on
# Linux — it took `flock` on ${MATRIX}.flock while every reconcile tick took
# `mkdir` on ${MATRIX}.lock. Two disjoint lock objects are not mutual exclusion:
# the append landed inside the tick's read-modify-rename window and the rename
# destroyed it, which is a *silently lost* pheromone on exactly the busy fleet
# the lock exists for. flock is faster and it is gone; correctness first.
i=0
appended=0
while [ "$i" -lt "$LOCK_TRIES" ]; do
  if mkdir "$LOCKDIR" 2>/dev/null; then
    append_line
    appended=1
    rmdir "$LOCKDIR" 2>/dev/null || true
    break
  fi
  # break a stale lock (> ~30s old) so a crashed agent can't wedge the cloud.
  # 30s matches DEFAULT_LOCK.staleMs in lib/squid/matrix.ts — the two sides must
  # agree on when a holder is presumed dead or they will break each other's live
  # locks.
  if [ -d "$LOCKDIR" ]; then
    # `find -mmin` is portable enough across macOS/Linux for staleness.
    if find "$LOCKDIR" -maxdepth 0 -mmin +0.5 2>/dev/null | grep -q .; then
      rmdir "$LOCKDIR" 2>/dev/null || true
    fi
  fi
  i=$((i + 1))
  # tiny sleep without spawning sleep(1) on the hot path when avoidable
  sleep 0.01 2>/dev/null || :
done

# Ran out of patience while a LIVE holder (younger than the stale threshold) had
# the lock. We give up and drop the trace rather than appending anyway.
#
# The old code appended regardless, on a "fail open, a line is one write"
# rationale. That rationale is wrong here: the holder we are waiting on is
# mid-read-modify-rename, so an unlocked append during its window is not
# degraded coordination, it is a write that gets deleted a moment later — the
# same loss, minus the honesty. A tick holds this lock for about a millisecond,
# so reaching this line at all means something is genuinely wedged, and the
# stale-break above is the recovery path for a holder that died.
if [ "$appended" -eq 0 ]; then
  printf 'pd-hook-post-tool: matrix lock busy for %ss; pheromone dropped\n' \
    "$((LOCK_TRIES / 100))" >&2
fi

exit 0
