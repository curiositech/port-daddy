#!/bin/sh
# pd-hook-precompact — Claude Code PreCompact bridge (ADR-0091 / ADR-0097)
# ============================================================================
#
# Claude Code is the only installed adapter with a verified PreCompact event.
# This tentacle copies no transcript: it sends a bounded lifecycle envelope to
# the local daemon, which may combine a separately witnessed provider usage
# report with its own estimate and build a cited ContextEnvelope/packet. Claude
# does not put token usage in its PreCompact payload, so this script NEVER
# manufactures a number. Codex, Gemini, and agy intentionally do not install
# this tentacle.
#
# Failure posture: fail open. An unavailable local daemon means missing advice,
# never a wedged provider compaction. A manual compaction may be blocked only
# when the daemon returns an explicit plan-checkpoint directive; automatic
# compaction is never blocked here because a context-limit recovery must be
# allowed to progress. The hook never reads a bearer credential itself: the
# private `pd squid hook-precompact` transport reuses pdFetch's existing
# per-worktree resolver and sends it only as an HTTP header.
set -u

EVENT_BUDGET_BYTES="${PD_SQUID_PRECOMPACT_EVENT_BUDGET_BYTES:-65536}"
case "$EVENT_BUDGET_BYTES" in ''|*[!0-9]*) EVENT_BUDGET_BYTES=65536 ;; esac
[ "$EVENT_BUDGET_BYTES" -le 65536 ] 2>/dev/null || EVENT_BUDGET_BYTES=65536

EVENT="$(head -c "$EVENT_BUDGET_BYTES" 2>/dev/null || true)"

# ── ADR-0132 listening watch: sentinel before the daemon shim ───────────────
# The shim below is a `pd` invocation against the daemon — forbidden traffic
# during a halt. When ~/.port-daddy/HALT is hoisted this tentacle answers SEEN
# once per session (filesystem only) and exits 0 without contacting anything:
# an automatic compaction must proceed, and a manual one is never blocked on
# a plan the halted daemon cannot supply.
# TODO(ADR-0132 phase 0): switch to lib/distress.ts / bin/pd-distress.
PD_HOME="${PD_HOME:-$HOME/.port-daddy}"
PD_HALT_SENTINEL="${PD_HALT_FILE:-$PD_HOME/HALT}"
PD_DISTRESS="${PD_DISTRESS_FILE:-$PD_HOME/DISTRESS}"
if [ -f "$PD_HALT_SENTINEL" ]; then
  HALT_LINE="$(head -c 1024 "$PD_HALT_SENTINEL" 2>/dev/null | tr -d '\r' | sed -n '/[^[:space:]]/{p;q;}')"
  HALT_REF="sentinel"
  HALT_TOKEN="${HALT_LINE%% *}"
  case "$HALT_TOKEN" in
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T*) HALT_REF="$HALT_TOKEN" ;;
  esac
  halt_sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9._:-' '_' | cut -c1-96; }
  HALT_SESSION="$(printf '%s' "$EVENT" \
    | sed -n -E 's/.*"(session_id|sessionId|thread_id|conversationId)"[[:space:]]*:[[:space:]]*"([^"]*)".*/\2/p' | head -n1)"
  [ -n "$HALT_SESSION" ] || HALT_SESSION="${PD_ACTOR:-unknown}"
  HALT_SESSION="$(halt_sanitize "$HALT_SESSION")"
  HALT_SELF="$(halt_sanitize "agent:${PD_HOOK_PROVIDER:-hook}:${PD_ACTOR:-$HALT_SESSION}")"
  HALT_MARKER="$PD_HOME/squid/halt-watch/${HALT_SESSION}.$(halt_sanitize "$HALT_REF")"
  mkdir -p "$PD_HOME/squid/halt-watch" 2>/dev/null || true
  if mkdir "$HALT_MARKER" 2>/dev/null; then
    HALT_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u)"
    mkdir -p "$(dirname "$PD_DISTRESS")" 2>/dev/null || true
    printf '%s\n' "${HALT_TS} ${HALT_SELF} control SEEN ref=${HALT_REF} hook=precompact" >> "$PD_DISTRESS" 2>/dev/null || true
  fi
  exit 0
fi

[ -n "$EVENT" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# Reject userinfo, paths, queries, fragments, non-numeric ports, and every
# non-loopback origin before curl sees a URL. A shell prefix check alone would
# accept e.g. http://127.0.0.1:9876@evil.example and leak lifecycle metadata.
DAEMON_SOURCE="${PD_URL:-${PORT_DADDY_URL:-http://127.0.0.1:9876}}"
case "$DAEMON_SOURCE" in
  http://localhost:*) DAEMON_PORT="${DAEMON_SOURCE#http://localhost:}" ;;
  http://127.0.0.1:*) DAEMON_PORT="${DAEMON_SOURCE#http://127.0.0.1:}" ;;
  *) exit 0 ;;
esac
case "$DAEMON_PORT" in ''|*[!0-9]*) exit 0 ;; esac
[ "$DAEMON_PORT" -ge 1 ] 2>/dev/null || exit 0
[ "$DAEMON_PORT" -le 65535 ] 2>/dev/null || exit 0
DAEMON_URL="http://127.0.0.1:${DAEMON_PORT}"

SESSION_ID="$(printf '%s' "$EVENT" | jq -r '.session_id // empty' 2>/dev/null || true)"
TRIGGER="$(printf '%s' "$EVENT" | jq -r '.trigger // empty' 2>/dev/null || true)"
case "$SESSION_ID" in ''|*[!A-Za-z0-9._:-]*) exit 0 ;; esac
case "$TRIGGER" in manual|auto) : ;; *) exit 0 ;; esac

# Claude Code's published PreCompact event has no delivery id. The hook does
# not invent one or use ambient PD_SESSION_ID to choose a plan: that ambient
# shell value can be stale. It forwards the provider session identifier only;
# the daemon must resolve it through a daemon-owned provider-session binding
# before it can select a pd-plan session or derive an idempotency key.
#
# The CLI shim carries the existing daemon-minted credential internally. It
# emits only a sanitized directive, and this pipe bounds a hostile local reply
# before it can become hook process memory or provider stdout.
RESPONSE_BUDGET_BYTES="${PD_SQUID_PRECOMPACT_RESPONSE_BUDGET_BYTES:-4096}"
case "$RESPONSE_BUDGET_BYTES" in ''|*[!0-9]*) RESPONSE_BUDGET_BYTES=4096 ;; esac
[ "$RESPONSE_BUDGET_BYTES" -ge 1 ] 2>/dev/null || RESPONSE_BUDGET_BYTES=4096
[ "$RESPONSE_BUDGET_BYTES" -le 4096 ] 2>/dev/null || RESPONSE_BUDGET_BYTES=4096
PD_CLI="${PD_SQUID_CLI:-}"
if [ -z "$PD_CLI" ]; then
  PD_CLI="$(command -v pd 2>/dev/null || command -v port-daddy 2>/dev/null || true)"
fi
[ -n "$PD_CLI" ] || exit 0
RESPONSE="$(PORT_DADDY_URL="$DAEMON_URL" "$PD_CLI" squid hook-precompact \
  --provider claude --trigger "$TRIGGER" --provider-session "$SESSION_ID" 2>/dev/null \
  | head -c "$RESPONSE_BUDGET_BYTES" 2>/dev/null || true)"
[ -n "$RESPONSE" ] || exit 0

DECISION="$(printf '%s' "$RESPONSE" | jq -r '.directive.decision // empty' 2>/dev/null || true)"
REASON="$(printf '%s' "$RESPONSE" | jq -r '.directive.reason // empty' 2>/dev/null || true)"
if [ "$TRIGGER" = "manual" ] && [ "$DECISION" = "block" ] && [ -n "$REASON" ]; then
  # Claude Code documents top-level `decision: block` for PreCompact. Restrict
  # the message to one bounded line so daemon text can never become a prompt.
  REASON="$(printf '%s' "$REASON" | tr '\r\n' ' ' | cut -c 1-512)"
  jq -cn --arg reason "$REASON" '{decision:"block",reason:$reason}'
fi
exit 0
