{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portdaddy.dev/schemas/coordination-note.schema.json",
  "title": "Port Daddy Coordination Note",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "files", "assumptions", "validationPlan"],
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "validationPlan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "coordinationRisk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  }
}
