(*
 * ADR-0096 vulnerability twin: UNSIGNED guidance is forgeable
 * ===========================================================
 *
 * Same protocol as guidance_envelope_v0.pv with ONE change: the body renders
 * turn-start guidance as trusted WITHOUT verifying the signature — i.e., a
 * body that acts on unauthenticated injected text claiming operator
 * authority. This is exactly the premise of the C2 `forged-guidance`
 * negative probe (compliance-probe-result.schema.json) and of ADR-0096's
 * "a body that can only receive guidance as unauthenticated injected text is
 * C0/observed — never C3."
 *
 * EXPECTED RESULT: both agreement queries are FALSE — ProVerif derives the
 * attack (the Dolev-Yao attacker, i.e. any repo file / tool output / web page
 * / compromised Squid, injects arbitrary guidance the daemon never issued).
 * The checked-in results file demonstrates the attack trace; the honesty gate
 * never reads this file (it reads the fixed model's results), this twin
 * exists to show the failure the signature check removes.
 *
 * Run:  proverif lib/agent-harbor/formal/guidance_envelope_v0_unsigned_vuln.pv
 * Results checked in: guidance_envelope_v0_unsigned_vuln_results.txt
 *)

type key.

free net: channel.

fun hmac(bitstring, key): bitstring.
fun hash(bitstring): bitstring.

event DaemonIssued(bitstring, bitstring, bitstring, bitstring).
event BodyAccepts(bitstring, bitstring, bitstring, bitstring).

(* Q1 — injection resistance: EXPECTED FALSE for the unsigned body. *)
query s: bitstring, a: bitstring, t: bitstring, c: bitstring;
  event(BodyAccepts(s, a, t, c)) ==> event(DaemonIssued(s, a, t, c)).

(* Q2 — no-replay: EXPECTED FALSE for the unsigned body. *)
query s: bitstring, a: bitstring, t: bitstring, c: bitstring;
  inj-event(BodyAccepts(s, a, t, c)) ==> inj-event(DaemonIssued(s, a, t, c)).

let TurnInstance(sid: bitstring, aid: bitstring, k: key) =
  new t: bitstring;
  out(net, t);   (* the current turn number is not a secret *)
  (
    ( new content: bitstring;
      new n: bitstring;
      event DaemonIssued(sid, aid, t, hash(content));
      out(net, (sid, aid, t, content, n,
                hmac((sid, aid, t, hash(content), n), k))) )
  |
    (* THE VULNERABILITY: no signature verification — the body accepts any
     * well-formed envelope for the current turn as trusted guidance. *)
    ( in(net, (=sid, =aid, =t, xc: bitstring, xn: bitstring, m: bitstring));
      event BodyAccepts(sid, aid, t, hash(xc)) )
  ).

(* Key provisioning is inlined (no loopback round-trip): the vulnerability is
 * independent of key establishment, and the simpler process lets ProVerif
 * reconstruct a concrete attack trace instead of only a derivation. *)
let Session =
  new sid: bitstring;
  new aid: bitstring;
  out(net, (sid, aid));
  new k: key;
  !TurnInstance(sid, aid, k).

process
  !Session
