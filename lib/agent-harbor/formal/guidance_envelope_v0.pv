(*
 * ADR-0096: Signed GuidanceEnvelope v0 — injection resistance + no-replay
 * =======================================================================
 *
 * This is the ADR-0096 proof obligation ("the protocol must be machine-checked
 * for the injection and replay properties before M5 code claims C3"). The
 * suggestibility honesty gate (lib/agent-harbor/suggestibility-authority.ts)
 * parses this model's checked-in results file and refuses to report the
 * suggestibility axis above C0 unless every query below is proved.
 *
 * Protocol under test (ADR-0096, local-harbor v0 path):
 *   1. Launch-time key establishment: at body registration (the C2 adapter
 *      nonce challenge), the daemon provisions a per-session guidance-signing
 *      key over the LOOPBACK socket — modeled as a private channel. The key is
 *      bound to (sessionId, agentNodeId).
 *   2. Per-envelope MAC over the binding tuple:
 *        sig = HMAC(k, (sessionId, agentNodeId, turnSequence,
 *                       envelopeContentHash, nonce))
 *   3. Transit: the envelope travels through Squid / relays / the network —
 *      ALL modeled as the Dolev-Yao attacker (the public channel `net`).
 *      Squid is untrusted plumbing, never a trust anchor.
 *   4. Body verification BEFORE bytes reach the model: signature, turn
 *      binding (turnSequence must equal the body's current turn), agent/
 *      session binding, and nonce freshness (jti replay cache).
 *
 * QUERIES (all must be proved for the C3 gate to open):
 *   Q1 INJECTION RESISTANCE (non-injective agreement): every envelope the
 *      body renders as trusted guidance was genuinely issued by the daemon
 *      for exactly that (session, agent, turn, contentHash). The attacker —
 *      repo text, tool output, web content, a compromised Squid — cannot get
 *      forged operator authority into the trusted channel.
 *   Q2 NO-REPLAY (injective agreement): each acceptance corresponds to a
 *      DISTINCT daemon issuance. A captured envelope cannot be replayed into
 *      a different turn (turn binding), a different agent (agent binding),
 *      or accepted twice (one acceptance per turn instance; the runtime jti
 *      cache additionally enforces this per-nonce, asserted by the
 *      runtime-verification monitor).
 *   Q3 KEY SECRECY: the session signing key never reaches the attacker.
 *      (This holds BY ASSUMPTION of loopback privacy — it documents the trust
 *      anchor rather than discovering it. The interesting theorems are Q1/Q2.)
 *
 * HONEST SCOPE LIMITS (named, not hidden):
 *   - notAfter expiry is untimed here (ProVerif has no clocks); expiry is a
 *     runtime check, monitored per ADR-0096's runtime-verification obligation.
 *     Freshness in the model rides on the turn binding + fresh nonces.
 *   - Same-UID process compromise (attacker reads k from body memory) is OUT
 *     of scope, exactly as ADR-0096 concedes: signing defeats content-layer
 *     injection, not a compromised host. That is the sandbox story.
 *   - The macaroon operator-authority chain (mode=macaroon) rides on
 *     core/kernel/pd-anchor/formal/proverif/macaroon-discharge/macaroon_discharge_v2s.pv lineage and is not re-proved here;
 *     this model covers the daemon->body envelope channel (mode=loopback).
 *   - Turn synchronization: daemon and body agree on the current turnSequence
 *     via the session control channel; modeled as a fresh per-turn value known
 *     to both ends of one session (not chosen by the attacker).
 *
 * Companion vulnerability twin: guidance_envelope_v0_unsigned_vuln.pv shows
 * that WITHOUT the signature check (a body that acts on unauthenticated
 * turn-start text) ProVerif finds the forgery immediately — the exact premise
 * of the forged-guidance negative probe.
 *
 * Run:  proverif lib/agent-harbor/formal/guidance_envelope_v0.pv
 * Results checked in: guidance_envelope_v0_results.txt
 * Lineage: apps/relay/formal/proverif/relay-e2e-secrecy/relay_e2e_secrecy.pv (injective agreement pattern),
 *          skills/proverif-tamarin-protocol-modeling (decision trees).
 *)

type key.

(* The network: Squid, relays, repo/tool/web content — the Dolev-Yao attacker. *)
free net: channel.

(* Launch-time provisioning path: the loopback socket at the C2 adapter nonce
 * challenge. Private = the attacker is not on this channel (the one trust
 * assumption; see Q3). *)
free loopback: channel [private].

(* HMAC: one-way keyed MAC — no destructor, so the only way to produce a valid
 * MAC is to hold the key. *)
fun hmac(bitstring, key): bitstring.

(* Content hash (envelopeContentHash over the sig-less payload). *)
fun hash(bitstring): bitstring.

(* Events *)
event KeyProvisioned(bitstring, bitstring).                       (* sid, aid *)
event DaemonIssued(bitstring, bitstring, bitstring, bitstring).   (* sid, aid, turn, contentHash *)
event BodyAccepts(bitstring, bitstring, bitstring, bitstring).    (* sid, aid, turn, contentHash *)

(* Q1 — injection resistance: trusted-channel acceptance implies genuine
 * daemon issuance for the same (session, agent, turn, content). *)
query s: bitstring, a: bitstring, t: bitstring, c: bitstring;
  event(BodyAccepts(s, a, t, c)) ==> event(DaemonIssued(s, a, t, c)).

(* Q2 — no-replay: injective agreement. Each acceptance maps to a distinct
 * issuance; captured envelopes cannot be replayed across turns or agents. *)
query s: bitstring, a: bitstring, t: bitstring, c: bitstring;
  inj-event(BodyAccepts(s, a, t, c)) ==> inj-event(DaemonIssued(s, a, t, c)).

(* Q3 — key secrecy: the distinguished session's signing key stays secret. *)
free kProbe: key [private].
query attacker(kProbe).

(* --- One synchronized turn of one session ------------------------------- *)
(* The daemon side assembles, signs, and emits over the attacker-controlled
 * network; the body side verifies signature + turn/agent/session binding
 * before rendering guidance as trusted. `t` is the current turnSequence both
 * ends already agree on (session control channel); `content` is the guidance
 * payload; `n` is the envelope nonce (jti). One acceptance per turn instance
 * models the single-envelope-per-turn v0 delivery + the jti cache. *)
let TurnInstance(sid: bitstring, aid: bitstring, k: key) =
  new t: bitstring;
  (
    (* Daemon: assemble + sign + emit through Squid (the attacker). *)
    ( new content: bitstring;
      new n: bitstring;
      event DaemonIssued(sid, aid, t, hash(content));
      out(net, (sid, aid, t, content, n,
                hmac((sid, aid, t, hash(content), n), k))) )
  |
    (* Body: verify BEFORE the model sees a byte. Pattern =sid/=aid/=t is the
     * session/agent/turn binding check; the MAC equality is the signature
     * check over the full binding tuple. *)
    ( in(net, (=sid, =aid, =t, xc: bitstring, xn: bitstring, m: bitstring));
      if m = hmac((sid, aid, t, hash(xc), xn), k) then
        event BodyAccepts(sid, aid, t, hash(xc)) )
  ).

(* A session: key provisioned once over loopback at registration, then
 * unboundedly many turns. *)
let Session =
  new sid: bitstring;
  new aid: bitstring;
  out(net, (sid, aid));            (* identities are public — never secrets *)
  new k: key;
  event KeyProvisioned(sid, aid);
  out(loopback, (sid, aid, k));    (* launch-time provisioning, never on the wire *)
  in(loopback, (=sid, =aid, kb: key));
  !TurnInstance(sid, aid, kb).

(* The Q3 probe session: same shape, distinguished key kProbe. *)
let ProbeSession =
  new sidP: bitstring;
  new aidP: bitstring;
  out(net, (sidP, aidP));
  out(loopback, (sidP, aidP, kProbe));
  in(loopback, (=sidP, =aidP, kb: key));
  !TurnInstance(sidP, aidP, kb).

process
  ( !Session | ProbeSession )
